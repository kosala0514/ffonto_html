@prefix : <http://purl.org/ffonto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://purl.org/ffonto#> .

<http://purl.org/ffonto#> rdf:type owl:Ontology ;
                           owl:versionIRI :V1.2 ;
                           <http://creativecommons.org/ns#license> "" ;
                           <http://purl.org/dc/elements/1.1/abstract> "The Forest Fire Ontology (FFONTO) is designed to integrate multi-modal sensor data for early fire detection. It serves as an extensible framework with 'ForestFire' as the root class, incorporating concepts for visual detection, audio monitoring, and environmental conditions."@en ;
                           <http://purl.org/dc/elements/1.1/contributor> _:genid1 ;
                           <http://purl.org/dc/elements/1.1/creator> _:genid2 ;
                           <http://purl.org/dc/elements/1.1/description> "This ontology describes forest fire detection observations including image, audio, and weather data."@en ;
                           <http://purl.org/dc/elements/1.1/title> "Forest Fire Ontology (FFONTO)"@en ;
                           <http://purl.org/dc/terms/issued> "2026-01-27"^^xsd:date ;
                           <http://purl.org/dc/terms/license> "" ;
                           <http://purl.org/vocab/vann/preferredNamespacePrefix> "ffonto"@en ;
                           rdfs:comment "Ontology for forest fire detection & observation (image, audio, weather). Root class: ForestFire. Designed for extensibility."@en ;
                           rdfs:seeAlso <https://github.com/kosala0514/FFOnto> ;
                           owl:versionInfo "Initial Release 1.0" ;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#status> "Active" ;
                           <http://www.w3.org/ns/prov#generatedAtTime> "2026-01-27T00:00:00+00:00"^^xsd:dateTime ;
                           <http://www.w3.org/ns/prov#wasAttributedTo> <https://github.com/kosala0514> .

_:genid1 <http://xmlns.com/foaf/0.1/name> "Prof. Dulani Meedeniya"@en ;
          <https://schema.org/identifier> <https://orcid.org/0000-0002-4520-3819> .

_:genid2 <http://xmlns.com/foaf/0.1/name> "Ms. Charuni Kosala Jayaweera"@en ;
          <https://schema.org/identifier> <https://orcid.org/0009-0003-5790-62840> .

