:Animal rdfs:comment "Domestic animals or pets potentially affected by wildfire smoke." ;
        rdfs:label "Animal" .


:DataAugmentation rdfs:comment "Techniques to increase training data diversity by transforming existing examples."@en ;
                  rdfs:label "Data Augmentation" .


:F1Score rdfs:comment "The harmonic mean of precision and recall, used as a performance metric for classification."@en ;
         rdfs:label "F1 Score" .


:FWI :resolution "0.1 degree global resolution" ;
     rdfs:comment "Fire Weather Index." ,
                  "Meteorological index estimating fire danger based on weather conditions." ;
     rdfs:label "FWI" ,
                "Fire Weather Index (FWI)" .


:FineFuel rdfs:comment "Fast-drying, fast-burning materials like grass, leaves, and needles that ignite easily." ;
          rdfs:label "Fine Fuel" .


:FireEngine rdfs:comment "Emergency vehicle used by firefighters to combat fires and protect structures." ,
                         "Ground vehicle used for transporting firefighters and equipment." ;
            rdfs:label "Fire Engine" .


:Firebreak rdfs:comment "A gap in vegetation used to stop or slow fire spread." ,
                        "Cleared strips of land used to stop or slow wildfire spread." ;
           rdfs:label "Firebreak" .


:Grass rdfs:comment "Herbaceous vegetation characterized by narrow leaves and soft stems, commonly forming ground cover in forest and grassland ecosystems." ;
       rdfs:label "Grass" .


:HeavyFuel rdfs:comment "Large woody materials like logs and branches that burn longer and produce high heat intensity." ;
           rdfs:label "Heavy Fuel" .


:Helicopter rdfs:comment "Aircraft used to drop water or fire retardant in remote areas." ;
            rdfs:label "Firefighting Helicopter" ,
                       "Helicopter" .


:HotspotLocalization rdfs:comment "Determining the geographic location of thermal anomalies indicating active fire or heat sources."@en ;
                     rdfs:label "Hotspot Localization" .


:NDVI rdfs:comment "Normalized Difference Vegetation Index; a satellite-derived index indicating vegetation greenness."@en ;
      rdfs:label "Normalized Difference Vegetation Index (NDVI)" .


:NaturalFeature rdfs:comment "A naturally occurring geographic or environmental element such as forests, rivers, mountains, or vegetation."@en ;
                rdfs:label "Natural feature"@en .


:Person rdfs:comment "A human individual; used to represent people in data and processes."@en ;
        rdfs:label "Person" .


:Precision rdfs:comment "A measure of the proportion of true positive results among positive predictions."@en ;
           rdfs:label "Precision" .


:PublicAlert rdfs:comment "A notification issued to inform the public about an emergency or required action."@en ;
             rdfs:label "Public Alert / Warning" .


:RadioComms rdfs:comment "Two-way communication using radio frequencies for coordination and information exchange."@en ;
            rdfs:label "Operational Radio Communications" ,
                       "Radio Communications" .


:SAR rdfs:comment "Radar-based remote sensing used to estimate forest structure and stand height." ;
     rdfs:label "Synthetic Aperture Radar (SAR)" .


:SelfSupervisedLearning rdfs:comment "A machine learning paradigm using automatically generated labels from input data structure."@en ;
                        rdfs:label "Self Supervised Learning" .


:SmokeDetection rdfs:comment "The process or technology used to identify the presence of smoke in an environment."@en ;
                rdfs:label "Smoke/Flame Detection" .


:StructureProtection rdfs:comment "Measures undertaken to defend buildings and infrastructure from fire damage."@en ;
                     rdfs:label "Structure Protection" ,
                                "Structure Protection Strategy" .


:SurfaceFuel rdfs:comment "Fuel located on the ground surface, such as leaf litter, twigs, and low vegetation." ;
             rdfs:label "Surface Fuel" .


:adjacentOf rdfs:comment "Inverse relation linking adjacency statements back to the neighboring spatial units."@en .


:appliesAfterFireOf rdfs:comment "Inverse relation indicating actions or policies applied following a fire for a given area."@en .


:audioClipCount rdfs:comment "A count of discrete audio clips associated with an event or dataset."@en .


:audioEventOf rdfs:comment "Inverse relation linking an audio-recorded event to the source or subject it documents."@en .


:burningNearRiverInverse rdfs:comment "Inverse relation indicating burning activities located near riverine environments linked back to the source."@en .


:hasShelterType rdfs:comment "Specifies the category or type of shelter available for use (e.g., evacuation center, safe room)."@en .


:hasStatisticValue rdfs:comment "Associates an entity with a numeric statistic or measured value."@en .


:hasTemperature rdfs:comment "Associates an entity with a measured temperature value."@en .


:hasTimestamp rdfs:comment "Associates an entity with a specific date-time stamp."@en .


:imageEventOf rdfs:comment "Inverse relation linking an image-captured event to the object or occurrence depicted."@en .


:impairsVisibility rdfs:comment "Whether the hazard reduces visibility (true/false)." ;
                   rdfs:label "impairs visibility" .


:isFireRiskInfluencedBy rdfs:comment "Inverse relation indicating that an entity affects fire risk for a specified target."@en .


:isProvenanceOf rdfs:comment "Inverse relation linking provenance records back to the artifacts or datasets they document."@en .


:locatedOf rdfs:comment "Inverse relation linking location assertions back to the features or entities located."@en .


:occursInSceneOf rdfs:comment "Inverse relation linking scene occurrences back to the events or objects within those scenes."@en .


:onFlank rdfs:comment "Frame-relative flank description (e.g. 'right' or 'left') stored as literal." ;
