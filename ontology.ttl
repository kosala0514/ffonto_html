###  http://purl.org/ffonto#FireDrivenEcologicalChange
:FireDrivenEcologicalChange rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( :EcologicalEffect
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :isEcologicalEffectOf ;
                                                                         owl:someValuesFrom :ForestFire
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ;
                            rdfs:comment "Any ecological effect that is logically linked to a forest fire event." ;
                            rdfs:label "Fire Driven Ecological Change" .


