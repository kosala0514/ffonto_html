                 rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
                 rdfs:comment "A computational model used to simulate physical processes, such as fire spread or smoke dispersion."@en ;
                 rdfs:label "simulation model"@en .


###  http://purl.org/ffonto#Site
:Site rdf:type owl:Class ;
      rdfs:subClassOf :SpatialEntity ;
      rdfs:comment "A specific geographic location such as a fire incident site." ;
      rdfs:label "Site" .


###  http://purl.org/ffonto#SituationReport
:SituationReport rdf:type owl:Class ;
                 rdfs:subClassOf :IncidentReport ;
                 rdfs:comment "A concise report summarizing current conditions, impacts, and response actions."@en ;
                 rdfs:label "Situation Report (SITREP)" .


###  http://purl.org/ffonto#Slope
:Slope rdf:type owl:Class ;
       rdfs:subClassOf :Topography ;
       rdfs:comment "The steepness or incline of terrain, commonly expressed as a percentage or angle."@en ;
       rdfs:label "Slope" .


###  http://purl.org/ffonto#Smoke
:Smoke rdf:type owl:Class ;
       rdfs:subClassOf :AirPollution ;
       rdfs:comment "Visible smoke produced by combustion." ;
       rdfs:label "Smoke" .


###  http://purl.org/ffonto#SmokeColor
:SmokeColor rdf:type owl:Class ;
            rdfs:subClassOf :SmokePlume ;
            rdfs:comment "Smoke color categories." ;
            rdfs:label "Smoke Color" ,
                       "Smoke Color (enum)" .


###  http://purl.org/ffonto#SmokeComponent
:SmokeComponent rdf:type owl:Class ;
                rdfs:comment "Chemical compounds and particles present in wildfire smoke." ;
                rdfs:label "Smoke Component" .


###  http://purl.org/ffonto#SmokeCondition
:SmokeCondition rdf:type owl:Class ;
                rdfs:comment "Represents characteristics of smoke present at the wildfire scene." ;
                rdfs:label "Smoke Condition" .


###  http://purl.org/ffonto#SmokeDamage
:SmokeDamage rdf:type owl:Class ;
             rdfs:comment "Damage caused by smoke, often resulting from wildfires, house fires, or other combustion events." ;
             rdfs:label "Smoke Damage" .


###  http://purl.org/ffonto#SmokeDetection
:SmokeDetection rdf:type owl:Class ;
                rdfs:subClassOf :ComputerVisionTask .


###  http://purl.org/ffonto#SmokeDispersionModel
:SmokeDispersionModel rdf:type owl:Class ;
                      rdfs:subClassOf :AtmosphericTransportModel ;
                      rdfs:comment "A computational model that simulates the transport and spread of smoke in the atmosphere."@en ;
                      rdfs:label "Smoke Dispersion Model" .


###  http://purl.org/ffonto#SmokeHazard
:SmokeHazard rdf:type owl:Class ;
             rdfs:subClassOf :Hazard ;
             rdfs:comment "Respiratory and visibility impacts from PM2.5 and toxic smoke." ;
             rdfs:label "Smoke Hazard" .


###  http://purl.org/ffonto#SmokeHealthEffect
:SmokeHealthEffect rdf:type owl:Class ;
                   rdfs:comment "Adverse human health outcomes caused by wildfire smoke exposure." ;
                   rdfs:label "Smoke Health Effect" .


###  http://purl.org/ffonto#SmokeLayerObservation
:SmokeLayerObservation rdf:type owl:Class ;
                       rdfs:comment "Observation describing presence of multilayer smoke and qualitative descriptions per layer." ;
                       rdfs:label "Smoke Layer Observation" .


###  http://purl.org/ffonto#SmokeObservation
:SmokeObservation rdf:type owl:Class ;
                  rdfs:subClassOf :ImageObservation ;
                  rdfs:comment "An observation indicating the presence of smoke within an environmental image, which may suggest an ongoing fire or combustion event." ;
                  rdfs:label "Smoke Observation" .


###  http://purl.org/ffonto#SmokePlume
:SmokePlume rdf:type owl:Class ;
            rdfs:subClassOf <http://www.opengis.net/ont/geosparql#SpatialObject> ;
            rdfs:comment "A concentrated column or mass of smoke rising from a fire source."@en ;
            rdfs:label "Smoke Plume" .


###  http://purl.org/ffonto#Smoker
:Smoker rdf:type owl:Class ;
        rdfs:subClassOf :PopulationGroup ;
        rdfs:comment "A person who uses tobacco or other smoked substances; potential ignition source in certain contexts."@en ;
        rdfs:label "Smoker" .


###  http://purl.org/ffonto#Smoking
:Smoking rdf:type owl:Class ;
         rdfs:subClassOf :HumanIgnition ;
         rdfs:comment "The act of inhaling and exhaling tobacco or other substances; a potential fire ignition source."@en ;
         rdfs:label "Smoking (Discarded Cigarette)" .


###  http://purl.org/ffonto#SmolderingPhase
:SmolderingPhase rdf:type owl:Class ;
                 rdfs:subClassOf :CombustionProcess ;
                 rdfs:comment "Low-temperature combustion phase producing high levels of carbon monoxide and smoke." ;
                 rdfs:label "Smoldering Phase" .


###  http://purl.org/ffonto#Snag
:Snag rdf:type owl:Class ;
      rdfs:subClassOf :Vegetation ;
      rdfs:comment "Standing dead trees (snags)." ;
      rdfs:label "Snag" .


###  http://purl.org/ffonto#SnowCover
:SnowCover rdf:type owl:Class ;
           rdfs:subClassOf :EnvironmentalCondition ;
           owl:disjointWith :SoilCondition ;
           rdfs:comment "Snow present on the ground that can influence fire behavior by reducing vegetation dryness and limiting fire spread." ;
           rdfs:label "Snow Cover" .


###  http://purl.org/ffonto#SnowCoverObservation
:SnowCoverObservation rdf:type owl:Class ;
                      rdfs:subClassOf :ImageObservation ;
                      rdfs:comment "An observation indicating the presence of snow cover on the ground or vegetation in an environmental image." ;
                      rdfs:label "Snow Cover Observation" .


###  http://purl.org/ffonto#SocialEquity
:SocialEquity rdf:type owl:Class ;
              rdfs:subClassOf :EthicalConsideration ;
              rdfs:comment "The fair and just distribution of resources, opportunities, and burdens across populations."@en ;
              rdfs:label "Social Equity" .


###  http://purl.org/ffonto#SoilCondition
:SoilCondition rdf:type owl:Class ;
               rdfs:subClassOf :EnvironmentalCondition ,
                               :EnvironmentalFactor ;
               rdfs:comment "Characteristics of soil such as moisture and nutrient content." ,
                            "Physical and chemical characteristics of soil that influence vegetation growth and ecosystem health." ;
               rdfs:label "Soil Condition" .


###  http://purl.org/ffonto#SoilErosion
:SoilErosion rdf:type owl:Class ;
             rdfs:subClassOf :PhysicalImpact ;
             rdfs:comment "The displacement of soil layers following the loss of protective vegetation." ;
             rdfs:label "Soil Erosion" .


###  http://purl.org/ffonto#SoilMoistureIndex
:SoilMoistureIndex rdf:type owl:Class ;
                   rdfs:subClassOf :VegetationIndex ;
                   rdfs:comment "Indicator measuring soil water availability." ;
                   rdfs:label "Soil Moisture Index" .


###  http://purl.org/ffonto#SoilMoistureRetention
:SoilMoistureRetention rdf:type owl:Class ;
                       rdfs:subClassOf :EcosystemService ;
                       rdfs:comment "Ability of an ecosystem or water body to maintain soil moisture levels." ;
                       rdfs:label "Soil moisture retention" .


###  http://purl.org/ffonto#SoilNutrientChange
:SoilNutrientChange rdf:type owl:Class ;
                    rdfs:subClassOf :EcologicalImpact ;
                    rdfs:comment "Changes in soil nutrient composition caused by fire." ;
                    rdfs:label "Soil Nutrient Change" .


###  http://purl.org/ffonto#SoilNutrientLoss
:SoilNutrientLoss rdf:type owl:Class ;
                  rdfs:subClassOf :EcologicalStress ;
                  rdfs:comment "Reduction in soil fertility due to environmental factors." ;
                  rdfs:label "Soil nutrient loss" .


###  http://purl.org/ffonto#SoilQuality
:SoilQuality rdf:type owl:Class ;
             rdfs:comment "Indicators of soil fertility or texture that influence vegetation growth and distribution." ;
             rdfs:label "Soil quality" .


###  http://purl.org/ffonto#SolarPanel
:SolarPanel rdf:type owl:Class ;
            rdfs:comment "Photovoltaic panels installed on rooftops." ;
            rdfs:label "Solar Panel" .


###  http://purl.org/ffonto#SparseVegetation
:SparseVegetation rdf:type owl:Class ;
                  rdfs:subClassOf :VegetationCondition ;
                  rdfs:comment "Vegetation distributed sparsely across the landscape." ;
                  rdfs:label "Sparse vegetation" .


###  http://purl.org/ffonto#SparseWoodland
:SparseWoodland rdf:type owl:Class ;
                rdfs:subClassOf :LandCover ;
                rdfs:comment "Woodland area with scattered trees and lower canopy density." ;
                rdfs:label "Sparse woodland" .


###  http://purl.org/ffonto#SpatialEntity
:SpatialEntity rdf:type owl:Class ;
               rdfs:subClassOf <http://www.opengis.net/ont/geosparql#SpatialObject> ;
               rdfs:comment "An entity that exists in physical or geographic space and can have a spatial location or geometry."@en ;
               rdfs:label "Spatial entity"@en .


###  http://purl.org/ffonto#SpatialExtent
:SpatialExtent rdf:type owl:Class ;
               rdfs:comment "The physical area, geographic boundary, or geospatial footprint covered by an event or entity."@en ;
               rdfs:label "spatial extent"@en .


###  http://purl.org/ffonto#SpatialFeature
:SpatialFeature rdf:type owl:Class ;
                rdfs:comment "A geographic feature or object that can be located or represented in spatial coordinates."@en ;
                rdfs:label "Spatial feature"@en .


###  http://purl.org/ffonto#SpatialUnit
:SpatialUnit rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :hasVegetationDistribution ;
                               owl:someValuesFrom :VegetationDistribution
                             ] ;
             rdfs:comment "Spatial unit for measurement and observation (plot, patch, landscape unit)." ;
             rdfs:label "Spatial unit" .


###  http://purl.org/ffonto#SpecialNeedsPlan
:SpecialNeedsPlan rdf:type owl:Class ;
                  rdfs:comment "Preparedness measures for those with disabilities, medical dependencies, or other special requirements." ;
                  rdfs:label "Special Needs Plan" .


###  http://purl.org/ffonto#SpeciesCompositionChange
:SpeciesCompositionChange rdf:type owl:Class ;
                          rdfs:subClassOf :VegetationDynamics ;
                          rdfs:comment "A shift in the types and proportions of species present in an ecosystem following disturbance." ;
                          rdfs:label "Species Composition Change" .


###  http://purl.org/ffonto#SpontaneousCombustion
:SpontaneousCombustion rdf:type owl:Class ;
                       rdfs:subClassOf :NaturalCause ,
                                       :NaturalIgnition ;
                       rdfs:comment "A self-ignition event caused by internal heat generation without external ignition sources."@en ;
                       rdfs:label "Spontaneous Combustion" .


###  http://purl.org/ffonto#SpotFire
:SpotFire rdf:type owl:Class ;
          rdfs:subClassOf :FireFront ;
          rdfs:comment "Secondary ignition caused by embers." ;
          rdfs:label "Spot Fire" .


###  http://purl.org/ffonto#SpottingEvent
:SpottingEvent rdf:type owl:Class ;
               rdfs:comment "Transport of embers causing spot fires ahead of main front." ;
               rdfs:label "Spotting / Ember Cast Event" .


###  http://purl.org/ffonto#Spruce
:Spruce rdf:type owl:Class ;
        rdfs:subClassOf :ConiferousTree ;
        rdfs:comment "A coniferous tree species belonging to the genus Picea commonly found in cold forest ecosystems." ;
        rdfs:label "Spruce tree" .


###  http://purl.org/ffonto#Stream
:Stream rdf:type owl:Class ;
        rdfs:subClassOf :WaterBody ;
        rdfs:comment "A natural flowing water source that may be used for drafting water." ;
        rdfs:label "Stream" .


###  http://purl.org/ffonto#StructuralCollapse
:StructuralCollapse rdf:type owl:Class ;
                    rdfs:subClassOf :Hazard ;
                    rdfs:comment "Risk of building collapse endangering personnel." ;
                    rdfs:label "Structural Collapse Hazard" .


###  http://purl.org/ffonto#StructuralDamage
:StructuralDamage rdf:type owl:Class ;
                  rdfs:comment "Damage affecting buildings after wildfire." ;
                  rdfs:label "Structural Damage" .


###  http://purl.org/ffonto#StructureDefense
:StructureDefense rdf:type owl:Class ;
                  rdfs:comment "Measures to protect buildings (defensible space, sprinklers, roof coverings)." ;
                  rdfs:label "Structure Defense" .


###  http://purl.org/ffonto#StructureFire
:StructureFire rdf:type owl:Class ;
               rdfs:subClassOf :ForestFire ;
               rdfs:comment "Fire involving buildings / infrastructure (houses, outbuildings)." ;
               rdfs:label "Structure Fire" .


###  http://purl.org/ffonto#StructureLossStatus
:StructureLossStatus rdf:type owl:Class ;
                     rdfs:comment "Classification for damage: intact, damaged, total loss." ;
                     rdfs:label "Structure Loss Status" .


###  http://purl.org/ffonto#StructureProtection
:StructureProtection rdf:type owl:Class .


###  http://purl.org/ffonto#StructureShelter
:StructureShelter rdf:type owl:Class ;
                  rdfs:subClassOf :FireShelter ;
                  rdfs:comment "A building or structure designated to provide protection to people during emergencies."@en ;
                  rdfs:label "Structure / Vehicle Shelter" .


###  http://purl.org/ffonto#Stump
:Stump rdf:type owl:Class ;
       rdfs:subClassOf :Vegetation ;
       rdfs:comment "Tree stumps that may smolder." ;
       rdfs:label "Stump" .


###  http://purl.org/ffonto#SuccessionStage
:SuccessionStage rdf:type owl:Class ;
                 rdfs:comment "Post-disturbance vegetation stage (early successional shrubland, grassland, regenerating forest, etc.)." ;
                 rdfs:label "Succession stage" .


###  http://purl.org/ffonto#SupportingService
:SupportingService rdf:type owl:Class ;
                   rdfs:subClassOf :EcosystemService ;
                   rdfs:comment "Fundamental services necessary for the production of all other ecosystem services." ;
                   rdfs:label "Supporting Service" .


###  http://purl.org/ffonto#SuppressionDifficulty
:SuppressionDifficulty rdf:type owl:Class ;
                       rdfs:comment "Assessment of wildfire suppression difficulty." ;
                       rdfs:label "Suppression Difficulty" .


###  http://purl.org/ffonto#SuppressionMethod
:SuppressionMethod rdf:type owl:Class ;
                   rdfs:comment "A technique or tactic used to extinguish or control fire."@en ;
                   rdfs:label "ForestFire Suppression Method" .


###  http://purl.org/ffonto#SuppressionOperation
:SuppressionOperation rdf:type owl:Class ;
                      rdfs:comment "An organized operation (ground, aerial, mop-up) to control a fire." ;
                      rdfs:label "Suppression Operation" .


###  http://purl.org/ffonto#SuppressionResource
:SuppressionResource rdf:type owl:Class ;
                     rdfs:comment "Equipment or personnel used to control or extinguish wildfires." ;
                     rdfs:label "Suppression Resource" .


###  http://purl.org/ffonto#SuppressionTactic
:SuppressionTactic rdf:type owl:Class ;
                   rdfs:subClassOf :FireManagementStrategy ;
                   rdfs:comment "A specific technique applied to control or extinguish a fire."@en ;
                   rdfs:label "Suppression Tactic" .


###  http://purl.org/ffonto#SurfaceFuel
:SurfaceFuel rdf:type owl:Class .


###  http://purl.org/ffonto#SurvivalGuidance
:SurvivalGuidance rdf:type owl:Class ;
                  rdfs:comment "Recommended behaviours during wildfire incidents (evacuate, heed authorities, PPE for smoke)." ;
                  rdfs:label "Survival Guidance" .


###  http://purl.org/ffonto#SwarmUAV
:SwarmUAV rdf:type owl:Class ;
          rdfs:subClassOf :UAV ;
          rdfs:comment "A coordinated group of unmanned aerial vehicles operating together to accomplish tasks."@en ;
          rdfs:label "UAV Swarm" .


###  http://purl.org/ffonto#TelemetryData
:TelemetryData rdf:type owl:Class ;
               rdfs:comment "Remote measurements transmitted from sensors or systems for monitoring and analysis."@en ;
               rdfs:label "Telemetry Data" .


###  http://purl.org/ffonto#TemperatureAnomaly
:TemperatureAnomaly rdf:type owl:Class ;
                    rdfs:subClassOf :ClimateDriver ;
                    rdfs:comment "Periods of unusually high temperature." ;
                    rdfs:label "Temperature Anomaly" .


###  http://purl.org/ffonto#TemporalExtent
:TemporalExtent rdf:type owl:Class ;
                rdfs:comment "The specific timeframe, duration, or time interval during which an event or phenomenon occurs."@en ;
                rdfs:label "temporal extent"@en .


###  http://purl.org/ffonto#TemporalRecord
:TemporalRecord rdf:type owl:Class ;
                rdfs:subClassOf :TemporalExtent ;
                rdfs:comment "Represents whether timestamp metadata is available for pairing events." ;
                rdfs:label "Temporal Record" .


###  http://purl.org/ffonto#TemporaryFlightRestriction
:TemporaryFlightRestriction rdf:type owl:Class ;
                            rdfs:subClassOf :AirspaceManagement ;
                            rdfs:comment "Airspace restriction protecting wildfire aircraft operations." ;
                            rdfs:label "Temporary Flight Restriction (TFR)" .


###  http://purl.org/ffonto#TerrainFeature
:TerrainFeature rdf:type owl:Class ;
                rdfs:comment "Topographic elements that influence fire behavior (hills, slopes, valleys, rivers)." ;
                rdfs:label "Terrain Feature" .


###  http://purl.org/ffonto#TerrainType
:TerrainType rdf:type owl:Class ;
             rdfs:comment "Classification of physical landscape terrain." ;
             rdfs:label "Terrain type" .


###  http://purl.org/ffonto#TextAnnotation
:TextAnnotation rdf:type owl:Class ;
                rdfs:subClassOf :Annotation ;
                rdfs:comment "Textual annotation such as captions or descriptions." ;
                rdfs:label "Text Annotation" .


###  http://purl.org/ffonto#ThermalCamera
:ThermalCamera rdf:type owl:Class ;
               rdfs:subClassOf :RemoteSensor ;
               rdfs:comment "A camera capable of detecting heat signatures for identifying fire hotspots."@en ;
               rdfs:label "Thermal camera"@en ,
                          "Thermal Camera" .


###  http://purl.org/ffonto#ThresholdSet
:ThresholdSet rdf:type owl:Class ;
              rdfs:comment "A set of configured thresholds (global, smoke, fire, frame_thresh) stored with predictions." ;
              rdfs:label "Threshold Set" .


###  http://purl.org/ffonto#TimeSeriesAnalysis
:TimeSeriesAnalysis rdf:type owl:Class ;
                    rdfs:subClassOf :DataAnalysisProcess ;
                    rdfs:comment "Analysis of environmental variables over time to detect trends or anomalies." ;
                    rdfs:label "Time Series Analysis" .


###  http://purl.org/ffonto#Tool
:Tool rdf:type owl:Class ;
      rdfs:comment "Hand tools used by crews (Pulaski, McLeod, shovel, etc.)." ;
      rdfs:label "Hand Tool" .


###  http://purl.org/ffonto#Topography
:Topography rdf:type owl:Class ;
            rdfs:subClassOf :EnvironmentalFactor ;
            rdfs:comment "Physical features of terrain influencing wildfire behavior." ;
            rdfs:label "Topography" .


###  http://purl.org/ffonto#TotalLoss
:TotalLoss rdf:type owl:Class ;
           rdfs:subClassOf :StructureLossStatus ;
           rdfs:comment "Structure deemed unsalvageable; resource priorities change." ;
           rdfs:label "Total Loss" .


###  http://purl.org/ffonto#Town
:Town rdf:type owl:Class ;
      rdfs:subClassOf :SpatialEntity ;
      rdfs:comment "A smaller urban settlement than a city." ;
      rdfs:label "Town" .


###  http://purl.org/ffonto#ToxicSmoke
:ToxicSmoke rdf:type owl:Class ;
            rdfs:subClassOf :SmokeHazard ;
            rdfs:comment "Smoke from structures or hazardous materials containing toxic combustion products (plastics, treated wood)." ;
            rdfs:label "Toxic Smoke" .


###  http://purl.org/ffonto#TrafficCone
:TrafficCone rdf:type owl:Class ;
             rdfs:subClassOf :TrafficControlDevice ;
             rdfs:comment "A portable conical marker used for traffic control and scene safety."@en ;
             rdfs:label "Traffic Cone" .


###  http://purl.org/ffonto#TrafficControlDevice
:TrafficControlDevice rdf:type owl:Class ;
                      rdfs:comment "Cones, barricades, signs, tape used to control access." ;
                      rdfs:label "Traffic Control Device" .


###  http://purl.org/ffonto#Trailer
:Trailer rdf:type owl:Class ;
         rdfs:subClassOf :Vehicle ;
         rdfs:comment "Represents a towable vehicle such as a travel trailer or utility trailer." ;
         rdfs:label "Trailer" .


###  http://purl.org/ffonto#TrainingProgram
:TrainingProgram rdf:type owl:Class ;
                 rdfs:comment "Educational programs designed to prepare firefighters and communities for wildfire events." ;
                 rdfs:label "Training Program" .


###  http://purl.org/ffonto#Transformer
:Transformer rdf:type owl:Class ;
             rdfs:subClassOf :UtilityInfrastructure ;
             rdfs:comment "Electrical transformers and associated equipment." ;
             rdfs:label "Transformer" .


###  http://purl.org/ffonto#TransitionalEcosystem
:TransitionalEcosystem rdf:type owl:Class ;
                       rdfs:subClassOf :Ecosystem ;
                       rdfs:comment "An ecosystem occurring between two ecological zones." ;
                       rdfs:label "Transitional ecosystem" .


###  http://purl.org/ffonto#TransportationInfrastructure
:TransportationInfrastructure rdf:type owl:Class ;
                              rdfs:subClassOf :Infrastructure ;
                              rdfs:comment "Infrastructure related to transport (roads, bridges, guardrails, culverts, parking lots)." ;
                              rdfs:label "Transportation Infrastructure" .


###  http://purl.org/ffonto#TransportationRoute
:TransportationRoute rdf:type owl:Class ;
                     rdfs:comment "Roads or travel corridors affected by wildfire." ;
                     rdfs:label "Transportation Route" .


###  http://purl.org/ffonto#Tree
:Tree rdf:type owl:Class ;
      rdfs:subClassOf :Vegetation ;
      rdfs:comment "A woody perennial plant forming the main structural component of forest vegetation." ;
      rdfs:label "Tree" .


###  http://purl.org/ffonto#TreeRegeneration
:TreeRegeneration rdf:type owl:Class ;
                  rdfs:subClassOf :EcologicalImpact ;
                  rdfs:comment "The process of tree regrowth following fire disturbance." ;
                  rdfs:label "Tree Regeneration" .


###  http://purl.org/ffonto#Trend
:Trend rdf:type owl:Class ;
       rdfs:subClassOf :TimeSeriesAnalysis ;
       rdfs:comment "Temporal trend: increasing, decreasing, stable." ;
       rdfs:label "Trend (enum)" .


###  http://purl.org/ffonto#Tundra
:Tundra rdf:type owl:Class ;
        rdfs:subClassOf :Ecosystem ;
        rdfs:comment "Cold ecosystem with minimal vegetation and permafrost soils." ;
        rdfs:label "Tundra ecosystem" .


###  http://purl.org/ffonto#UAV
:UAV rdf:type owl:Class ;
     rdfs:subClassOf :SensorPlatform ;
     rdfs:comment "An aircraft without a human pilot used for aerial wildfire monitoring and data collection."@en ;
     rdfs:label "Unmanned Aerial Vehicle"@en ,
                "Unmanned aerial vehicle"@en ,
                "Uncrewed Aerial Vehicle (UAV) / Drone" .


###  http://purl.org/ffonto#UAVOperation
:UAVOperation rdf:type owl:Class ;
              rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ;
              rdfs:comment "A planned flight or deployment of an Unmanned Aerial Vehicle (UAV) for observation, communication, or mitigation."@en ;
              rdfs:label "UAV operation"@en .


###  http://purl.org/ffonto#Understory
:Understory rdf:type owl:Class ;
            rdfs:comment "Shrub and herbaceous vegetation and litter layer beneath the forest canopy; important as surface fuel." ;
            rdfs:label "Understory" .


###  http://purl.org/ffonto#UrbanDevelopment
:UrbanDevelopment rdf:type owl:Class ;
                  rdfs:subClassOf :EnvironmentalFactor ;
                  rdfs:comment "Human settlements near forests increasing ignition risk." ;
                  rdfs:label "Urban Development Near Forests" .


###  http://purl.org/ffonto#UrbanGrowth
