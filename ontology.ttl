###  http://purl.org/ffonto#ControlledBurn
:ControlledBurn rdf:type owl:Class ;
                rdfs:subClassOf :FireManagementStrategy ,
                                :ForestFire ,
                                :PreventionMethod ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasManagementPurpose ;
                                  owl:someValuesFrom :ManagementPurpose
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :occursIn ;
                                  owl:someValuesFrom :ForestEcosystem
                                ] ;
                rdfs:comment "A deliberately planned and managed fire used to reduce fuel loads, prevent severe forest fires, and promote forest regeneration." ;
                rdfs:label "Controlled Burn" .


