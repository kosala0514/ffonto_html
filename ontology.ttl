#################################################################
#    Object Properties
#################################################################

###  http://purl.org/ffonto#addressesRisk
:addressesRisk rdf:type owl:ObjectProperty ;
               rdfs:domain :MitigationSolution ;
               rdfs:range :FireRiskAssessment .


###  http://purl.org/ffonto#adjacentTo
:adjacentTo rdf:type owl:ObjectProperty ,
                     owl:SymmetricProperty ;
            rdfs:domain :SpatialUnit ;
            rdfs:range :SpatialUnit ;
            rdfs:comment "A symmetric relation indicating that two spatial units share a boundary. No separate inverse is needed as symmetry implies bi-directionality." ;
            rdfs:label "adjacent to" .


###  http://purl.org/ffonto#adjacentToWaterBody
:adjacentToWaterBody rdf:type owl:ObjectProperty ;
                     rdfs:domain :Ecosystem ;
                     rdfs:range :WaterBody ;
                     rdfs:comment "Indicates that an ecosystem is located next to or near a water body." ;
                     rdfs:label "adjacent to water body" .


###  http://purl.org/ffonto#adjacentToWaterBodyOf
:adjacentToWaterBodyOf rdf:type owl:ObjectProperty ;
                       owl:inverseOf :adjacentToWaterBody ;
                       rdfs:domain :WaterBody ;
                       rdfs:range :Ecosystem ;
                       rdfs:comment "Inverse relation linking adjacency to water bodies back to the features or areas described."@en ;
                       rdfs:label "inverse of adjacent to water body"@en .


###  http://purl.org/ffonto#advancingToward
:advancingToward rdf:type owl:ObjectProperty ;
                 rdfs:domain :Firefighter ;
                 rdfs:range :HoseLine ;
                 rdfs:comment "Indicates directionality of movement toward a specified target or area."@en ;
                 rdfs:label "advancing toward fire front" .


###  http://purl.org/ffonto#advancingTowardOf
:advancingTowardOf rdf:type owl:ObjectProperty ;
                   owl:inverseOf :advancingToward ;
                   rdfs:domain :HoseLine ;
                   rdfs:range :Firefighter ;
                   rdfs:comment "Inverse relation indicating movement or progression directed toward a referenced location or asset."@en ;
                   rdfs:label "inverse of advancing toward"@en .


###  http://purl.org/ffonto#affectedBy
:affectedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Infrastructure ;
            rdfs:range :ForestFire ;
            rdfs:comment "Indicates infrastructure threatened by wildfire." ;
            rdfs:label "affected by wildfire" .


###  http://purl.org/ffonto#affectedByAsh
:affectedByAsh rdf:type owl:ObjectProperty ;
               rdfs:domain :AgriculturalProduce ;
               rdfs:range :AshFall ;
               rdfs:comment "Relates an AgriculturalProduce instance to one or more AshFall instances that affected it."@en ;
               rdfs:label "affected by ash"@en .


###  http://purl.org/ffonto#affectedByAshOf
:affectedByAshOf rdf:type owl:ObjectProperty ;
                 owl:inverseOf :affectedByAsh ;
                 rdfs:domain :AshFall ;
                 rdfs:range :AgriculturalProduce ;
                 rdfs:comment "Inverse relation linking ash-related effects back to the sources or burned areas that produced them."@en ;
                 rdfs:label "inverse of affected by ash"@en .


###  http://purl.org/ffonto#affectedOf
:affectedOf rdf:type owl:ObjectProperty ;
            owl:inverseOf :affectedBy ;
            rdfs:domain :ForestFire ;
            rdfs:range :Infrastructure ;
            rdfs:comment "Inverse - Indicates infrastructure threatened by wildfire." ;
            rdfs:label "affected by wildfire of" .


###  http://purl.org/ffonto#affects
:affects rdf:type owl:ObjectProperty ;
         rdfs:domain :Hazard ;
         rdfs:range :Person ;
         rdfs:comment "A general relation indicating influence or impact on another entity."@en ;
         rdfs:label "affects" .


###  http://purl.org/ffonto#affectsAnimal
:affectsAnimal rdf:type owl:ObjectProperty ;
               owl:inverseOf :affectsAnimalOf ;
               rdfs:domain :ForestFire ;
               rdfs:range :Animal ;
               rdfs:comment "Indicates animals impacted by wildfire smoke." ;
               rdfs:label "affects animals or pets" .


###  http://purl.org/ffonto#affectsAnimalOf
:affectsAnimalOf rdf:type owl:ObjectProperty ;
                 rdfs:domain :Animal ;
                 rdfs:range :ForestFire ;
                 rdfs:comment "Inverse - Indicates animals impacted by wildfire smoke." ;
                 rdfs:label "affects animals or pets of" .


###  http://purl.org/ffonto#affectsAviationRoute
:affectsAviationRoute rdf:type owl:ObjectProperty ;
                      rdfs:domain :ForestFire ;
                      rdfs:range :AviationRoute ;
                      rdfs:comment "Indicates that conditions or events interfere with or endanger aviation routes."@en ;
                      rdfs:label "affects aviation route" .


###  http://purl.org/ffonto#affectsAviationRouteOf
:affectsAviationRouteOf rdf:type owl:ObjectProperty ;
                        owl:inverseOf :affectsAviationRoute ;
                        rdfs:domain :AviationRoute ;
                        rdfs:range :ForestFire ;
                        rdfs:comment "Links a smoke plume, Temporary Flight Restriction (TFR), or hazard back to the specific flight corridor it disrupts."@en ;
                        rdfs:label "affects aviation route of"@en ,
                                   "affects aviation route of" .


###  http://purl.org/ffonto#affectsClimatePattern
:affectsClimatePattern rdf:type owl:ObjectProperty ;
                       owl:inverseOf :isAffectedByAnomaly ;
                       rdfs:domain :ClimateAnomaly ;
                       rdfs:range :FireRegime ;
                       rdfs:comment "Relates a large-scale environmental event or continuous emission to its altering effect on long-term weather and atmospheric trends."@en ;
                       rdfs:label "affects climate pattern"@en .


###  http://purl.org/ffonto#affectsEcosystem
:affectsEcosystem rdf:type owl:ObjectProperty ;
                  rdfs:domain :ForestFire ;
                  rdfs:range :Ecosystem ;
                  owl:propertyChainAxiom ( :hasVegetation
                                           :influencedBy
                                         ) ;
                  rdfs:comment "Indicates that a fire event affects an ecosystem through vegetation relationships." ;
                  rdfs:label "affects ecosystem" .


###  http://purl.org/ffonto#affectsEcosystemOf
:affectsEcosystemOf rdf:type owl:ObjectProperty ;
                    owl:inverseOf :affectsEcosystem ;
                    rdfs:domain :Ecosystem ;
                    rdfs:range :ForestFire ;
                    rdfs:comment "Inverse relation linking ecosystem impacts back to the causal event or agent."@en ;
                    rdfs:label "inverse of affects ecosystem"@en .


###  http://purl.org/ffonto#affectsForestArea
:affectsForestArea rdf:type owl:ObjectProperty ;
                   rdfs:domain :ForestDisturbance ;
                   rdfs:range <http://www.opengis.net/ont/geosparql#SpatialObject> ;
                   rdfs:comment "Indicates that an event, phenomenon, or policy impacts a specific wooded geographic region."@en ;
                   rdfs:label "affects forest area"@en .


###  http://purl.org/ffonto#affectsForestAreaOf
:affectsForestAreaOf rdf:type owl:ObjectProperty ;
                     owl:inverseOf :affectsForestArea ;
                     rdfs:domain <http://www.opengis.net/ont/geosparql#SpatialObject> ;
                     rdfs:range :ForestDisturbance ;
                     rdfs:comment "Indicates that an event or policy impacts a specific wooded region belonging to a broader geographic or administrative boundary."@en ;
                     rdfs:label "affects forest area of"@en .


###  http://purl.org/ffonto#affectsGroundwaterRecharge
:affectsGroundwaterRecharge rdf:type owl:ObjectProperty ;
                            rdfs:domain :ForestFire ;
                            rdfs:range :Groundwater ;
                            rdfs:comment "Indicates that a wildfire influences groundwater recharge rates by altering soil permeability and vegetation cover." ;
                            rdfs:label "affects groundwater recharge" .


###  http://purl.org/ffonto#affectsGroundwaterRechargeOf
:affectsGroundwaterRechargeOf rdf:type owl:ObjectProperty ;
                              owl:inverseOf :affectsGroundwaterRecharge ;
                              rdfs:domain :Groundwater ;
                              rdfs:range :ForestFire ;
                              rdfs:comment "Inverse - Indicates that a wildfire influences groundwater recharge rates by altering soil permeability and vegetation cover." ;
                              rdfs:label "affects groundwater recharge of" .


###  http://purl.org/ffonto#affectsHabitat
:affectsHabitat rdf:type owl:ObjectProperty ;
                rdfs:domain :EcologicalEffect ;
                rdfs:range :HabitatType ;
                rdfs:comment "Indicates that an ecological effect alters wildlife habitat type (mature forest, shrub land, grass land)." ;
                rdfs:label "affects habitat" .


###  http://purl.org/ffonto#affectsHabitatOf
:affectsHabitatOf rdf:type owl:ObjectProperty ;
                  owl:inverseOf :affectsHabitat ;
                  rdfs:domain :HabitatType ;
                  rdfs:range :EcologicalEffect ;
                  rdfs:comment "Inverse relation linking habitat effects back to the driving event or condition."@en ;
                  rdfs:label "inverse of affects habitat"@en .


###  http://purl.org/ffonto#affectsHealth
:affectsHealth rdf:type owl:ObjectProperty ;
               rdfs:domain :AirPollutantProperty ;
               rdfs:range :RespiratoryIssue ;
               rdfs:comment "Indicates that an environmental condition, event, or pollutant has a measurable impact on the physical well-being of a population."@en ;
               rdfs:label "affects health"@en .


###  http://purl.org/ffonto#affectsHealthCondition
:affectsHealthCondition rdf:type owl:ObjectProperty ;
                        owl:inverseOf :healthAffectedByPM25 ;
                        rdfs:domain :ParticulateMatterPM25 ;
                        rdfs:range :RespiratoryDisease ;
                        rdfs:comment "Links an environmental hazard, like smoke or extreme heat, to its impact on a specific pre-existing medical issue or physiological state."@en ;
                        rdfs:label "affects health condition"@en .


###  http://purl.org/ffonto#affectsHealthOf
:affectsHealthOf rdf:type owl:ObjectProperty ;
                 owl:inverseOf :affectsHealth ;
                 rdfs:domain :RespiratoryIssue ;
                 rdfs:range :AirPollutantProperty ;
                 rdfs:comment "Indicates the specific population, individual, or demographic whose medical well-being is impacted by a hazard."@en ;
                 rdfs:label "affects health of"@en .


###  http://purl.org/ffonto#affectsOf
:affectsOf rdf:type owl:ObjectProperty ;
           owl:inverseOf :affects ;
           rdfs:domain :Person ;
           rdfs:range :Hazard ;
           rdfs:comment "Inverse relation indicating what entities or systems are affected by a given cause."@en ;
           rdfs:label "inverse of affects"@en .


###  http://purl.org/ffonto#affectsPopulation
:affectsPopulation rdf:type owl:ObjectProperty ;
                   owl:inverseOf :exposedToSmoke ;
                   rdfs:domain :HealthRisk ;
                   rdfs:range :PopulationGroup ;
                   rdfs:comment "Original property (exists in your ontology). Declared inverseOf :exposedToSmoke."@en ,
                                "Indicates that a health risk affects a specific population group." ;
                   rdfs:label "affects population"@en ,
                              "affects population group" .


###  http://purl.org/ffonto#affectsRateOfSpread
:affectsRateOfSpread rdf:type owl:ObjectProperty ;
                     rdfs:domain :MeteorologicalObservation ;
                     rdfs:range :RateOfSpread ;
                     rdfs:comment "Relates a meteorological variable or factor to the rate of spread it influences."@en ;
                     rdfs:label "affects rate of spread"@en .


###  http://purl.org/ffonto#affectsRespiratoryHealth
:affectsRespiratoryHealth rdf:type owl:ObjectProperty ;
                          rdfs:domain :AirPollution ;
                          rdfs:range :HumanHealth ;
                          rdfs:comment "Represents the impact of air pollution on human respiratory health." ;
                          rdfs:label "affects respiratory health" .


###  http://purl.org/ffonto#affectsRespiratoryHealthOf
:affectsRespiratoryHealthOf rdf:type owl:ObjectProperty ;
                            owl:inverseOf :affectsRespiratoryHealth ;
                            rdfs:domain :HumanHealth ;
                            rdfs:range :AirPollution ;
                            rdfs:comment "Inverse - Represents the impact of air pollution on human respiratory health." ;
                            rdfs:label "affects respiratory health of" .


###  http://purl.org/ffonto#affectsVegetation
:affectsVegetation rdf:type owl:ObjectProperty ;
                   rdfs:domain :WildfireScene ;
                   rdfs:range :Vegetation ;
                   rdfs:comment "Indicates wildfire effects on vegetation." ;
                   rdfs:label "affects vegetation" .


###  http://purl.org/ffonto#affectsVegetationMoisture
:affectsVegetationMoisture rdf:type owl:ObjectProperty ;
                           owl:inverseOf :isAffectedByEvapotranspiration ;
                           rdfs:domain :Evapotranspiration ;
                           rdfs:range :FuelMoisture ;
                           rdfs:comment "Indicates that a climate event or weather condition alters the water content of plant fuel loads."@en ;
                           rdfs:label "affects vegetation moisture"@en .


###  http://purl.org/ffonto#affectsVegetationOf
:affectsVegetationOf rdf:type owl:ObjectProperty ;
                     owl:inverseOf :affectsVegetation ;
                     rdfs:domain :Vegetation ;
                     rdfs:range :WildfireScene ;
                     rdfs:comment "Inverse - Indicates wildfire effects on vegetation." ;
                     rdfs:label "affects vegetation of" .


###  http://purl.org/ffonto#affectsWaterBody
:affectsWaterBody rdf:type owl:ObjectProperty ;
                  rdfs:domain :WildfireScene ;
                  rdfs:range :WaterBody ;
                  rdfs:comment "Indicates that wildfire impacts affect a nearby water body." ;
                  rdfs:label "affects water body" .


###  http://purl.org/ffonto#affectsWaterBodyOf
:affectsWaterBodyOf rdf:type owl:ObjectProperty ;
                    owl:inverseOf :affectsWaterBody ;
                    rdfs:domain :WaterBody ;
                    rdfs:range :WildfireScene ;
                    rdfs:comment "Inverse - Indicates that wildfire impacts affect a nearby water body." ;
                    rdfs:label "affects water body of" .


###  http://purl.org/ffonto#affectsWildlife
:affectsWildlife rdf:type owl:ObjectProperty ;
                 rdfs:domain :ForestFire ;
                 rdfs:range :Wildlife ;
                 rdfs:comment "Indicates an effect or impact on wildlife populations or habitats."@en ;
                 rdfs:label "affects wildlife"@en .


###  http://purl.org/ffonto#affectsWildlifeOf
:affectsWildlifeOf rdf:type owl:ObjectProperty ;
                   owl:inverseOf :affectsWildlife ;
                   rdfs:domain :Wildlife ;
                   rdfs:range :ForestFire ;
                   rdfs:comment "Inverse relation linking wildlife impacts back to the causative disturbances or conditions."@en ;
                   rdfs:label "inverse of affects wildlife"@en .


###  http://purl.org/ffonto#aircraftAction
:aircraftAction rdf:type owl:ObjectProperty ;
                rdfs:domain :ForestFire ;
                rdfs:range :AircraftAction ;
                rdfs:comment "An action performed by an aircraft during operations (e.g., drop, reconnaissance)."@en ;
                rdfs:label "aircraft action" .


###  http://purl.org/ffonto#aircraftActionOf
:aircraftActionOf rdf:type owl:ObjectProperty ;
                  owl:inverseOf :aircraftAction ;
                  rdfs:domain :AircraftAction ;
                  rdfs:range :ForestFire ;
                  rdfs:comment "Links a specific aerial maneuver, drop, or reconnaissance flight back to the broader aviation operation or incident strategy."@en ;
                  rdfs:label "aircraft action of"@en ,
                             "aircraft action of" .


###  http://purl.org/ffonto#allocatesResource
:allocatesResource rdf:type owl:ObjectProperty ;
                   rdfs:domain :ResourceAllocationOptimization ;
                   rdfs:range :FirefightingResource ;
                   rdfs:comment "Indicates the distribution or assignment of personnel, equipment, or funds to a specific task or location."@en ;
                   rdfs:label "allocates resource"@en .


###  http://purl.org/ffonto#allocatesResourceOf
:allocatesResourceOf rdf:type owl:ObjectProperty ;
                     owl:inverseOf :allocatesResource ;
                     rdfs:domain :FirefightingResource ;
                     rdfs:range :ResourceAllocationOptimization ;
                     rdfs:comment "Connects an assignment action or logistical plan to the specific equipment, personnel, or funds being distributed."@en ;
                     rdfs:label "allocates resource of"@en .


###  http://purl.org/ffonto#altersSpeciesComposition
:altersSpeciesComposition rdf:type owl:ObjectProperty ;
                          rdfs:domain :EcologicalEffect ;
                          rdfs:range :Vegetation ;
                          rdfs:comment "Fire may change species composition." ;
                          rdfs:label "alters species composition" .


###  http://purl.org/ffonto#altersSpeciesCompositionOf
:altersSpeciesCompositionOf rdf:type owl:ObjectProperty ;
                            owl:inverseOf :altersSpeciesComposition ;
                            rdfs:domain :Vegetation ;
                            rdfs:range :EcologicalEffect ;
                            rdfs:comment "Inverse relation linking species composition changes back to the drivers or disturbances responsible."@en ;
                            rdfs:label "inverse of alters species composition"@en .


###  http://purl.org/ffonto#analyzesAudioSignal
:analyzesAudioSignal rdf:type owl:ObjectProperty ;
                     owl:inverseOf :isAnalyzedByAudio ;
                     rdfs:domain :AudioAnalytics ;
                     rdfs:range :TelemetryData ;
                     rdfs:comment "Connects a system, AI model, or sensor to the acoustic data it processes to detect anomalies or events."@en ;
                     rdfs:label "analyzes audio signal"@en .


###  http://purl.org/ffonto#analyzesTemporalData
:analyzesTemporalData rdf:type owl:ObjectProperty ;
                      owl:inverseOf :isAnalyzedTemporally ;
                      rdfs:domain :TimeSeriesAnalysis ;
                      rdfs:range :TelemetryData ;
                      rdfs:comment "Connects a system, algorithm, or process to its function of examining time-series information for trends or anomalies."@en ;
                      rdfs:label "analyzes temporal data"@en .


###  http://purl.org/ffonto#animalVisible
:animalVisible rdf:type owl:ObjectProperty ;
               rdfs:domain :ForestFire ;
               rdfs:range :Animal ;
               rdfs:comment "Indicates that one or more animals are visibly present in an observation or image."@en ;
               rdfs:label "animal visible" .


###  http://purl.org/ffonto#animalVisibleOf
:animalVisibleOf rdf:type owl:ObjectProperty ;
                 owl:inverseOf :animalVisible ;
                 rdfs:domain :Animal ;
                 rdfs:range :ForestFire ;
                 rdfs:comment "Inverse relation linking animal visibility observations back to the reports or imagery in which they appear."@en ;
                 rdfs:label "inverse of animal visible"@en .


###  http://purl.org/ffonto#appliedToFire
:appliedToFire rdf:type owl:ObjectProperty ;
               rdfs:domain :SuppressionTactic ;
               rdfs:range :FireFront ;
               rdfs:comment "Connects a mitigation strategy, resource allocation, or predictive model to the specific fire incident it addresses."@en ;
               rdfs:label "applied to fire"@en .


###  http://purl.org/ffonto#appliesToUAV
:appliesToUAV rdf:type owl:ObjectProperty ;
              owl:inverseOf :operatesUnderBVLOS ;
              rdfs:domain :BVLOS ;
              rdfs:range :UAV ;
              rdfs:comment "Relates a rule, strategy, protocol, or physical attachment specifically to an Unmanned Aerial Vehicle."@en ;
              rdfs:label "applies to UAV"@en .


###  http://purl.org/ffonto#appliesToUtility
:appliesToUtility rdf:type owl:ObjectProperty ;
                  rdfs:domain :RecoveryGuideline ;
                  rdfs:range :UtilitySystem ;
                  rdfs:comment "Indicates that a recovery guideline applies to a utility system." ;
                  rdfs:label "applies to utility" .


###  http://purl.org/ffonto#appliesToUtilityOf
:appliesToUtilityOf rdf:type owl:ObjectProperty ;
                    owl:inverseOf :appliesToUtility ;
                    rdfs:domain :UtilitySystem ;
                    rdfs:range :RecoveryGuideline ;
                    rdfs:comment "Inverse relation linking policy applicability back to the utility or infrastructure to which it applies."@en ;
                    rdfs:label "inverse of applies to utility"@en .


###  http://purl.org/ffonto#appliesToWater
