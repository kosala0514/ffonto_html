###  http://purl.org/ffonto#Forest
:Forest rdf:type owl:Class ;
        rdfs:comment "A large area dominated by trees and natural vegetation."@en ;
        rdfs:label "Forest"@en .


###  http://purl.org/ffonto#ForestDisturbance
:ForestDisturbance rdf:type owl:Class ;
                   rdfs:subClassOf :EnvironmentalFactor ;
                   rdfs:comment "Events that alter forest ecosystems such as pests, disease, or drought." ;
                   rdfs:label "Forest Disturbance" .


###  http://purl.org/ffonto#ForestEcosystem
:ForestEcosystem rdf:type owl:Class ;
                 rdfs:subClassOf :Ecosystem ;
                 rdfs:comment "An ecosystem dominated by trees and woody vegetation." ;
                 rdfs:label "Forest Ecosystem" .


###  http://purl.org/ffonto#ForestFire
:ForestFire rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :hasBurnSeverity ;
                              owl:someValuesFrom :FireSeverity
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasIgnitionSource ;
                              owl:someValuesFrom :IgnitionSource
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :occursIn ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :ForestEcosystem
                            ] ;
            rdfs:comment "An uncontrolled fire occurring in natural vegetation." ;
            rdfs:label "Forest Fire" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Wildfire" .


###  http://purl.org/ffonto#ForestFireCause
:ForestFireCause rdf:type owl:Class ;
                 rdfs:comment "Natural or human activities responsible for wildfire ignition." ;
                 rdfs:label "ForestFire Cause" .


###  http://purl.org/ffonto#ForestFireEffect
:ForestFireEffect rdf:type owl:Class ;
                  rdfs:comment "Represents the ecological, environmental, or economic consequence resulting from a wildfire, such as soil erosion or habitat loss."@en ;
                  rdfs:label "Forest Fire Effect"@en .


###  http://purl.org/ffonto#ForestFirePredictionModel
:ForestFirePredictionModel rdf:type owl:Class ;
                           rdfs:comment "Computational models used to forecast wildfire ignition, spread, and impact." ;
                           rdfs:label "ForestFire Prediction Model" .


