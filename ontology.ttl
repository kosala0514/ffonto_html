###  http://purl.org/ffonto#UtilityInfrastructure
:UtilityInfrastructure rdf:type owl:Class ;
                       rdfs:subClassOf :Infrastructure ;
                       rdfs:comment "Infrastructure related to utilities (power poles, lines, transformers, insulators, meters)." ;
                       rdfs:label "Utility Infrastructure" .


###  http://purl.org/ffonto#UtilityPowerShutoff
:UtilityPowerShutoff rdf:type owl:Class ;
