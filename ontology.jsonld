  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Intermediate area for fuel reduction and spacing (e.g., 5-30 feet)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Zone 2 (Intermediate Zone)"
