  "http://creativecommons.org/ns#license" : [ {
    "@value" : ""
  } ],
  "http://purl.org/dc/elements/1.1/abstract" : [ {
    "@language" : "en",
    "@value" : "The Forest Fire Ontology (FFONTO) is designed to integrate multi-modal sensor data for early fire detection. It serves as an extensible framework with 'ForestFire' as the root class, incorporating concepts for visual detection, audio monitoring, and environmental conditions."
  } ],
  "http://purl.org/dc/elements/1.1/contributor" : [ {
    "@id" : "_:genid1"
  } ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@id" : "_:genid2"
  } ],
  "http://purl.org/dc/elements/1.1/description" : [ {
    "@language" : "en",
    "@value" : "This ontology describes forest fire detection observations including image, audio, and weather data."
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@language" : "en",
    "@value" : "Forest Fire Ontology (FFONTO)"
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-01-27"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@value" : ""
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@language" : "en",
    "@value" : "ffonto"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Ontology for forest fire detection & observation (image, audio, weather). Root class: ForestFire. Designed for extensibility."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
