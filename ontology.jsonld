  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.org/ffonto#InsurancePolicy"
  } ]
}, {
  "@id" : "http://purl.org/ffonto#HomePrepInside",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/ffonto#usesProtectionMethod" : [ {
    "@id" : "http://purl.org/ffonto#ShutOffGasAction"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://purl.org/ffonto#HomeProtectionMeasure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Close windows, vents, blinds; remove light curtains; shut off gas and pilot lights; move flammable furniture to center of rooms; turn on interior lights for visibility in smoke."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Interior Home Prep"
  } ]
}, {
  "@id" : "http://purl.org/ffonto#HomePrepOutside",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/ffonto#usesProtectionMethod" : [ {
    "@id" : "http://purl.org/ffonto#SealVentsAction"
  }, {
    "@id" : "http://purl.org/ffonto#TurnOffPropane"
  }, {
    "@id" : "http://purl.org/ffonto#WetRoofAction"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://purl.org/ffonto#HomeProtectionMeasure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Seal vents, turn off propane tanks, remove combustibles within 10-30 feet, connect hoses, wet roof if possible, place lawn sprinklers on roof if safe, gather fire tools."
  } ],
