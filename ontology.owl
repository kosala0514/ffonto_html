    <!-- http://purl.org/ffonto#hasBarrierWidth -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasBarrierWidth">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#NaturalBarrier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Relates a natural barrier to its width which may influence fire spread.</rdfs:comment>
        <rdfs:label>has barrier width</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasBurnTemperature -->


