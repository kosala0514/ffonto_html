        <rdfs:label>Pine tree</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#PlannedIgnition -->


    <owl:Class rdf:about="http://purl.org/ffonto#PlannedIgnition">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#IgnitionSource"/>
