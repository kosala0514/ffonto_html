        <rdfs:comment xml:lang="en">Indicates that caution tape is present to mark hazards or restricted areas.</rdfs:comment>
        <rdfs:label>has caution tape</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasChannelWidth -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasChannelWidth">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WaterChannel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Relates a water channel to its width measurement.</rdfs:comment>
        <rdfs:label>has channel width</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasCombustibleSiding -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasCombustibleSiding">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Siding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
