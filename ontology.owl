    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#activeFireSuppression -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#activeFireSuppression">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireSuppressionAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
