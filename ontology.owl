        <rdfs:label xml:lang="en">is combined in forecast</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isCombustionAffectedByChemicalComponent -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isCombustionAffectedByChemicalComponent">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#CombustionProcess"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#VegetationChemicalComponent"/>
        <rdfs:comment xml:lang="en">Indicates that the burning characteristics of a fuel are modulated by its specific chemical makeup, such as volatile oils.</rdfs:comment>
        <rdfs:label xml:lang="en">is combustion affected by chemical component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isCombustionAffectedByFuelMoisture -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isCombustionAffectedByFuelMoisture">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#CombustionProcess"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FuelMoisture"/>
        <rdfs:comment xml:lang="en">Relates the burning process of a fire to the modulating influence of water content within the available biomass.</rdfs:comment>
        <rdfs:label xml:lang="en">is combustion affected by fuel moisture</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isCommandPostOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isCommandPostOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasCommandPost"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#IncidentCommandPost"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WildfireScene"/>
        <rdfs:comment>Inverse - Indicates that a wildfire scene includes an incident command post.</rdfs:comment>
        <rdfs:label>is command post of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isCommunicationMethodOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isCommunicationMethodOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasCommunicationMethod"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#CommunicationMethod"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#IncidentCommandSystem"/>
        <rdfs:comment xml:lang="en">Inverse relation linking communication methods back to the organizations or systems that use them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of is communication method</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isComponentOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isComponentOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasComponent"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#BuildingComponent"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Building"/>
        <rdfs:comment>Inverse - Relates a building to its structural components such as roof, gutter, or siding.</rdfs:comment>
        <rdfs:label>is building component of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isComponentOfVegetation -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isComponentOfVegetation">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasPlantComponent"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Plant"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Vegetation"/>
        <rdfs:comment>Indicates that a plant is part of a vegetation community.</rdfs:comment>
        <rdfs:label>is component of vegetation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isConsumedIn -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isConsumedIn">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FuelCharacteristic"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#CombustionProcess"/>
        <rdfs:comment xml:lang="en">Connects a resource, such as water, retardant, or fuel, to the specific incident or operational process that depletes it.</rdfs:comment>
        <rdfs:label xml:lang="en">is consumed in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isContactOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isContactOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasContact"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Contact"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking contact records back to the persons or organizations they reference.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of is contact</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isContainedByFireLine -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isContainedByFireLine">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireFront"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireLine"/>
        <rdfs:comment xml:lang="en">Links a fire incident or advancing front to the physical barrier constructed or utilized to stop its spread.</rdfs:comment>
        <rdfs:label xml:lang="en">is contained by fire line</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isContainmentStateOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isContainmentStateOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasContainmentState"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ContainmentState"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking containment state descriptions back to the incidents they describe.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of has containment state</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isControlsAccessOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isControlsAccessOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#controlsAccess"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#TrafficControlDevice"/>
        <rdfs:comment xml:lang="en">Inverse relation linking controls on access back to the resources or areas they regulate.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of controls access</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isDamageOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isDamageOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasDamage"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#StructuralDamage"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Building"/>
        <rdfs:comment xml:lang="en">Inverse relation linking damage descriptions back to the incidents or hazards causing them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of is damage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isDataEntityGeneratedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isDataEntityGeneratedBy">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">Inverse property linking a data entity back to the activity that generated it.</rdfs:comment>
        <rdfs:label xml:lang="en">is data entity generated by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isDataReliedOnBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isDataReliedOnBy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#EarthObservationData"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#SensorFusion"/>
        <rdfs:comment xml:lang="en">Inverse property indicating the sensor fusion process that depends on specific observation data.</rdfs:comment>
        <rdfs:label xml:lang="en">is data relied on by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isDependsOnWaterSourceOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isDependsOnWaterSourceOf">
