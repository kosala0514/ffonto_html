        <rdfs:label>utility implements PSPS</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#utilityImplementsPSPSOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#utilityImplementsPSPSOf">
