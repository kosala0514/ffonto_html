        <rdfs:label xml:lang="en">indicates moisture condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#influencedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#influencedBy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireBehavior"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EnvironmentalCondition"/>
        <rdfs:comment>Indicates environmental conditions that affect the behavior of a fire event.</rdfs:comment>
        <rdfs:label>influenced by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#influencedByEnvironmentalCondiction -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#influencedByEnvironmentalCondiction">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#contributesToFireRisk"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireBehavior"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EnvironmentalCondition"/>
        <rdfs:comment xml:lang="en">Inverse relation linking entities to the environmental conditions that influence them (note: spelling preserved from source).</rdfs:comment>
        <rdfs:label xml:lang="en">influenced by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#influencedByGroundwater -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#influencedByGroundwater">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WaterAvailability"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Groundwater"/>
