        <rdfs:label>suggests environmental process</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#suggestsEnvironmentalProcessOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#suggestsEnvironmentalProcessOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#suggestsEnvironmentalProcess"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:comment xml:lang="en">Inverse relation linking proposed environmental processes back to the evidence or observations supporting them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of suggests environmental process</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#supervisesAircraft -->


