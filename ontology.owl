        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Relates grass vegetation to its average height.</rdfs:comment>
        <rdfs:label>has grass height</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasHabitatCapacity -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasHabitatCapacity">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#HabitatProvision"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Relates habitat provision to the capacity of an ecosystem to support living organisms.</rdfs:comment>
        <rdfs:label>has habitat capacity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasHabitatLossPercentage -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasHabitatLossPercentage">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#HabitatLoss"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
