        <rdfs:label>Fire Spread</rdfs:label>
        <rdfs:label>Fire Spread Behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireSpreadCondition -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireSpreadCondition">
        <rdfs:comment>Environmental or ecological conditions that influence how a fire spreads across a landscape.</rdfs:comment>
        <rdfs:label>Fire Spread Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireSuppressionAction -->


