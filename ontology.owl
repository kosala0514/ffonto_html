    <!-- http://purl.org/ffonto#partOfBuilding -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#partOfBuilding">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/ffonto#Chimney"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#MeterBox"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Building"/>
        <rdfs:comment>Indicates an element (roof, gutter, chimney, meterbox) is part of a building.</rdfs:comment>
        <rdfs:label>part of building</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#partOfBuildingOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#partOfBuildingOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#partOfBuilding"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Building"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/ffonto#Chimney"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#MeterBox"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Inverse relation linking building component records back to the parent building they belong to.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of part of building</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#partOfFire -->


