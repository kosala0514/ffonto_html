        <rdfs:label xml:lang="en">Explainable AI</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ExplosionEvent -->


    <owl:Class rdf:about="http://purl.org/ffonto#ExplosionEvent">
        <rdfs:comment>An explosion detected within the wildfire response environment.</rdfs:comment>
