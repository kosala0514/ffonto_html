        <rdfs:label>continuous crackling sound detected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasDate -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasDate">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#TemporalExtent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Links an event, document, or observation to the specific calendar date on which it occurred or was recorded.</rdfs:comment>
        <rdfs:label xml:lang="en">has date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasDateTime -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasDateTime">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#TemporalExtent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Links an event, observation, or log entry to an exact timestamp combining both date and time of day.</rdfs:comment>
        <rdfs:label xml:lang="en">has date time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasDay -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasDay">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#TemporalExtent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gDay"/>
        <rdfs:comment xml:lang="en">Connects a temporal entity or recorded event to the specific numerical day of the month.</rdfs:comment>
        <rdfs:label xml:lang="en">has day</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasDayName -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasDayName">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#TemporalExtent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Connects a temporal record or scheduled event to the specific day of the week (e.g., Monday, Tuesday).</rdfs:comment>
        <rdfs:label xml:lang="en">has day name</rdfs:label>
    </owl:DatatypeProperty>
    


