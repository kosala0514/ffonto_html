    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#extractedFrom -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#extractedFrom">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WellWater"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Groundwater"/>
        <rdfs:comment>Indicates that well water is extracted from groundwater.</rdfs:comment>
        <rdfs:label>extracted from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#extractedOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#extractedOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#extractedFrom"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Groundwater"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WellWater"/>
        <rdfs:comment>Inverse - Indicates that well water is extracted from groundwater.</rdfs:comment>
        <rdfs:label>extracted of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#favorsSpecies -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#favorsSpecies">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#EcologicalEffect"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#VegetationFunctionalGroup"/>
        <rdfs:comment>Indicates which functional groups are favored by a given ecological effect.</rdfs:comment>
        <rdfs:label>favors species group</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#favorsSpeciesOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#favorsSpeciesOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#favorsSpecies"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#VegetationFunctionalGroup"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EcologicalEffect"/>
        <rdfs:comment xml:lang="en">Inverse relation indicating that conditions support or promote a species in an area.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of favors species</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#filtersAirInShelter -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#filtersAirInShelter">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasAirConditioner"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AirConditioner"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#CleanAirShelter"/>
        <rdfs:comment xml:lang="en">Indicates that a mitigation device or HVAC system actively cleans the indoor atmosphere of a designated safe facility.</rdfs:comment>
        <rdfs:label xml:lang="en">filters air in shelter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#fireSpreadAffectedByEnvironmentalFactor -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#fireSpreadAffectedByEnvironmentalFactor">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireSpread"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EnvironmentalFactor"/>
        <rdfs:comment xml:lang="en">Indicates that the rate or direction of a fire&apos;s growth is altered by a specific natural condition, such as wind speed or topography.</rdfs:comment>
        <rdfs:label xml:lang="en">fire spread affected by environmental factor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#flammabilityInfluencesRiskAssessment -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#flammabilityInfluencesRiskAssessment">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isRiskAssessmentInfluencedByFlammability"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SeasonalFlammability"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#RiskAssessment"/>
        <rdfs:comment xml:lang="en">Relates the combustible characteristics of an area or material to the calculated operational risk level.</rdfs:comment>
        <rdfs:label xml:lang="en">flammability influences risk assessment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#followedByAircraft -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#followedByAircraft">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#followsFlightPath"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FlightPath"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#UAV"/>
        <rdfs:comment xml:lang="en">Links a designated flight path, lead plane, or operational tactic to the aerial asset executing or tailing it.</rdfs:comment>
        <rdfs:label xml:lang="en">followed by aircraft</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#followsFlightPath -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#followsFlightPath">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#UAV"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FlightPath"/>
        <rdfs:comment xml:lang="en">Indicates the pre-planned or dynamic aerial route navigated by an aircraft or UAV.</rdfs:comment>
        <rdfs:label xml:lang="en">follows flight path</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#fragmentsHabitat -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#fragmentsHabitat">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#HabitatFragmentation"/>
        <rdfs:comment>Indicates that infrastructure divides habitats.</rdfs:comment>
        <rdfs:label>fragments habitat</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#fragmentsHabitatOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#fragmentsHabitatOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#fragmentsHabitat"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#HabitatFragmentation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:comment xml:lang="en">Inverse relation linking habitat fragmentation records back to the landscape processes causing them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of fragments habitat</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#fuelInfluencesFireBehavior -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#fuelInfluencesFireBehavior">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isFireBehaviorInfluencedByFuel"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FuelType"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireBehavior"/>
        <rdfs:comment xml:lang="en">Relates the combustible material (biomass) in an area to how its properties dictate the intensity and spread of a fire.</rdfs:comment>
        <rdfs:label xml:lang="en">fuel influences fire behavior</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#fuelMoistureAffectsCombustion -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#fuelMoistureAffectsCombustion">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isCombustionAffectedByFuelMoisture"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FuelMoisture"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#CombustionProcess"/>
        <rdfs:comment xml:lang="en">Connects the water content of biomass to its influence on the ignition likelihood and burning rate of a fire.</rdfs:comment>
        <rdfs:label xml:lang="en">fuel moisture affects combustion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#fusesData -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#fusesData">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#MultimodalDataFusion"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#DataStream"/>
        <rdfs:comment xml:lang="en">Combines multiple data sources into a unified representation for analysis.</rdfs:comment>
        <rdfs:label>fuses data stream</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#fusesDataOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#fusesDataOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#fusesData"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#DataStream"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#MultimodalDataFusion"/>
        <rdfs:comment xml:lang="en">Inverse relation indicating that data fusion outputs are associated with a specific source or dataset.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of fuses data</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#gatheringAt -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#gatheringAt">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Civilian"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AssemblyArea"/>
        <rdfs:comment>Civilians gathering at a safe area.</rdfs:comment>
        <rdfs:label>gathering at</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#gatheringAtOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#gatheringAtOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#gatheringAt"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AssemblyArea"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Civilian"/>
        <rdfs:comment xml:lang="en">Inverse relation linking gatherings back to the locations or assembly points where they occur.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of gathering at</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#generated -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#generated">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#MLModel"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Annotation"/>
        <rdfs:comment>Inverse of generated by.</rdfs:comment>
        <rdfs:label>generated</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#generatedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#generatedBy">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#generated"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Annotation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#MLModel"/>
        <rdfs:comment>Indicates which model generated the annotation.</rdfs:comment>
        <rdfs:label>generated by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#generatedByModel -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#generatedByModel">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ModelOutput"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ModelVersion"/>
        <rdfs:comment xml:lang="en">Denotes that an output or dataset was produced by a specific model.</rdfs:comment>
        <rdfs:label>generated by model version</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#generatedByModelOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#generatedByModelOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#generatedByModel"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ModelVersion"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ModelOutput"/>
        <rdfs:comment xml:lang="en">Inverse relation linking model outputs back to the model that generated them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of generated by model</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#generatedByWildfire -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#generatedByWildfire">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AshFall"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Relates an AshFall instance to a Wildfire instance that generated the ash (if known).</rdfs:comment>
        <rdfs:label xml:lang="en">generated by wildfire</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#generatedByWildfireOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#generatedByWildfireOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#generatedByWildfire"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AshFall"/>
        <rdfs:comment xml:lang="en">Inverse relation linking outputs or impacts back to the wildfire events that generated them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of generated by wildfire</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#generatesAlert -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#generatesAlert">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireAlertSystem"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EmergencyAlert"/>
        <rdfs:comment xml:lang="en">Links a sensor, predictive model, or monitoring system to the warning notification it produces in response to a threshold breach.</rdfs:comment>
        <rdfs:label xml:lang="en">generates alert</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#generatesAlertOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#generatesAlertOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#generatesAlert"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#EmergencyAlert"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireAlertSystem"/>
        <rdfs:comment xml:lang="en">Connects an automated warning or notification back to the specific system, sensor, or threshold that triggered it.</rdfs:comment>
        <rdfs:label xml:lang="en">generates alert of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#generatesDataEntity -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#generatesDataEntity">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isDataEntityGeneratedBy"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">Links a processing activity to the provenance entity (e.g., report, dataset) it produces.</rdfs:comment>
        <rdfs:label xml:lang="en">generates data entity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#generatesPyroWeather -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#generatesPyroWeather">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:comment>Indicates fire-induced weather (pyrocumulus, fire-generated winds).</rdfs:comment>
        <rdfs:label>generates pyro-weather</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#generatesPyroWeatherOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#generatesPyroWeatherOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#generatesPyroWeather"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking pyro-weather generation back to the fires or conditions that produced it.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of generates pyro weather</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#governedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#governedBy">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#LegalFramework"/>
        <rdfs:comment>Associates an activity or plan with a legal or policy instrument.</rdfs:comment>
        <rdfs:label>governed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#governedOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#governedOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#governedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#LegalFramework"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Inverse relation linking governance relationships back to the entities or rules that govern them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of governed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#governsModel -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#governsModel">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isModelGovernedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AIModelGovernance"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#MLOpsPipeline"/>
        <rdfs:comment xml:lang="en">Connects an AI model governance framework to the MLOps pipeline it oversees.</rdfs:comment>
        <rdfs:label xml:lang="en">governs model</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#guidesOperation -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#guidesOperation">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isOperationGuidedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#OperationalStrategy"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#OperationsSection"/>
        <rdfs:comment xml:lang="en">Relates an operational strategy to the specific operations section it guides.</rdfs:comment>
        <rdfs:label xml:lang="en">guides operation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#guidingTraffic -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#guidingTraffic">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Responder"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:comment>Responder actively guiding traffic on a road.</rdfs:comment>
        <rdfs:label>guiding traffic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#guidingTrafficOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#guidingTrafficOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#guidingTraffic"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Responder"/>
        <rdfs:comment xml:lang="en">Inverse relation linking traffic guidance actions back to the units or incidents responsible.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of guiding traffic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#handlesFinanceFor -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#handlesFinanceFor">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasFinanceAdministrationSection"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FinanceAdministrationSection"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WildfireIncident"/>
        <rdfs:comment xml:lang="en">Relates an administrative section, role, or system to the incident or operation it funds and tracks.</rdfs:comment>
        <rdfs:label xml:lang="en">handles finance for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasAccessConstraint -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasAccessConstraint">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AccessConstraintDetail"/>
        <rdfs:comment>Specific access limitation (single road, steep grade).</rdfs:comment>
        <rdfs:label>has access constraint</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasAerialResource -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasAerialResource">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AerialResource"/>
        <rdfs:comment xml:lang="en">Associates an incident or operation with assigned aerial assets.</rdfs:comment>
        <rdfs:label>has aerial firefighting resource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasAerialVisibility -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasAerialVisibility">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AerialVisibility"/>
        <rdfs:comment>Visibility condition for aircraft.</rdfs:comment>
        <rdfs:label>has aerial visibility</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasAirConditioner -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasAirConditioner">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#CleanAirShelter"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AirConditioner"/>
        <rdfs:comment xml:lang="en">Relates a facility or sheltered environment to the HVAC system used to regulate its temperature and indoor air quality.</rdfs:comment>
        <rdfs:label xml:lang="en">has air conditioner</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasAlertStatus -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasAlertStatus">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AlertSystemStatus"/>
        <rdfs:comment xml:lang="en">Specifies the current alert or warning level for an entity or area.</rdfs:comment>
        <rdfs:label>has alert system status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasAnnotation -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasAnnotation">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isAnnotationOf"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Annotation"/>
        <rdfs:comment>Links an observation to an annotation derived from it.</rdfs:comment>
        <rdfs:label>has annotation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasAudioObservation -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasAudioObservation">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/ffonto#hasObservation"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AudioObservation"/>
        <rdfs:comment>Audio detections associated with the incident.</rdfs:comment>
        <rdfs:label>has audio event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasAudioRecord -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasAudioRecord">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AudioObservation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AudioRecord"/>
        <rdfs:comment>Relates an audio-based observation to the actual acoustic recording file.</rdfs:comment>
        <rdfs:label>has audio record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasAudit -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasAudit">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/ffonto#AudioRecord"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#ImageAsset"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#VisionModelScores"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AuditRecord"/>
        <rdfs:comment>Links an item to an AuditRecord (checksums, class-map checksum, etc.).</rdfs:comment>
        <rdfs:label>has audit record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasBriefingArea -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasBriefingArea">
