        <rdfs:label xml:lang="en">has vision model scores</rdfs:label>
        <rdfs:label>has vision model scores</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasWaterTank -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasWaterTank">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#House"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WaterTank"/>
        <rdfs:comment>Indicates a house having a rooftop water tank or cistern.</rdfs:comment>
        <rdfs:label>has water tank</rdfs:label>
    </owl:ObjectProperty>
    


