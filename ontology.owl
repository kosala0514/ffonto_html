        <rdfs:domain rdf:resource="http://purl.org/ffonto#EnvironmentalRisk"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:comment>Inverse - Indicates factors that increase environmental hazards.</rdfs:comment>
        <rdfs:label>increases environmental risk of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#increasesErosionRisk -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#increasesErosionRisk">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ErosionRisk"/>
