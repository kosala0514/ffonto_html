    <!-- http://purl.org/ffonto#sceneFeaturesObservation -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#sceneFeaturesObservation">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#observedAtScene"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WildfireScene"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:comment>Inverse of observedAtScene - Links a scene to the observations made within it.</rdfs:comment>
