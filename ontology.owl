        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Volume of dead vegetation biomass present in an area.</rdfs:comment>
        <rdfs:label>has dead biomass volume</rdfs:label>
    </owl:DatatypeProperty>
    


