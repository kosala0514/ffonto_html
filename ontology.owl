        <rdfs:label xml:lang="en">chemical component affects combustion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#classifiedAs -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#classifiedAs">
