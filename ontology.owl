        <rdfs:label>soil nutrient level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#solarPanelDamaged -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#solarPanelDamaged">
