    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/ffonto#addressesRisk -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#addressesRisk">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#MitigationSolution"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireRiskAssessment"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#adjacentTo -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#adjacentTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SpatialUnit"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#SpatialUnit"/>
        <rdfs:comment>A symmetric relation indicating that two spatial units share a boundary. No separate inverse is needed as symmetry implies bi-directionality.</rdfs:comment>
        <rdfs:label>adjacent to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#adjacentToWaterBody -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#adjacentToWaterBody">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WaterBody"/>
        <rdfs:comment>Indicates that an ecosystem is located next to or near a water body.</rdfs:comment>
        <rdfs:label>adjacent to water body</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#adjacentToWaterBodyOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#adjacentToWaterBodyOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#adjacentToWaterBody"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WaterBody"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:comment xml:lang="en">Inverse relation linking adjacency to water bodies back to the features or areas described.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of adjacent to water body</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#advancingToward -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#advancingToward">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Firefighter"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#HoseLine"/>
        <rdfs:comment xml:lang="en">Indicates directionality of movement toward a specified target or area.</rdfs:comment>
        <rdfs:label>advancing toward fire front</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#advancingTowardOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#advancingTowardOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#advancingToward"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#HoseLine"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Firefighter"/>
        <rdfs:comment xml:lang="en">Inverse relation indicating movement or progression directed toward a referenced location or asset.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of advancing toward</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectedBy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment>Indicates infrastructure threatened by wildfire.</rdfs:comment>
        <rdfs:label>affected by wildfire</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectedByAsh -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectedByAsh">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AgriculturalProduce"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AshFall"/>
        <rdfs:comment xml:lang="en">Relates an AgriculturalProduce instance to one or more AshFall instances that affected it.</rdfs:comment>
        <rdfs:label xml:lang="en">affected by ash</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectedByAshOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectedByAshOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#affectedByAsh"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AshFall"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AgriculturalProduce"/>
        <rdfs:comment xml:lang="en">Inverse relation linking ash-related effects back to the sources or burned areas that produced them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of affected by ash</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectedOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectedOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#affectedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:comment>Inverse - Indicates infrastructure threatened by wildfire.</rdfs:comment>
        <rdfs:label>affected by wildfire of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affects -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affects">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Person"/>
        <rdfs:comment xml:lang="en">A general relation indicating influence or impact on another entity.</rdfs:comment>
        <rdfs:label>affects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsAnimal -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsAnimal">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#affectsAnimalOf"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Animal"/>
        <rdfs:comment>Indicates animals impacted by wildfire smoke.</rdfs:comment>
        <rdfs:label>affects animals or pets</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsAnimalOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsAnimalOf">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Animal"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment>Inverse - Indicates animals impacted by wildfire smoke.</rdfs:comment>
        <rdfs:label>affects animals or pets of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsAviationRoute -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsAviationRoute">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AviationRoute"/>
        <rdfs:comment xml:lang="en">Indicates that conditions or events interfere with or endanger aviation routes.</rdfs:comment>
        <rdfs:label>affects aviation route</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsAviationRouteOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsAviationRouteOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#affectsAviationRoute"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AviationRoute"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Links a smoke plume, Temporary Flight Restriction (TFR), or hazard back to the specific flight corridor it disrupts.</rdfs:comment>
        <rdfs:label xml:lang="en">affects aviation route of</rdfs:label>
        <rdfs:label>affects aviation route of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsClimatePattern -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsClimatePattern">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isAffectedByAnomaly"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ClimateAnomaly"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireRegime"/>
        <rdfs:comment xml:lang="en">Relates a large-scale environmental event or continuous emission to its altering effect on long-term weather and atmospheric trends.</rdfs:comment>
        <rdfs:label xml:lang="en">affects climate pattern</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsEcosystem -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsEcosystem">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.org/ffonto#hasVegetation"/>
            <rdf:Description rdf:about="http://purl.org/ffonto#influencedBy"/>
        </owl:propertyChainAxiom>
        <rdfs:comment>Indicates that a fire event affects an ecosystem through vegetation relationships.</rdfs:comment>
        <rdfs:label>affects ecosystem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsEcosystemOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsEcosystemOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#affectsEcosystem"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking ecosystem impacts back to the causal event or agent.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of affects ecosystem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsForestArea -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsForestArea">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestDisturbance"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment xml:lang="en">Indicates that an event, phenomenon, or policy impacts a specific wooded geographic region.</rdfs:comment>
        <rdfs:label xml:lang="en">affects forest area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsForestAreaOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsForestAreaOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#affectsForestArea"/>
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestDisturbance"/>
        <rdfs:comment xml:lang="en">Indicates that an event or policy impacts a specific wooded region belonging to a broader geographic or administrative boundary.</rdfs:comment>
        <rdfs:label xml:lang="en">affects forest area of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsGroundwaterRecharge -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsGroundwaterRecharge">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Groundwater"/>
        <rdfs:comment>Indicates that a wildfire influences groundwater recharge rates by altering soil permeability and vegetation cover.</rdfs:comment>
        <rdfs:label>affects groundwater recharge</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsGroundwaterRechargeOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsGroundwaterRechargeOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#affectsGroundwaterRecharge"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Groundwater"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment>Inverse - Indicates that a wildfire influences groundwater recharge rates by altering soil permeability and vegetation cover.</rdfs:comment>
        <rdfs:label>affects groundwater recharge of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsHabitat -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsHabitat">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#EcologicalEffect"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#HabitatType"/>
        <rdfs:comment>Indicates that an ecological effect alters wildlife habitat type (mature forest, shrub land, grass land).</rdfs:comment>
        <rdfs:label>affects habitat</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsHabitatOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsHabitatOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#affectsHabitat"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#HabitatType"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EcologicalEffect"/>
        <rdfs:comment xml:lang="en">Inverse relation linking habitat effects back to the driving event or condition.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of affects habitat</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsHealth -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsHealth">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AirPollutantProperty"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#RespiratoryIssue"/>
        <rdfs:comment xml:lang="en">Indicates that an environmental condition, event, or pollutant has a measurable impact on the physical well-being of a population.</rdfs:comment>
        <rdfs:label xml:lang="en">affects health</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsHealthCondition -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsHealthCondition">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#healthAffectedByPM25"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ParticulateMatterPM25"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#RespiratoryDisease"/>
        <rdfs:comment xml:lang="en">Links an environmental hazard, like smoke or extreme heat, to its impact on a specific pre-existing medical issue or physiological state.</rdfs:comment>
        <rdfs:label xml:lang="en">affects health condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsHealthOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsHealthOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#affectsHealth"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#RespiratoryIssue"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AirPollutantProperty"/>
        <rdfs:comment xml:lang="en">Indicates the specific population, individual, or demographic whose medical well-being is impacted by a hazard.</rdfs:comment>
        <rdfs:label xml:lang="en">affects health of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#affects"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Person"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:comment xml:lang="en">Inverse relation indicating what entities or systems are affected by a given cause.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of affects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#affectsPopulation -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#affectsPopulation">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#exposedToSmoke"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#HealthRisk"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#PopulationGroup"/>
        <rdfs:comment xml:lang="en">Original property (exists in your ontology). Declared inverseOf :exposedToSmoke.</rdfs:comment>
        <rdfs:comment>Indicates that a health risk affects a specific population group.</rdfs:comment>
