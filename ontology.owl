        <rdfs:label>has impact hazard</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasInfluenced -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasInfluenced">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isInfluencedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ClimateDriver"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment>Inverse - Indicates climatic or environmental conditions contributing to ignition/spread.</rdfs:comment>
        <rdfs:label>has influenced by climate/environmental driver</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasLabelAssignment -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasLabelAssignment">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ImageObservation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#LabelAssignment"/>
