        <rdfs:label>Evacuation Route</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EvacuationRoutingAlgorithm -->


    <owl:Class rdf:about="http://purl.org/ffonto#EvacuationRoutingAlgorithm">
        <rdfs:comment xml:lang="en">An algorithm that computes recommended evacuation paths given constraints and hazards.</rdfs:comment>
        <rdfs:label>Evacuation Routing Algorithm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EvacuationShelter -->


    <owl:Class rdf:about="http://purl.org/ffonto#EvacuationShelter">
        <rdfs:comment>Temporary housing (friend/relative, public shelter) information and rules (pet policies).</rdfs:comment>
        <rdfs:label>Evacuation Shelter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EvacuationStatus -->


    <owl:Class rdf:about="http://purl.org/ffonto#EvacuationStatus">
        <rdfs:comment>Status of evacuation routes or decisions during wildfire emergencies.</rdfs:comment>
        <rdfs:label>Evacuation Status</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EvacuationZone -->


    <owl:Class rdf:about="http://purl.org/ffonto#EvacuationZone">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment xml:lang="en">A geographic area designated for evacuation procedures during an emergency.</rdfs:comment>
        <rdfs:label>Evacuation Zone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EvaluationMetric -->


    <owl:Class rdf:about="http://purl.org/ffonto#EvaluationMetric">
        <rdfs:comment xml:lang="en">A quantitative measure used to assess model or system performance.</rdfs:comment>
        <rdfs:label>Evaluation Metric</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Evapotranspiration -->


    <owl:Class rdf:about="http://purl.org/ffonto#Evapotranspiration">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#MeteorologicalObservation"/>
