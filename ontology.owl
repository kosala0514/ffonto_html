        <rdfs:label>Spontaneous Combustion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SpotFire -->


    <owl:Class rdf:about="http://purl.org/ffonto#SpotFire">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireFront"/>
