        <rdfs:label xml:lang="en">inverse of threatened by hazard</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#threatens -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#threatens">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/ffonto#Animal"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#Infrastructure"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#Person"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#StructureFire"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Who/what is threatened by a given hazard.</rdfs:comment>
        <rdfs:label>threatens</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#threatensCommunity -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#threatensCommunity">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Community"/>
        <rdfs:comment xml:lang="en">Indicates that a hazard or event poses risk to a specific community.</rdfs:comment>
        <rdfs:label>threatens community</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#threatensCommunityOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#threatensCommunityOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#threatensCommunity"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Community"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking threats back to the communities that are endangered.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of threatens community</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#threatensFarmland -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#threatensFarmland">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Farmland"/>
        <rdfs:comment xml:lang="en">Indicates that a hazard or event poses risk to agricultural lands and production.</rdfs:comment>
        <rdfs:label>threatens farmland</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#threatensFarmlandOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#threatensFarmlandOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#threatensFarmland"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Farmland"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking threats to farmland back to the hazards or events responsible.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of threatens farmland</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#threatensInfrastructure -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#threatensInfrastructure">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:comment xml:lang="en">Indicates that a hazard or event poses risk to built infrastructure.</rdfs:comment>
        <rdfs:label>threatens infrastructure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#threatensInfrastructureOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#threatensInfrastructureOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#threatensInfrastructure"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking infrastructure threats back to the hazards or events that cause them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of threatens infrastructure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#threatensOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#threatensOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#threatens"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/ffonto#Animal"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#Infrastructure"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#Person"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#StructureFire"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:comment>Inverse - Who/what is threatened by a given hazard.</rdfs:comment>
        <rdfs:label>threatens of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#toolInUse -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#toolInUse">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Tool"/>
        <rdfs:comment xml:lang="en">Denotes that a specific tool is currently being employed in an operation.</rdfs:comment>
        <rdfs:label>tool in use</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#toolInUseOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#toolInUseOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#toolInUse"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Tool"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
