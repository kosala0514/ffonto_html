        <usesProtectionMethod rdf:resource="http://purl.org/ffonto#TurnOffPropane"/>
        <usesProtectionMethod rdf:resource="http://purl.org/ffonto#WetRoofAction"/>
        <rdfs:comment>Seal vents, turn off propane tanks, remove combustibles within 10-30 feet, connect hoses, wet roof if possible, place lawn sprinklers on roof if safe, gather fire tools.</rdfs:comment>
        <rdfs:label>Exterior Home Prep</rdfs:label>
    </owl:NamedIndividual>
    


