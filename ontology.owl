        <rdfs:label>increases erosion risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#increasesErosionRiskOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#increasesErosionRiskOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#increasesErosionRisk"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ErosionRisk"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment>Inverse - Indicates that a fire event elevates post-fire erosion risk.</rdfs:comment>
        <rdfs:label>increases erosion risk of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#increasesFireRisk -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#increasesFireRisk">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SpatialUnit"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFireRisk"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.org/ffonto#hasVegetationDistribution"/>
            <rdf:Description rdf:about="http://purl.org/ffonto#hasFuelLoad"/>
        </owl:propertyChainAxiom>
        <rdfs:comment>Indicates that an environmental factor increases wildfire risk through vegetation distribution and fuel load.</rdfs:comment>
        <rdfs:label>increases fire risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#increasesFireRiskOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#increasesFireRiskOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#increasesFireRisk"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFireRisk"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#SpatialUnit"/>
        <rdfs:comment xml:lang="en">Inverse relation indicating that an entity increases fire risk for a particular target.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of increases fire risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#increasesHumanAccess -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#increasesHumanAccess">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:comment>Indicates that infrastructure increases human access to ecosystems.</rdfs:comment>
        <rdfs:label>increases human access</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#increasesHumanAccessOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#increasesHumanAccessOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#increasesHumanAccess"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:comment xml:lang="en">Inverse relation linking factors that increase human access back to the areas or resources affected.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of increases human access</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#increasesRunoff -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#increasesRunoff">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Runoff"/>
        <rdfs:comment>Indicates that a wildfire increases surface water runoff due to reduced vegetation and altered soil conditions.</rdfs:comment>
        <rdfs:label>increases runoff</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#increasesRunoffOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#increasesRunoffOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#increasesRunoff"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Runoff"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking increased runoff observations back to the landscape changes or events causing them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of increases runoff</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#increasesWildfireRisk -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#increasesWildfireRisk">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFireRiskFactor"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireBehavior"/>
