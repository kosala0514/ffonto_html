        <rdfs:label>active fire suppression occurring</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#activeFlamesPresent -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#activeFlamesPresent">
