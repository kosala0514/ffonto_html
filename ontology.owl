        <rdfs:label xml:lang="en">collected by satellite</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#collectsEnvironmentalData -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#collectsEnvironmentalData">
        <rdfs:comment xml:lang="en">Indicates that an entity, such as a sensor platform or UAV, gathers data regarding environmental conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">collects environmental data</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#collectsSatelliteData -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#collectsSatelliteData">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#EarthObservationPlatform"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#SatelliteData"/>
