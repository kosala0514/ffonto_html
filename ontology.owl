    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="http://purl.org/ffonto#Animal">
        <rdfs:comment>Domestic animals or pets potentially affected by wildfire smoke.</rdfs:comment>
        <rdfs:label>Animal</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#DataAugmentation">
        <rdfs:comment xml:lang="en">Techniques to increase training data diversity by transforming existing examples.</rdfs:comment>
        <rdfs:label>Data Augmentation</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#F1Score">
        <rdfs:comment xml:lang="en">The harmonic mean of precision and recall, used as a performance metric for classification.</rdfs:comment>
        <rdfs:label>F1 Score</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#FWI">
        <resolution>0.1 degree global resolution</resolution>
        <rdfs:comment>Fire Weather Index.</rdfs:comment>
        <rdfs:comment>Meteorological index estimating fire danger based on weather conditions.</rdfs:comment>
        <rdfs:label>FWI</rdfs:label>
        <rdfs:label>Fire Weather Index (FWI)</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#FineFuel">
        <rdfs:comment>Fast-drying, fast-burning materials like grass, leaves, and needles that ignite easily.</rdfs:comment>
        <rdfs:label>Fine Fuel</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#FireEngine">
        <rdfs:comment>Emergency vehicle used by firefighters to combat fires and protect structures.</rdfs:comment>
        <rdfs:comment>Ground vehicle used for transporting firefighters and equipment.</rdfs:comment>
        <rdfs:label>Fire Engine</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#Firebreak">
        <rdfs:comment>A gap in vegetation used to stop or slow fire spread.</rdfs:comment>
        <rdfs:comment>Cleared strips of land used to stop or slow wildfire spread.</rdfs:comment>
        <rdfs:label>Firebreak</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#Grass">
        <rdfs:comment>Herbaceous vegetation characterized by narrow leaves and soft stems, commonly forming ground cover in forest and grassland ecosystems.</rdfs:comment>
        <rdfs:label>Grass</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#HeavyFuel">
        <rdfs:comment>Large woody materials like logs and branches that burn longer and produce high heat intensity.</rdfs:comment>
        <rdfs:label>Heavy Fuel</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#Helicopter">
        <rdfs:comment>Aircraft used to drop water or fire retardant in remote areas.</rdfs:comment>
        <rdfs:label>Firefighting Helicopter</rdfs:label>
        <rdfs:label>Helicopter</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#HotspotLocalization">
        <rdfs:comment xml:lang="en">Determining the geographic location of thermal anomalies indicating active fire or heat sources.</rdfs:comment>
        <rdfs:label>Hotspot Localization</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#NDVI">
        <rdfs:comment xml:lang="en">Normalized Difference Vegetation Index; a satellite-derived index indicating vegetation greenness.</rdfs:comment>
        <rdfs:label>Normalized Difference Vegetation Index (NDVI)</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#NaturalFeature">
        <rdfs:comment xml:lang="en">A naturally occurring geographic or environmental element such as forests, rivers, mountains, or vegetation.</rdfs:comment>
        <rdfs:label xml:lang="en">Natural feature</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#Person">
        <rdfs:comment xml:lang="en">A human individual; used to represent people in data and processes.</rdfs:comment>
        <rdfs:label>Person</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#Precision">
        <rdfs:comment xml:lang="en">A measure of the proportion of true positive results among positive predictions.</rdfs:comment>
        <rdfs:label>Precision</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#PublicAlert">
        <rdfs:comment xml:lang="en">A notification issued to inform the public about an emergency or required action.</rdfs:comment>
        <rdfs:label>Public Alert / Warning</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/ffonto#RadioComms">
        <rdfs:comment xml:lang="en">Two-way communication using radio frequencies for coordination and information exchange.</rdfs:comment>
