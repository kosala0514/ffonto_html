    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasPreparednessPlan">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#EvacuationZone"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ReadySetGoPlan"/>
        <rdfs:comment xml:lang="en">Links a community, organization, or facility to its documented strategy for anticipating and responding to emergencies.</rdfs:comment>
        <rdfs:label xml:lang="en">has preparedness plan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasPreventionMethod -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasPreventionMethod">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#PreventionMethod"/>
        <rdfs:comment>Links wildfire management strategies to prevention methods.</rdfs:comment>
        <rdfs:label>has prevention method</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasProtectionMeasure -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasProtectionMeasure">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ProtectionMeasure"/>
        <rdfs:comment xml:lang="en">Associates an entity with a specific mitigation or protective action.</rdfs:comment>
        <rdfs:label>has protection measure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasProvenanceRecord -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasProvenanceRecord">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ProvenanceRecord"/>
        <rdfs:comment xml:lang="en">Links a dataset, physical sample, or analytical conclusion to the detailed historical log of its origin and chain of custody.</rdfs:comment>
        <rdfs:label xml:lang="en">has provenance record</rdfs:label>
        <rdfs:label>has provenance record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasRateOfSpread -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasRateOfSpread">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireFront"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#RateOfSpread"/>
        <rdfs:comment xml:lang="en">Relates a fire incident or moving phenomenon to the quantitative metric describing its speed of expansion.</rdfs:comment>
        <rdfs:label xml:lang="en">has rate of spread</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasRecoveryGuideline -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasRecoveryGuideline">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WildfireScene"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#RecoveryGuideline"/>
        <rdfs:comment>Links wildfire scenes with recovery guidelines.</rdfs:comment>
        <rdfs:label>has recovery guideline</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasRehabArea -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasRehabArea">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WildfireScene"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#RehabArea"/>
        <rdfs:comment>Indicates a firefighter rest area at the wildfire scene.</rdfs:comment>
        <rdfs:label>has rehab area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasRequiredItem -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasRequiredItem">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#PreparednessKit"/>
