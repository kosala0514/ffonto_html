        <rdfs:label>Evapotranspiration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ExplainableAI -->


    <owl:Class rdf:about="http://purl.org/ffonto#ExplainableAI">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AIModelGovernance"/>
