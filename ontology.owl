    </owl:Class>
    


    <!-- http://purl.org/ffonto#UAV -->


    <owl:Class rdf:about="http://purl.org/ffonto#UAV">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SensorPlatform"/>
        <rdfs:comment xml:lang="en">An aircraft without a human pilot used for aerial wildfire monitoring and data collection.</rdfs:comment>
        <rdfs:label xml:lang="en">Unmanned Aerial Vehicle</rdfs:label>
        <rdfs:label xml:lang="en">Unmanned aerial vehicle</rdfs:label>
        <rdfs:label>Uncrewed Aerial Vehicle (UAV) / Drone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#UAVOperation -->


    <owl:Class rdf:about="http://purl.org/ffonto#UAVOperation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">A planned flight or deployment of an Unmanned Aerial Vehicle (UAV) for observation, communication, or mitigation.</rdfs:comment>
        <rdfs:label xml:lang="en">UAV operation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Understory -->


    <owl:Class rdf:about="http://purl.org/ffonto#Understory">
        <rdfs:comment>Shrub and herbaceous vegetation and litter layer beneath the forest canopy; important as surface fuel.</rdfs:comment>
        <rdfs:label>Understory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#UrbanDevelopment -->


    <owl:Class rdf:about="http://purl.org/ffonto#UrbanDevelopment">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EnvironmentalFactor"/>
        <rdfs:comment>Human settlements near forests increasing ignition risk.</rdfs:comment>
