        <rdfs:label xml:lang="en">has record confidence</rdfs:label>
        <rdfs:label>record confidence</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasRecoveryTimeYears -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasRecoveryTimeYears">
