    </owl:Class>
    


    <!-- http://purl.org/ffonto#SpottingEvent -->


    <owl:Class rdf:about="http://purl.org/ffonto#SpottingEvent">
        <rdfs:comment>Transport of embers causing spot fires ahead of main front.</rdfs:comment>
        <rdfs:label>Spotting / Ember Cast Event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Spruce -->


    <owl:Class rdf:about="http://purl.org/ffonto#Spruce">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ConiferousTree"/>
        <rdfs:comment>A coniferous tree species belonging to the genus Picea commonly found in cold forest ecosystems.</rdfs:comment>
        <rdfs:label>Spruce tree</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Stream -->


