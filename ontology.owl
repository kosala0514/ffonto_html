    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#predictsSmokePlumeOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#predictsSmokePlumeOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#predictsSmokePlume"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SmokePlume"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#SmokeDispersionModel"/>
        <rdfs:comment xml:lang="en">Connects a computational model or forecast to the specific wildfire whose particulate emissions and dispersion it estimates.</rdfs:comment>
        <rdfs:label xml:lang="en">predicts smoke plume of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#preparedForZone -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#preparedForZone">
