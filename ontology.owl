    <!-- http://purl.org/ffonto#causesSymptomOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#causesSymptomOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#causesSymptom"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#HealthSymptom"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#HealthRisk"/>
        <rdfs:comment>Inverse - Links smoke exposure to resulting symptoms.</rdfs:comment>
        <rdfs:label>causes symptom of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#characterizesRegion -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#characterizesRegion">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasFireRegime"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireRegime"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment xml:lang="en">Relates a demographic statistic, environmental baseline, or climate regime to the specific geographic area it describes.</rdfs:comment>
        <rdfs:label xml:lang="en">characterizes region</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#chemicalComponentAffectsCombustion -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#chemicalComponentAffectsCombustion">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isCombustionAffectedByChemicalComponent"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#VegetationChemicalComponent"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#CombustionProcess"/>
