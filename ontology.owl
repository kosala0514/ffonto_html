        <rdfs:label xml:lang="en">integrates data</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#involvesFirefighter -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#involvesFirefighter">
