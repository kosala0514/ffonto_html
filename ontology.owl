        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Links a handcrew, engine module, or suppression team to the incident, division, or agency they are assigned to.</rdfs:comment>
        <rdfs:label xml:lang="en">is ground crew of</rdfs:label>
