    <!-- http://purl.org/ffonto#TreeRegeneration -->


    <owl:Class rdf:about="http://purl.org/ffonto#TreeRegeneration">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EcologicalImpact"/>
