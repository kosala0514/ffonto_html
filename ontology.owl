        <rdfs:label>Evacuation Procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EvacuationRoute -->


    <owl:Class rdf:about="http://purl.org/ffonto#EvacuationRoute">
