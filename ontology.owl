        <rdfs:range rdf:resource="http://purl.org/ffonto#WeatherCondition"/>
        <rdfs:comment>Indicates wildfire risk influenced by weather variability.</rdfs:comment>
        <rdfs:label>influenced by weather</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#influencedByWeatherOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#influencedByWeatherOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#influencedByWeather"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WeatherCondition"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFireRisk"/>
        <rdfs:comment>Indicates wildfire risk influenced by weather variability.</rdfs:comment>
        <rdfs:label>influenced by weather</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#influencedOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#influencedOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#influencedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#EnvironmentalCondition"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireBehavior"/>
        <rdfs:comment>Inverse - Indicates environmental conditions that affect the behavior of a fire event.</rdfs:comment>
        <rdfs:label>influenced of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#influencesFireBehavior -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#influencesFireBehavior">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isFireBehaviorInfluencedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ClimatePattern"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
