        <rdfs:label xml:lang="en">audio model</rdfs:label>
        <rdfs:label>audio model</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#audioThreshold -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#audioThreshold">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AudioObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Defines the acoustic decibel limit or anomaly score required for a sound-based sensor to trigger an alert.</rdfs:comment>
        <rdfs:label xml:lang="en">audio threshold</rdfs:label>
        <rdfs:label>audio threshold</rdfs:label>
    </owl:DatatypeProperty>
    


