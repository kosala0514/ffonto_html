    <!-- http://purl.org/ffonto#PhysicalImpact -->


    <owl:Class rdf:about="http://purl.org/ffonto#PhysicalImpact">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EcologicalEffect"/>
