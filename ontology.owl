        <rdfs:label>Optical Scattering</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#OutdoorItems -->


    <owl:Class rdf:about="http://purl.org/ffonto#OutdoorItems">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Infrastructure"/>
