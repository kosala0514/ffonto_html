    </owl:Class>
    


    <!-- http://purl.org/ffonto#NutrientCycling -->


    <owl:Class rdf:about="http://purl.org/ffonto#NutrientCycling">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SupportingService"/>
