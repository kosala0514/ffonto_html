    <!-- http://purl.org/ffonto#hasLocation -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasLocation">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SpatialEntity"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:comment>Indicates the place where a spatial entity is located.</rdfs:comment>
        <rdfs:label>located at</rdfs:label>
    </owl:ObjectProperty>
    


