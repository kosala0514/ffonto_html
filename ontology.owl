        <rdfs:comment xml:lang="en">A developmental condition affecting the nervous system and cognitive or motor function.</rdfs:comment>
        <rdfs:label>Neurodevelopmental Impact</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#NightConditions -->


    <owl:Class rdf:about="http://purl.org/ffonto#NightConditions">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EnvironmentalFactor"/>
