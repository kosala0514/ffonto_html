        <rdfs:label>area (acres)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#areaHa -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#areaHa">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WeatherObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Records the calculated spatial extent or geographic footprint of an entity or incident, measured in hectares.</rdfs:comment>
        <rdfs:label xml:lang="en">area ha</rdfs:label>
        <rdfs:label>area ha</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#ashAccumulationOnRoofOrDeck -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#ashAccumulationOnRoofOrDeck">
