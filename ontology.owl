        <rdfs:label>communicates by network</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#communicatesVia -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#communicatesVia">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#CommunicationNetwork"/>
        <rdfs:comment xml:lang="en">Specifies the medium or channel through which communication occurs.</rdfs:comment>
        <rdfs:label>communicates via network</rdfs:label>
