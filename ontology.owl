        <rdfs:domain rdf:resource="http://purl.org/ffonto#SpatialExtent"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#GridLocation"/>
        <rdfs:comment xml:lang="en">Provides a grid-based coordinate location for spatial referencing.</rdfs:comment>
        <rdfs:label>has grid location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasGroundCrew -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasGroundCrew">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#GroundCrew"/>
        <rdfs:comment xml:lang="en">Associates an incident or operation with assigned ground-based personnel.</rdfs:comment>
        <rdfs:label>has ground firefighting crew</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasGroundVisibility -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasGroundVisibility">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#GroundVisibility"/>
        <rdfs:comment>Visibility condition for ground crews and public roads.</rdfs:comment>
        <rdfs:label>has ground visibility</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasHazard -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasHazard">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/ffonto#ForestFire"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#Road"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#WildfireScene"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:comment>Indicates hazards affecting roads or wildfire scenes.</rdfs:comment>
        <rdfs:label>has hazard</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasHealthAffects -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasHealthAffects">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#SmokeHealthEffect"/>
        <rdfs:comment xml:lang="en">Relates an entity to health impacts or effects on people or animals.</rdfs:comment>
        <rdfs:label>affects (health/eco)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasICSFunction -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasICSFunction">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#IncidentCommandSystem"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ICSFunction"/>
        <rdfs:comment xml:lang="en">Denotes assignment to an Incident Command System functional role (e.g., operations, planning).</rdfs:comment>
        <rdfs:label>has ICS function</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasIgnitionCause -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasIgnitionCause">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#IgnitionCause"/>
        <rdfs:comment>Links a wildfire to its originating cause(s).</rdfs:comment>
        <rdfs:label>has ignition cause</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasIgnitionSource -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasIgnitionSource">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#IgnitionSource"/>
        <rdfs:comment>Causes or source of ignition for a fire event.</rdfs:comment>
        <rdfs:label>has ignition source</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasImageAsset -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasImageAsset">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ImageObservation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ImageAsset"/>
        <rdfs:comment>Relates an image-based observation to the actual digital or physical image file/asset.</rdfs:comment>
        <rdfs:label>has image asset</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasImageContribution -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasImageContribution">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WildfireIncident"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ImageContribution"/>
        <rdfs:comment xml:lang="en">Links a dataset, report, or analytical model to a specific photograph, satellite image, or visual data input that enhances it.</rdfs:comment>
        <rdfs:label xml:lang="en">has image contribution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasImageQualityMeta -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasImageQualityMeta">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ImageAsset"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ImageQualityMetadata"/>
        <rdfs:comment>Links an image to its quality/metadata record.</rdfs:comment>
        <rdfs:label>has image quality metadata</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasImageQualityMetaInverse -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasImageQualityMetaInverse">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasImageQualityMeta"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ImageQualityMetadata"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ImageAsset"/>
        <rdfs:comment xml:lang="en">Inverse relation linking image quality metadata back to the image asset described.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of has image quality meta</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasImpactHazard -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasImpactHazard">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#DropZone"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ImpactHazard"/>
