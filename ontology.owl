        <rdfs:label>Plant Flammability Trait</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#PlantSpecies -->


    <owl:Class rdf:about="http://purl.org/ffonto#PlantSpecies">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Plant"/>
        <rdfs:comment>Specific biological taxa that respond to fire.</rdfs:comment>
        <rdfs:label>Plant Species</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#PoliceCar -->


