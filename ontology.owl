        <rdfs:label>annotation source</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#applyingWaterToFlames -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#applyingWaterToFlames">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FirefightingOperation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates water being applied directly to flames.</rdfs:comment>
        <rdfs:label>applying water to flames</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#areaAcres -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#areaAcres">
