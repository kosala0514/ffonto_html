        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestTerrain"/>
        <rdfs:comment>Specifies the terrain where wildfire is occurring.</rdfs:comment>
