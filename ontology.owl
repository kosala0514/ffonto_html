        <rdfs:label>supports ecosystem health</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#supportsEcosystemHealthOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#supportsEcosystemHealthOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#supportsEcosystemHealth"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#EcosystemService"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WaterBody"/>
        <rdfs:comment>Inverse - Indicates that a feature such as a water body contributes to ecosystem services.</rdfs:comment>
        <rdfs:label>supports ecosystem health of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#suppresses -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#suppresses">
