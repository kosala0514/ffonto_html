        <rdfs:label>Personal Protective Equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#PSPS -->


    <owl:Class rdf:about="http://purl.org/ffonto#PSPS">
        <rdfs:comment>Preemptive de-energization to reduce utility-caused ignitions.</rdfs:comment>
        <rdfs:label>Planned Power Shutoff (PSPS)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ParticleSize -->


    <owl:Class rdf:about="http://purl.org/ffonto#ParticleSize">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AirPollutantProperty"/>
        <rdfs:comment>Diameter of particulate matter in smoke, often measured in micrometers.</rdfs:comment>
        <rdfs:label>Particle Size</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ParticulateMatter -->


