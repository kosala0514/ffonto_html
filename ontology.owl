        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking habitat loss events back to the causing agent or disturbance.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of causes habitat loss</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#causesHealthEffect -->


