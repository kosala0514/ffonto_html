    </owl:Class>
    


    <!-- http://purl.org/ffonto#Moss -->


    <owl:Class rdf:about="http://purl.org/ffonto#Moss">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Vegetation"/>
        <rdfs:comment>Small non-vascular plants commonly found in moist or nutrient-poor environments.</rdfs:comment>
        <rdfs:label>Moss</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#MountainSlope -->


    <owl:Class rdf:about="http://purl.org/ffonto#MountainSlope">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#TerrainFeature"/>
        <rdfs:comment xml:lang="en">The inclined surface of mountainous terrain, often affecting water flow and fire behavior.</rdfs:comment>
        <rdfs:label>Mountain Slope</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#MultimodalDataFusion -->


    <owl:Class rdf:about="http://purl.org/ffonto#MultimodalDataFusion">
        <rdfs:comment xml:lang="en">Combining data from different modalities (e.g., imagery, audio, text) to improve analysis.</rdfs:comment>
        <rdfs:label>Multimodal Data Fusion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#NDVI -->


    <owl:Class rdf:about="http://purl.org/ffonto#NDVI">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#VegetationIndex"/>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#NaturalBarrier -->


    <owl:Class rdf:about="http://purl.org/ffonto#NaturalBarrier">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EnvironmentalFactor"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Topography"/>
        <rdfs:comment>Natural features such as rivers or lakes that slow fire spread.</rdfs:comment>
        <rdfs:label>Natural Barrier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#NaturalCause -->


    <owl:Class rdf:about="http://purl.org/ffonto#NaturalCause">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ForestFireCause"/>
        <rdfs:comment xml:lang="en">An event or condition originating from natural processes rather than human action.</rdfs:comment>
        <rdfs:label>Natural ForestFire Cause</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#NaturalFirebreak -->


    <owl:Class rdf:about="http://purl.org/ffonto#NaturalFirebreak">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment>Landscape features (rivers, wetlands, snowfields) that reduce fire spread risk.</rdfs:comment>
        <rdfs:label>Natural Firebreak</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#NaturalFireline -->


    <owl:Class rdf:about="http://purl.org/ffonto#NaturalFireline">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Fireline"/>
        <rdfs:comment xml:lang="en">A physical landscape feature that acts as a natural barrier to fire spread.</rdfs:comment>
        <rdfs:label>Natural Fireline</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#NaturalIgnition -->


    <owl:Class rdf:about="http://purl.org/ffonto#NaturalIgnition">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#IgnitionCause"/>
