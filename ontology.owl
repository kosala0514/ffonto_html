        <rdfs:domain rdf:resource="http://purl.org/ffonto#Disturbance"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#VegetationCondition"/>
        <rdfs:comment xml:lang="en">Inverse relation linking observed outcomes back to the disturbances that caused them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of caused by disturbance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#causedByEmbers -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#causedByEmbers">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#createsSpotFire"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SpotFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#CombustionProcess"/>
        <rdfs:comment xml:lang="en">Indicates that a secondary fire or ignition was started by airborne burning debris (embers).</rdfs:comment>
        <rdfs:label xml:lang="en">caused by embers</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#causedByPollutant -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#causedByPollutant">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#causesDisease"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#RespiratoryDisease"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AirPollutantProperty"/>
        <rdfs:comment xml:lang="en">Indicates that a health impact, environmental degradation, or degraded visibility condition is the direct result of a specific contaminant.</rdfs:comment>
        <rdfs:label xml:lang="en">caused by pollutant</rdfs:label>
    </owl:ObjectProperty>
    


