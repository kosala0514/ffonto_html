        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Whether ash accumulation is visible on roofs, decks, or other surfaces.</rdfs:comment>
        <rdfs:label>ash accumulation on roofs or decks</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#ashColorDominance -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#ashColorDominance">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#BurnEvidence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Dominant ash color observed: &apos;white&apos;, &apos;gray&apos;, or &apos;black&apos;.</rdfs:comment>
        <rdfs:label>ash color dominance</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#ashContaminationLevel -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#ashContaminationLevel">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AgriculturalProduce"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A human-readable or coded value describing the level of ash contamination (e.g. &apos;low&apos;, &apos;moderate&apos;, &apos;high&apos;, or measurement notes).</rdfs:comment>
        <rdfs:label xml:lang="en">ash contamination level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#ashDepositsVisible -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#ashDepositsVisible">
