        <rdfs:label>Firearms and Explosive Use</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Firebreak -->


    <owl:Class rdf:about="http://purl.org/ffonto#Firebreak">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireManagementStrategy"/>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Firefighter -->


    <owl:Class rdf:about="http://purl.org/ffonto#Firefighter">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Responder"/>
