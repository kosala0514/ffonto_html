        <rdfs:comment>Processes and outputs used to evaluate wildfire likelihood and consequences.</rdfs:comment>
        <rdfs:label>Fire Risk Assessment</rdfs:label>
        <rdfs:label>ForestFire Risk Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireRiskMap -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireRiskMap">
        <rdfs:comment>A map showing wildfire risk levels based on environmental and human factors.</rdfs:comment>
