        <rdfs:domain rdf:resource="http://purl.org/ffonto#SmokePlume"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireFront"/>
        <rdfs:comment xml:lang="en">Relates an emission, physical artifact (like ash), or environmental impact to the specific combustion event that created it.</rdfs:comment>
        <rdfs:label xml:lang="en">produced by fire</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#producedCaptionBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#producedCaptionBy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ImageAsset"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#CaptionModelOutput"/>
        <rdfs:comment>Links image to caption output (model &amp; caption text).</rdfs:comment>
        <rdfs:label>produced caption by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#producedInArea -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#producedInArea">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AgriculturalProduce"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Location"/>
        <rdfs:comment xml:lang="en">Relates an AgriculturalProduce instance to the Location in which it was produced.</rdfs:comment>
        <rdfs:label xml:lang="en">produced in area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#producedInAreaOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#producedInAreaOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#producedInArea"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Location"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AgriculturalProduce"/>
        <rdfs:comment xml:lang="en">Inverse relation linking produced materials or datasets back to the geographic area of production.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of produced in area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#produces -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#produces">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#producedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ModelExecution"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ModelOutput"/>
        <rdfs:comment xml:lang="en">A general relation indicating that an entity, event, or process generates a specific output, emission, or artifact.</rdfs:comment>
        <rdfs:label xml:lang="en">produces</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#producesAirPollution -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#producesAirPollution">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AirPollution"/>
        <rdfs:comment>Smoke and particulate emissions resulting from a fire event.</rdfs:comment>
        <rdfs:label>produces air pollution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#producesAirPollutionOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#producesAirPollutionOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#producesAirPollution"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AirPollution"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment>Inverse - Smoke and particulate emissions resulting from a fire event.</rdfs:comment>
        <rdfs:label>produces air pollution of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#producesCarbonEmission -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#producesCarbonEmission">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#CombustionProcess"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#CarbonEmission"/>
        <rdfs:comment xml:lang="en">Links a physical process or event, such as a wildfire combustion, to the greenhouse gases it releases.</rdfs:comment>
        <rdfs:label xml:lang="en">produces carbon emission</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#producesPollution -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#producesPollution">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WildfireSmoke"/>
        <rdfs:comment>Indicates that a wildfire produces wildfire smoke pollution.</rdfs:comment>
        <rdfs:label>produces pollution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#producesPollutionOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#producesPollutionOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#producesPollution"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WildfireSmoke"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking pollution production records back to the sources or activities responsible.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of produces pollution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#producesSmokePlume -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#producesSmokePlume">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireFront"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#SmokePlume"/>
        <rdfs:comment xml:lang="en">Links a combustion event, like a wildfire, to the visible, measurable column of smoke it generates.</rdfs:comment>
        <rdfs:label xml:lang="en">produces smoke plume</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#producesToxic -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#producesToxic">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Smoke"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AirToxic"/>
        <rdfs:comment>Indicates toxic pollutants produced during wildfire combustion.</rdfs:comment>
        <rdfs:label>produces toxic pollutant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#producesToxicOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#producesToxicOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#producesToxic"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AirToxic"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Smoke"/>
        <rdfs:comment xml:lang="en">Inverse relation linking production of toxic substances back to the generating process or event.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of produces toxic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#promotesRegeneration -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#promotesRegeneration">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestRegeneration"/>
        <rdfs:comment>Fire can stimulate forest regrowth.</rdfs:comment>
        <rdfs:label>promotes regeneration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#promotesRegenerationOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#promotesRegenerationOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#promotesRegeneration"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestRegeneration"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment>Inverse - Fire can stimulate forest regrowth.</rdfs:comment>
        <rdfs:label>promotes regeneration of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#protectedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#protectedBy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#PopulationGroup"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ProtectionMethod"/>
        <rdfs:comment>Indicates a protection method reduces smoke exposure.</rdfs:comment>
        <rdfs:label>protected by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#protectedOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#protectedOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#protectedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ProtectionMethod"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#PopulationGroup"/>
        <rdfs:comment xml:lang="en">Inverse relation linking protection status back to the assets or areas that are protected.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of protected by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#protectingAsset -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#protectingAsset">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Responder"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#StructureFire"/>
        <rdfs:comment>Indicates responders are protecting a particular structure/asset.</rdfs:comment>
        <rdfs:label>protecting asset</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#protectingAssetOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#protectingAssetOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#protectingAsset"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#StructureFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Responder"/>
        <rdfs:comment xml:lang="en">Inverse relation linking protection actions back to the assets being safeguarded.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of protecting asset</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#protectsAgainst -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#protectsAgainst">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isMitigatedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SafetyMeasure"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WildfireIncident"/>
        <rdfs:comment xml:lang="en">Indicates the specific hazard, threat, or condition that an entity, policy, or mitigation strategy defends against.</rdfs:comment>
        <rdfs:label xml:lang="en">protects against</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#protectsData -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#protectsData">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isProtectedByPrivacyPolicy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#PrivacyProtection"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#DataRepository"/>
        <rdfs:comment xml:lang="en">Indicates that a cybersecurity protocol, privacy policy, or governance framework secures a specific information asset.</rdfs:comment>
        <rdfs:label xml:lang="en">protects data</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#protectsStructure -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#protectsStructure">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Firefighter"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#House"/>
        <rdfs:comment>Indicates firefighters protecting a structure from fire.</rdfs:comment>
        <rdfs:label>firefighter protects structure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#protectsStructureOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#protectsStructureOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#protectsStructure"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#House"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Firefighter"/>
        <rdfs:comment xml:lang="en">Inverse relation linking structure protection measures back to the structures they protect.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of protects structure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#protectsSystem -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#protectsSystem">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isProtectedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#CyberSecurityPractice"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#KnowledgeGraph"/>
        <rdfs:comment xml:lang="en">Indicates that a mitigation strategy, policy, or device safeguards a technological or infrastructural system.</rdfs:comment>
        <rdfs:label xml:lang="en">protects system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providedBy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#HealthAdvice"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ResponseOrganization"/>
        <rdfs:comment>Indicates the organization providing health information.</rdfs:comment>
        <rdfs:label>provided by organization</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providedOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providedOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#providedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ResponseOrganization"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#HealthAdvice"/>
        <rdfs:comment xml:lang="en">Inverse relation linking provided services or resources back to the providers.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of provided by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providesCarbonStorage -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providesCarbonStorage">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Forest"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#CarbonSink"/>
        <rdfs:comment>Indicates that an ecosystem stores carbon and reduces atmospheric CO2.</rdfs:comment>
        <rdfs:label>provides carbon storage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providesCarbonStorageOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providesCarbonStorageOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#providesCarbonStorage"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#CarbonSink"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Forest"/>
        <rdfs:comment xml:lang="en">Inverse relation linking carbon storage services back to the ecosystems that provide them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of provides carbon storage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providesEcosystemService -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providesEcosystemService">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EcosystemService"/>
        <rdfs:comment>Relates ecosystems to the ecosystem services they provide.</rdfs:comment>
        <rdfs:label>provides ecosystem service</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providesEcosystemServiceOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providesEcosystemServiceOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#providesEcosystemService"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#EcosystemService"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:comment xml:lang="en">Inverse relation indicating that an entity supplies a particular ecosystem service to another.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of provides ecosystem service</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providesHabitat -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providesHabitat">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Habitat"/>
        <rdfs:comment>Relates vegetation or ecosystems to habitats available for wildlife.</rdfs:comment>
        <rdfs:label>provides habitat</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providesHabitatOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providesHabitatOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#providesHabitat"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Habitat"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:comment xml:lang="en">Inverse relation linking habitat provisions back to the ecosystems or areas providing them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of provides habitat</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providesImageFor -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providesImageFor">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasImageContribution"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ImageContribution"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WildfireIncident"/>
        <rdfs:comment xml:lang="en">Connects a camera, satellite, or visual dataset to the specific analysis, report, or system that utilizes its imagery.</rdfs:comment>
        <rdfs:label xml:lang="en">provides image for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providesInformation -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providesInformation">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#InformationResource"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#HealthRisk"/>
        <rdfs:comment xml:lang="en">Indicates that an entity offers data, guidance, or descriptive content.</rdfs:comment>
        <rdfs:label>provides information about health risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providesInformationOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providesInformationOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#providesInformation"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#HealthRisk"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#InformationResource"/>
        <rdfs:comment xml:lang="en">Inverse relation linking informational resources back to the topics or entities they describe.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of provides information</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providesProtectionFromSmoke -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providesProtectionFromSmoke">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isShelteredFrom"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#CleanAirShelter"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#SmokePlume"/>
        <rdfs:comment xml:lang="en">Indicates that a device, shelter, or policy shields individuals or equipment from the harmful effects of airborne particulate matter.</rdfs:comment>
        <rdfs:label xml:lang="en">provides protection from smoke</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providesResourcesFor -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providesResourcesFor">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasLogisticsSupport"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#LogisticsSection"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WildfireIncident"/>
        <rdfs:comment xml:lang="en">Links an organization, logistics hub, or mutual aid agreement to the specific incident or operation it supplies.</rdfs:comment>
        <rdfs:label xml:lang="en">provides resources for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providesService -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providesService">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/ffonto#Ecosystem"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#WaterBody"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EcosystemService"/>
        <rdfs:label>provides ecosystem service</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providesTrackingData -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providesTrackingData">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#receivesTrackingFrom"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ADSB"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AircraftTracking"/>
        <rdfs:comment xml:lang="en">Links a sensor, GPS device, or system to the continuous location and movement telemetry it generates.</rdfs:comment>
        <rdfs:label xml:lang="en">provides tracking data</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providesWater -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providesWater">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WaterSource"/>
        <rdfs:comment xml:lang="en">Indicates that a resource or infrastructure supplies water for consumption, firefighting, or ecological use.</rdfs:comment>
        <rdfs:label xml:lang="en">provides water</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#providesWaterOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#providesWaterOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#providesWater"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WaterSource"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:comment xml:lang="en">Inverse - Indicates that a resource or infrastructure supplies water for consumption, firefighting, or ecological use.</rdfs:comment>
        <rdfs:label xml:lang="en">provides water of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#quantifiesPrediction -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#quantifiesPrediction">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasPredictionUncertainty"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#PredictionUncertainty"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireBehaviorModel"/>
        <rdfs:comment xml:lang="en">Links a numerical metric or model output to the specific forecast or estimate it represents.</rdfs:comment>
        <rdfs:label xml:lang="en">quantifies prediction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#rateOfSpreadAffectedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#rateOfSpreadAffectedBy">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#affectsRateOfSpread"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#RateOfSpread"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#MeteorologicalObservation"/>
        <rdfs:label xml:lang="en">rate of spread affected by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#rateOfSpreadAffectedByMeteorologicalVariable -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#rateOfSpreadAffectedByMeteorologicalVariable">
        <rdfs:comment xml:lang="en">Relates the speed of fire growth to the specific weather conditions, such as wind or humidity, influencing its acceleration.</rdfs:comment>
        <rdfs:label xml:lang="en">rate of spread affected by meteorological variable</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#reachedAgriculturalLand -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#reachedAgriculturalLand">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AgriculturalLand"/>
        <rdfs:comment xml:lang="en">Indicates that fire or hazard has spread into agricultural areas.</rdfs:comment>
        <rdfs:label>reached agricultural land</rdfs:label>
