    <!-- http://purl.org/ffonto#triggeredByAirPollution -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#triggeredByAirPollution">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#causesCardiacIssue"/>
