        <rdfs:comment>Patio furniture, tools, trailers, etc., located outside buildings.</rdfs:comment>
        <rdfs:label>Outdoor Items</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Oxygen -->


    <owl:Class rdf:about="http://purl.org/ffonto#Oxygen">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireElement"/>
        <rdfs:comment>Oxidizing agent enabling combustion.</rdfs:comment>
        <rdfs:label>Oxygen</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#PPE -->


    <owl:Class rdf:about="http://purl.org/ffonto#PPE">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ProtectiveAction"/>
        <rdfs:comment>Protective equipment worn by firefighters during operations.</rdfs:comment>
