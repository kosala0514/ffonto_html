    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#causesDisease -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#causesDisease">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AirPollutantProperty"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#RespiratoryDisease"/>
        <rdfs:comment xml:lang="en">Indicates that an environmental hazard (like smoke inhalation) or event leads to specific health conditions or illnesses.</rdfs:comment>
        <rdfs:label xml:lang="en">causes disease</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#causesEcologicalImpact -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#causesEcologicalImpact">
