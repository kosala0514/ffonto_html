        <rdfs:label>Evacuation Preparation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EvacuationProcedure -->


    <owl:Class rdf:about="http://purl.org/ffonto#EvacuationProcedure">
