        <rdfs:range rdf:resource="http://purl.org/ffonto#FireRegime"/>
        <rdfs:comment xml:lang="en">Links a specific ecosystem or geographic region to its historical pattern of fire frequency, seasonality, and intensity.</rdfs:comment>
        <rdfs:label xml:lang="en">has fire regime</rdfs:label>
