        <rdfs:label xml:lang="en">is cloud cover processed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isClusterOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isClusterOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasCluster"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireCluster"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireSpread"/>
        <rdfs:comment xml:lang="en">Inverse relation linking cluster membership back to the cluster entity or grouping.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of is cluster</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isCombinedInForecast -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isCombinedInForecast">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireBehaviorModel"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EnsembleForecast"/>
