    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#retreatingDueToActivity">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Responder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates that personnel or resources are withdrawing because of hazardous activity.</rdfs:comment>
        <rdfs:label>retreating due to increased activity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#riparianPlantsScorched -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#riparianPlantsScorched">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Vegetation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether riparian vegetation appears scorched.</rdfs:comment>
        <rdfs:label>riparian plants scorched</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#riparianTreesScorched -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#riparianTreesScorched">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Vegetation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether riparian trees appear scorched but remain standing.</rdfs:comment>
        <rdfs:label>riparian trees scorched but standing</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#roadBlocked -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#roadBlocked">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates that a roadway is obstructed and not passable.</rdfs:comment>
        <rdfs:label>road blocked to public</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#roadBlockedByDebris -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#roadBlockedByDebris">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Roadway"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether the road is partially or fully blocked by debris or fallen trees.</rdfs:comment>
        <rdfs:label>road blocked by debris or fallen trees</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#roadClearOfDebris -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#roadClearOfDebris">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates that a road is free from obstructions and passable.</rdfs:comment>
        <rdfs:label>road clear of debris</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#roadClosureEnforceable -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#roadClosureEnforceable">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#PublicSafetyGuidance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether a road closure can be enforced by authorities.</rdfs:comment>
        <rdfs:label>are road closures enforceable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#roadClosureSignsVisible -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#roadClosureSignsVisible">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#TransportationInfrastructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether caution or closure signs are present.</rdfs:comment>
        <rdfs:label>road closure signs or barricades visible</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#roadNarrowOrSteep -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#roadNarrowOrSteep">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">A descriptor indicating that a road is constrained by narrow width or steep grade.</rdfs:comment>
        <rdfs:label>road narrow or steep</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#roadSignObscuredBySmoke -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#roadSignObscuredBySmoke">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates that road signage visibility is reduced due to smoke.</rdfs:comment>
        <rdfs:label>road signs obscured by smoke</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#roadSurface -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#roadSurface">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Values: &apos;paved&apos;, &apos;dirt&apos;, etc.</rdfs:comment>
        <rdfs:label>road surface type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#roadVisible -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#roadVisible">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates that a roadway is observable in imagery or reports.</rdfs:comment>
        <rdfs:label>road visible in scene</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#roadWidth -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#roadWidth">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#RoadAccess"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The measured width of a road, used for access and safety planning.</rdfs:comment>
        <rdfs:label>road width (m)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#roadwayScorched -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#roadwayScorched">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Roadway"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether sections of the roadway surface are visibly scorched.</rdfs:comment>
        <rdfs:label>roadway surface scorched</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#rocksHeatSpalled -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#rocksHeatSpalled">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#RockSurface"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether rocks show heat cracking or spalling.</rdfs:comment>
        <rdfs:label>rocks heat-spalled or cracked</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#roofCollapsed -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#roofCollapsed">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Roof"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether the roof of a building collapsed due to wildfire.</rdfs:comment>
        <rdfs:label>roof collapsed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#roofFreeOfDebris -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#roofFreeOfDebris">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether a roof is free of combustible debris.</rdfs:comment>
        <rdfs:label>roof free of debris</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#roofHasDebris -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#roofHasDebris">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Roof"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Specifies whether the roof contains leaves or debris that could ignite.</rdfs:comment>
        <rdfs:label>roof has debris</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#rootsExposed -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#rootsExposed">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Vegetation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether roots are exposed due to combustion or erosion.</rdfs:comment>
        <rdfs:label>roots exposed by combustion or erosion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#rowIndex -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#rowIndex">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WeatherObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Indicates the specific sequential line number or tabular position of a record within a dataset.</rdfs:comment>
        <rdfs:label xml:lang="en">row index</rdfs:label>
        <rdfs:label>rowI index</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#runoffIntensity -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#runoffIntensity">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Runoff"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Describes the intensity of surface runoff (e.g., low, moderate, high).</rdfs:comment>
        <rdfs:label>runoff intensity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#satelliteSmokeVisible -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#satelliteSmokeVisible">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SatelliteObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates today&apos;s satellite passes show the smoke plume.</rdfs:comment>
        <rdfs:label>smoke visible in satellite imagery</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#schemaVersion -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#schemaVersion">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Specifies the numeric or alphanumeric release identifier of the ontological or structural framework governing the dataset.</rdfs:comment>
        <rdfs:label xml:lang="en">schema version</rdfs:label>
        <rdfs:label>schema version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#schoolsCloseGuidance -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#schoolsCloseGuidance">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#PublicSafetyGuidance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Guidance on closure of educational institutions during hazardous events.</rdfs:comment>
        <rdfs:label>will schools close during severe smoke/fire</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#scoreFire -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#scoreFire">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#VisionModelScores"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Fire score from vision model (0-1).</rdfs:comment>
        <rdfs:label>fire score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#scoreNoFire -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#scoreNoFire">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#VisionModelScores"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>No-fire score from vision model (0-1).</rdfs:comment>
        <rdfs:label>no-fire score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#scoreSmoke -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#scoreSmoke">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#VisionModelScores"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Smoke score from vision model (0-1).</rdfs:comment>
        <rdfs:label>smoke score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#sensorPoseRecorded -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#sensorPoseRecorded">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ImageQualityMetadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if yaw/pitch/roll are recorded; false otherwise.</rdfs:comment>
        <rdfs:label>sensor orientation/pose recorded?</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#shelterBurned -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#shelterBurned">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether a barn or livestock shelter is burned or shows burn damage.</rdfs:comment>
        <rdfs:label>barn or shelter burned</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#shelterInPlaceGuidance -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#shelterInPlaceGuidance">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#PublicSafetyGuidance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Instructions advising individuals to remain indoors and take protective actions during hazards.</rdfs:comment>
        <rdfs:label>when to shelter in place guidance</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#shelteringInPlace -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#shelteringInPlace">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">The act of remaining in a safe indoor location rather than evacuating.</rdfs:comment>
        <rdfs:label>sheltering in place</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#shovelsOrHoesScrapingToMineralSoil -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#shovelsOrHoesScrapingToMineralSoil">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Tool"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates use of hand tools to remove vegetation to mineral soil as a fire control measure.</rdfs:comment>
        <rdfs:label>shovels/hoes scraping to mineral soil</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#shrubsBurnedToStems -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#shrubsBurnedToStems">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Shrub"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether shrubs or chaparral are burned down to stems.</rdfs:comment>
        <rdfs:label>shrubs burned to stems</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#signpostScorched -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#signpostScorched">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Signpost"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Whether a signpost appears scorched or burned.</rdfs:comment>
        <rdfs:label>signpost scorched</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#sirenVehiclePresent -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#sirenVehiclePresent">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Observation that a vehicle equipped with a siren is present at the scene.</rdfs:comment>
        <rdfs:label>siren vehicle present</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#siteLiteral -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#siteLiteral">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Records the localized name, physical designation, or descriptive text of an observation station or facility.</rdfs:comment>
        <rdfs:label xml:lang="en">site literal</rdfs:label>
        <rdfs:label>site literal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokeAffectsAviation -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokeAffectsAviation">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates that smoke conditions are impacting aviation operations and safety.</rdfs:comment>
        <rdfs:label>smoke affecting aviation routes</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokeBlowingAcrossEvacRoutes -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokeBlowingAcrossEvacRoutes">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Observation that smoke is crossing designated evacuation routes, potentially affecting safety.</rdfs:comment>
        <rdfs:label>smoke blowing across evacuation routes</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokeColor -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokeColor">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SmokeCondition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates smoke color such as white, gray, brown, or black.</rdfs:comment>
        <rdfs:label>smoke color</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokeColorLiteral -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokeColorLiteral">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SmokeObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Literal description of smoke color (e.g., &apos;dark-gray with a brown tinge&apos;).</rdfs:comment>
        <rdfs:label>smoke color description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokeDensity -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokeDensity">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SmokeCondition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Describes smoke density level (low, medium, high).</rdfs:comment>
        <rdfs:label>smoke density level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokeExposureDuration -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokeExposureDuration">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#HealthRisk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:comment>Duration of exposure to wildfire smoke.</rdfs:comment>
        <rdfs:label>smoke exposure duration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokeLayerLowerDesc -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokeLayerLowerDesc">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SmokeLayerObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Descriptive text for lower smoke layer (dense, ground-hugging, etc.).</rdfs:comment>
        <rdfs:label>lower smoke layer description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokeLayerUpperDesc -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokeLayerUpperDesc">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SmokeLayerObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Descriptive text for higher/aloft plumes (rising columns, pyrocumulus building).</rdfs:comment>
        <rdfs:label>upper smoke layer description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokePM25 -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokePM25">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ParticulateMatter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Measured PM2.5 concentration in micrograms per cubic meter from smoke.</rdfs:comment>
        <rdfs:label>smoke PM2.5 (ug/m3)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokePlumeHeight -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokePlumeHeight">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SmokeObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Descriptive height of the smoke plume (e.g., &apos;very tall, extending high into the atmosphere&apos;).</rdfs:comment>
        <rdfs:label>smoke plume height (descriptive)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokePlumeOrientation -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokePlumeOrientation">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SmokeObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Whether plume is rising vertically or drifting horizontally (plus direction).</rdfs:comment>
        <rdfs:label>smoke plume orientation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokeReachedStratosphere -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokeReachedStratosphere">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates that smoke from a fire has risen into the stratospheric layer of the atmosphere.</rdfs:comment>
        <rdfs:label>smoke reached stratosphere</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokeRising -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokeRising">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether smoke is still rising from a building after a wildfire.</rdfs:comment>
        <rdfs:label>smoke rising</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokeScore -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokeScore">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#VisionModelScores"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Indicates a numerical value or algorithmic confidence metric representing the likelihood or density of detected smoke.</rdfs:comment>
        <rdfs:label xml:lang="en">smoke score</rdfs:label>
        <rdfs:label>smoke score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokeScoreAboveThreshold -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokeScoreAboveThreshold">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#VisionModelScores"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">A boolean flag or indicator denoting whether the calculated smoke density metric exceeds the established warning limit.</rdfs:comment>
        <rdfs:label xml:lang="en">smoke score above threshold</rdfs:label>
        <rdfs:label>smoke score above threshold</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokeThickness -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokeThickness">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SmokeObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Descriptive thickness of smoke (e.g., &apos;extremely thick&apos;).</rdfs:comment>
        <rdfs:label>smoke thickness (descriptive)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokeThreshold -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokeThreshold">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ThresholdSet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Defines the specific numerical boundary or concentration level at which a smoke detection alert is triggered.</rdfs:comment>
        <rdfs:label xml:lang="en">smoke threshold</rdfs:label>
        <rdfs:label>smoke threshold</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smokeVisibilityDistance -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smokeVisibilityDistance">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#EnvironmentalCondition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Estimated distance at which smoke visibility is reduced or obscured.</rdfs:comment>
        <rdfs:label>visibility distance in miles</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#smolderingPresent -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#smolderingPresent">
