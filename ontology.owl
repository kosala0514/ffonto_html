        <rdfs:label xml:lang="en">fire score</rdfs:label>
        <rdfs:label>fire score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#fireScoreAboveThreshold -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#fireScoreAboveThreshold">
