        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestEcosystem"/>
        <rdfs:comment>Inverse of has fire event</rdfs:comment>
        <rdfs:label>is fire event of</rdfs:label>
