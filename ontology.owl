        <rdfs:label xml:lang="en">influences fire behavior by characteristic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#influencesFireBehaviorByCharacteristicOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#influencesFireBehaviorByCharacteristicOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#influencesFireBehaviorByCharacteristic"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireBehavior"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FuelCharacteristic"/>
        <rdfs:comment xml:lang="en">Relates an environmental or terrain feature to the specific way its characteristics alter fire dynamics.</rdfs:comment>
        <rdfs:label xml:lang="en">influences fire behavior by characteristic of</rdfs:label>
    </owl:ObjectProperty>
    


