        <rdfs:label xml:lang="en">has label assignment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasLandCover -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasLandCover">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#LandCover"/>
        <rdfs:comment>Relates an ecosystem to the type of land cover present.</rdfs:comment>
        <rdfs:label>has land cover</rdfs:label>
