    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#practices">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#EvacuationDrill"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EvacuationPreparation"/>
