        <rdfs:label>increases wildfire risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#increasesWildfireRiskOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#increasesWildfireRiskOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#increasesWildfireRisk"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireBehavior"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFireRiskFactor"/>
        <rdfs:comment xml:lang="en">Inverse relation indicating that a factor increases wildfire risk for a given area or population.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of increases wildfire risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#indicatesCombustion -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#indicatesCombustion">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SmokeColor"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#CombustionProcess"/>
