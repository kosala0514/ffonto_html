    </owl:Class>
    


    <!-- http://purl.org/ffonto#PreventionMethod -->


    <owl:Class rdf:about="http://purl.org/ffonto#PreventionMethod">
        <rdfs:comment>Strategies or methods used to reduce wildfire risk.</rdfs:comment>
        <rdfs:label>Prevention Method</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#PrivacyProtection -->


