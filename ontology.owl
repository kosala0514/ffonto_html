    </owl:Class>
    


    <!-- http://purl.org/ffonto#SHAP -->


    <owl:Class rdf:about="http://purl.org/ffonto#SHAP">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ExplainableAI"/>
        <rdfs:comment xml:lang="en">SHapley Additive exPlanations; a method for interpreting contributions of features to model predictions.</rdfs:comment>
        <rdfs:label>SHAP Explanation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#STAC -->


    <owl:Class rdf:about="http://purl.org/ffonto#STAC">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#GeospatialDataFormat"/>
        <rdfs:comment xml:lang="en">SpatioTemporal Asset Catalog; a specification for describing geospatial data assets and metadata.</rdfs:comment>
        <rdfs:label>SpatioTemporal Asset Catalog (STAC)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SafetyMeasure -->


    <owl:Class rdf:about="http://purl.org/ffonto#SafetyMeasure">
        <rdfs:comment>Protective action or precaution used to reduce wildfire risks.</rdfs:comment>
        <rdfs:label>Safety Measure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SafetyOfficer -->


    <owl:Class rdf:about="http://purl.org/ffonto#SafetyOfficer">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#IncidentCommandRole"/>
        <rdfs:comment xml:lang="en">An individual responsible for overseeing health and safety practices during an incident.</rdfs:comment>
        <rdfs:label>Safety Officer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SafetyZone -->


    <owl:Class rdf:about="http://purl.org/ffonto#SafetyZone">
        <rdfs:comment>A cleared area used as refuge during wildfire operations where responders or civilians can remain safe.</rdfs:comment>
        <rdfs:label>Safety Zone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SaliencyMap -->


    <owl:Class rdf:about="http://purl.org/ffonto#SaliencyMap">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ExplainableAI"/>
        <rdfs:comment xml:lang="en">A representation highlighting regions of an input that most influence model predictions.</rdfs:comment>
        <rdfs:label>Saliency Map</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Satellite -->


    <owl:Class rdf:about="http://purl.org/ffonto#Satellite">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SensorPlatform"/>
        <rdfs:label xml:lang="en">Satellite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SatelliteData -->


    <owl:Class rdf:about="http://purl.org/ffonto#SatelliteData">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EarthObservationData"/>
        <rdfs:comment xml:lang="en">Observational data collected by Earth-orbiting satellites, including imagery and sensor measurements.</rdfs:comment>
        <rdfs:label>Satellite Data</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SatelliteDetection -->


    <owl:Class rdf:about="http://purl.org/ffonto#SatelliteDetection">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#DetectionMethod"/>
        <rdfs:comment>Thermal or spectral satellite detection of wildfire signatures.</rdfs:comment>
        <rdfs:label>Satellite Detection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SatelliteInternet -->


    <owl:Class rdf:about="http://purl.org/ffonto#SatelliteInternet">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#CommunicationNetwork"/>
        <rdfs:comment xml:lang="en">Internet connectivity provided via satellites rather than terrestrial infrastructure.</rdfs:comment>
        <rdfs:label>Satellite Internet</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SatelliteObservation -->


    <owl:Class rdf:about="http://purl.org/ffonto#SatelliteObservation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:comment>An observation event derived from satellite passes on a given day to check for smoke plumes.</rdfs:comment>
        <rdfs:label>Satellite Observation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SceneElement -->


    <owl:Class rdf:about="http://purl.org/ffonto#SceneElement">
        <rdfs:comment xml:lang="en">Physical objects, features, or evidence detected within an image or scene.</rdfs:comment>
        <rdfs:label xml:lang="en">Scene Element</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SchoolEducation -->


    <owl:Class rdf:about="http://purl.org/ffonto#SchoolEducation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PublicEducationProgram"/>
        <rdfs:comment xml:lang="en">Educational programs targeting students and school communities on preparedness and safety topics.</rdfs:comment>
        <rdfs:label>School ForestFire Education Program</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ScrapeLine -->


    <owl:Class rdf:about="http://purl.org/ffonto#ScrapeLine">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Fireline"/>
        <rdfs:comment xml:lang="en">A cleared or scraped area used as a control line to slow or stop fire spread.</rdfs:comment>
        <rdfs:label>Scrape Line</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SeasonalFlammability -->


    <owl:Class rdf:about="http://purl.org/ffonto#SeasonalFlammability">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FuelCharacteristic"/>
        <rdfs:comment>Variation in vegetation flammability depending on seasonal conditions.</rdfs:comment>
        <rdfs:label>Seasonal Flammability</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SeedGermination -->


    <owl:Class rdf:about="http://purl.org/ffonto#SeedGermination">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#VegetationDynamics"/>
        <rdfs:comment>The process of seeds developing into new plants, often triggered by fire heat or smoke.</rdfs:comment>
        <rdfs:label>Seed Germination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SeedReleaseMechanism -->


    <owl:Class rdf:about="http://purl.org/ffonto#SeedReleaseMechanism">
        <rdfs:comment>Biological processes that release seeds in response to fire.</rdfs:comment>
        <rdfs:label>Seed Release Mechanism</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Segmentation -->


    <owl:Class rdf:about="http://purl.org/ffonto#Segmentation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ComputerVisionTask"/>
        <rdfs:comment xml:lang="en">The process of partitioning data or images into meaningful regions or classes.</rdfs:comment>
        <rdfs:label>Segmentation (burn scars/perimeters)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SelfSupervisedLearning -->


    <owl:Class rdf:about="http://purl.org/ffonto#SelfSupervisedLearning">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ModelTrainingTechnique"/>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Sensor -->


    <owl:Class rdf:about="http://purl.org/ffonto#Sensor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:comment xml:lang="en">A device that detects and measures physical or environmental properties and outputs data.</rdfs:comment>
        <rdfs:label>Sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SensorFusion -->


    <owl:Class rdf:about="http://purl.org/ffonto#SensorFusion">
        <rdfs:comment xml:lang="en">The process of combining data from multiple sensors to improve wildfire detection or monitoring.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensor fusion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SensorPlatform -->


    <owl:Class rdf:about="http://purl.org/ffonto#SensorPlatform">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <rdfs:comment xml:lang="en">A physical carrier or structure (e.g., drone, satellite, tower) that hosts sensors.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensor Platform</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ShortestSafePath -->


    <owl:Class rdf:about="http://purl.org/ffonto#ShortestSafePath">
        <rdfs:comment xml:lang="en">A computed route that minimizes distance while satisfying safety constraints.</rdfs:comment>
        <rdfs:label>Shortest Safe Path</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Shrub -->


    <owl:Class rdf:about="http://purl.org/ffonto#Shrub">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Vegetation"/>
        <rdfs:comment>A woody plant smaller than a tree, typically with multiple stems and forming part of forest understory vegetation.</rdfs:comment>
        <rdfs:label>Shrub</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Shrubland -->


    <owl:Class rdf:about="http://purl.org/ffonto#Shrubland">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:comment>An ecosystem characterized by dense shrub vegetation.</rdfs:comment>
        <rdfs:label>Shrubland</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Siding -->


    <owl:Class rdf:about="http://purl.org/ffonto#Siding">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#BuildingComponent"/>
        <rdfs:comment>Exterior wall covering material that may be combustible or fire resistant.</rdfs:comment>
        <rdfs:label>Siding Material</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Signpost -->


    <owl:Class rdf:about="http://purl.org/ffonto#Signpost">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:comment>Traffic or informational signposts.</rdfs:comment>
        <rdfs:label>Signpost</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SimulationModel -->


    <owl:Class rdf:about="http://purl.org/ffonto#SimulationModel">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A computational model used to simulate physical processes, such as fire spread or smoke dispersion.</rdfs:comment>
        <rdfs:label xml:lang="en">simulation model</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Site -->


    <owl:Class rdf:about="http://purl.org/ffonto#Site">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SpatialEntity"/>
        <rdfs:comment>A specific geographic location such as a fire incident site.</rdfs:comment>
        <rdfs:label>Site</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SituationReport -->


    <owl:Class rdf:about="http://purl.org/ffonto#SituationReport">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#IncidentReport"/>
        <rdfs:comment xml:lang="en">A concise report summarizing current conditions, impacts, and response actions.</rdfs:comment>
        <rdfs:label>Situation Report (SITREP)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Slope -->


    <owl:Class rdf:about="http://purl.org/ffonto#Slope">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Topography"/>
        <rdfs:comment xml:lang="en">The steepness or incline of terrain, commonly expressed as a percentage or angle.</rdfs:comment>
        <rdfs:label>Slope</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Smoke -->


    <owl:Class rdf:about="http://purl.org/ffonto#Smoke">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AirPollution"/>
        <rdfs:comment>Visible smoke produced by combustion.</rdfs:comment>
        <rdfs:label>Smoke</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SmokeColor -->


    <owl:Class rdf:about="http://purl.org/ffonto#SmokeColor">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SmokePlume"/>
        <rdfs:comment>Smoke color categories.</rdfs:comment>
        <rdfs:label>Smoke Color</rdfs:label>
        <rdfs:label>Smoke Color (enum)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SmokeComponent -->


    <owl:Class rdf:about="http://purl.org/ffonto#SmokeComponent">
        <rdfs:comment>Chemical compounds and particles present in wildfire smoke.</rdfs:comment>
        <rdfs:label>Smoke Component</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SmokeCondition -->


    <owl:Class rdf:about="http://purl.org/ffonto#SmokeCondition">
        <rdfs:comment>Represents characteristics of smoke present at the wildfire scene.</rdfs:comment>
        <rdfs:label>Smoke Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SmokeDamage -->


    <owl:Class rdf:about="http://purl.org/ffonto#SmokeDamage">
        <rdfs:comment>Damage caused by smoke, often resulting from wildfires, house fires, or other combustion events.</rdfs:comment>
        <rdfs:label>Smoke Damage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SmokeDetection -->


    <owl:Class rdf:about="http://purl.org/ffonto#SmokeDetection">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ComputerVisionTask"/>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SmokeDispersionModel -->


    <owl:Class rdf:about="http://purl.org/ffonto#SmokeDispersionModel">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AtmosphericTransportModel"/>
        <rdfs:comment xml:lang="en">A computational model that simulates the transport and spread of smoke in the atmosphere.</rdfs:comment>
        <rdfs:label>Smoke Dispersion Model</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SmokeHazard -->


    <owl:Class rdf:about="http://purl.org/ffonto#SmokeHazard">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:comment>Respiratory and visibility impacts from PM2.5 and toxic smoke.</rdfs:comment>
        <rdfs:label>Smoke Hazard</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SmokeHealthEffect -->


    <owl:Class rdf:about="http://purl.org/ffonto#SmokeHealthEffect">
        <rdfs:comment>Adverse human health outcomes caused by wildfire smoke exposure.</rdfs:comment>
        <rdfs:label>Smoke Health Effect</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SmokeLayerObservation -->


    <owl:Class rdf:about="http://purl.org/ffonto#SmokeLayerObservation">
        <rdfs:comment>Observation describing presence of multilayer smoke and qualitative descriptions per layer.</rdfs:comment>
        <rdfs:label>Smoke Layer Observation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SmokeObservation -->


    <owl:Class rdf:about="http://purl.org/ffonto#SmokeObservation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ImageObservation"/>
        <rdfs:comment>An observation indicating the presence of smoke within an environmental image, which may suggest an ongoing fire or combustion event.</rdfs:comment>
        <rdfs:label>Smoke Observation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SmokePlume -->


    <owl:Class rdf:about="http://purl.org/ffonto#SmokePlume">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment xml:lang="en">A concentrated column or mass of smoke rising from a fire source.</rdfs:comment>
        <rdfs:label>Smoke Plume</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Smoker -->


    <owl:Class rdf:about="http://purl.org/ffonto#Smoker">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PopulationGroup"/>
        <rdfs:comment xml:lang="en">A person who uses tobacco or other smoked substances; potential ignition source in certain contexts.</rdfs:comment>
        <rdfs:label>Smoker</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Smoking -->


    <owl:Class rdf:about="http://purl.org/ffonto#Smoking">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#HumanIgnition"/>
        <rdfs:comment xml:lang="en">The act of inhaling and exhaling tobacco or other substances; a potential fire ignition source.</rdfs:comment>
        <rdfs:label>Smoking (Discarded Cigarette)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SmolderingPhase -->


    <owl:Class rdf:about="http://purl.org/ffonto#SmolderingPhase">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#CombustionProcess"/>
        <rdfs:comment>Low-temperature combustion phase producing high levels of carbon monoxide and smoke.</rdfs:comment>
        <rdfs:label>Smoldering Phase</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Snag -->


    <owl:Class rdf:about="http://purl.org/ffonto#Snag">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Vegetation"/>
        <rdfs:comment>Standing dead trees (snags).</rdfs:comment>
        <rdfs:label>Snag</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SnowCover -->


    <owl:Class rdf:about="http://purl.org/ffonto#SnowCover">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EnvironmentalCondition"/>
        <owl:disjointWith rdf:resource="http://purl.org/ffonto#SoilCondition"/>
        <rdfs:comment>Snow present on the ground that can influence fire behavior by reducing vegetation dryness and limiting fire spread.</rdfs:comment>
        <rdfs:label>Snow Cover</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SnowCoverObservation -->


    <owl:Class rdf:about="http://purl.org/ffonto#SnowCoverObservation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ImageObservation"/>
        <rdfs:comment>An observation indicating the presence of snow cover on the ground or vegetation in an environmental image.</rdfs:comment>
        <rdfs:label>Snow Cover Observation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SocialEquity -->


    <owl:Class rdf:about="http://purl.org/ffonto#SocialEquity">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EthicalConsideration"/>
        <rdfs:comment xml:lang="en">The fair and just distribution of resources, opportunities, and burdens across populations.</rdfs:comment>
        <rdfs:label>Social Equity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SoilCondition -->


    <owl:Class rdf:about="http://purl.org/ffonto#SoilCondition">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EnvironmentalCondition"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EnvironmentalFactor"/>
        <rdfs:comment>Characteristics of soil such as moisture and nutrient content.</rdfs:comment>
        <rdfs:comment>Physical and chemical characteristics of soil that influence vegetation growth and ecosystem health.</rdfs:comment>
        <rdfs:label>Soil Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SoilErosion -->


    <owl:Class rdf:about="http://purl.org/ffonto#SoilErosion">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PhysicalImpact"/>
        <rdfs:comment>The displacement of soil layers following the loss of protective vegetation.</rdfs:comment>
        <rdfs:label>Soil Erosion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SoilMoistureIndex -->


    <owl:Class rdf:about="http://purl.org/ffonto#SoilMoistureIndex">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#VegetationIndex"/>
        <rdfs:comment>Indicator measuring soil water availability.</rdfs:comment>
        <rdfs:label>Soil Moisture Index</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SoilMoistureRetention -->


    <owl:Class rdf:about="http://purl.org/ffonto#SoilMoistureRetention">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EcosystemService"/>
        <rdfs:comment>Ability of an ecosystem or water body to maintain soil moisture levels.</rdfs:comment>
        <rdfs:label>Soil moisture retention</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SoilNutrientChange -->


    <owl:Class rdf:about="http://purl.org/ffonto#SoilNutrientChange">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EcologicalImpact"/>
        <rdfs:comment>Changes in soil nutrient composition caused by fire.</rdfs:comment>
        <rdfs:label>Soil Nutrient Change</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SoilNutrientLoss -->


    <owl:Class rdf:about="http://purl.org/ffonto#SoilNutrientLoss">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EcologicalStress"/>
        <rdfs:comment>Reduction in soil fertility due to environmental factors.</rdfs:comment>
        <rdfs:label>Soil nutrient loss</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SoilQuality -->


    <owl:Class rdf:about="http://purl.org/ffonto#SoilQuality">
        <rdfs:comment>Indicators of soil fertility or texture that influence vegetation growth and distribution.</rdfs:comment>
        <rdfs:label>Soil quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SolarPanel -->


    <owl:Class rdf:about="http://purl.org/ffonto#SolarPanel">
        <rdfs:comment>Photovoltaic panels installed on rooftops.</rdfs:comment>
        <rdfs:label>Solar Panel</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SparseVegetation -->


    <owl:Class rdf:about="http://purl.org/ffonto#SparseVegetation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#VegetationCondition"/>
        <rdfs:comment>Vegetation distributed sparsely across the landscape.</rdfs:comment>
        <rdfs:label>Sparse vegetation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SparseWoodland -->


    <owl:Class rdf:about="http://purl.org/ffonto#SparseWoodland">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#LandCover"/>
        <rdfs:comment>Woodland area with scattered trees and lower canopy density.</rdfs:comment>
        <rdfs:label>Sparse woodland</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SpatialEntity -->


    <owl:Class rdf:about="http://purl.org/ffonto#SpatialEntity">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment xml:lang="en">An entity that exists in physical or geographic space and can have a spatial location or geometry.</rdfs:comment>
        <rdfs:label xml:lang="en">Spatial entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SpatialExtent -->


    <owl:Class rdf:about="http://purl.org/ffonto#SpatialExtent">
        <rdfs:comment xml:lang="en">The physical area, geographic boundary, or geospatial footprint covered by an event or entity.</rdfs:comment>
        <rdfs:label xml:lang="en">spatial extent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SpatialFeature -->


    <owl:Class rdf:about="http://purl.org/ffonto#SpatialFeature">
        <rdfs:comment xml:lang="en">A geographic feature or object that can be located or represented in spatial coordinates.</rdfs:comment>
        <rdfs:label xml:lang="en">Spatial feature</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SpatialUnit -->


    <owl:Class rdf:about="http://purl.org/ffonto#SpatialUnit">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ffonto#hasVegetationDistribution"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ffonto#VegetationDistribution"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Spatial unit for measurement and observation (plot, patch, landscape unit).</rdfs:comment>
        <rdfs:label>Spatial unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SpecialNeedsPlan -->


    <owl:Class rdf:about="http://purl.org/ffonto#SpecialNeedsPlan">
        <rdfs:comment>Preparedness measures for those with disabilities, medical dependencies, or other special requirements.</rdfs:comment>
        <rdfs:label>Special Needs Plan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SpeciesCompositionChange -->


    <owl:Class rdf:about="http://purl.org/ffonto#SpeciesCompositionChange">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#VegetationDynamics"/>
        <rdfs:comment>A shift in the types and proportions of species present in an ecosystem following disturbance.</rdfs:comment>
        <rdfs:label>Species Composition Change</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SpontaneousCombustion -->


    <owl:Class rdf:about="http://purl.org/ffonto#SpontaneousCombustion">
