        <rdfs:label xml:lang="en">predicts fire spread</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#predictsSmokePlume -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#predictsSmokePlume">
