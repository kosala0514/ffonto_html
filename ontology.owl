        <rdfs:label>structure affected by fire</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#structureAffectedOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#structureAffectedOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#structureAffected"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#StructureFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking affected structures back to the incidents or hazards impacting them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of structure affected</rdfs:label>
