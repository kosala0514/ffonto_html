        <rdfs:label>fire hydrant visible</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#fireOccurred -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#fireOccurred">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WeatherObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">A boolean flag or categorical indicator recording whether a combustion event actually took place at a given location and time.</rdfs:comment>
        <rdfs:label xml:lang="en">fire occurred</rdfs:label>
        <rdfs:label>fire occurred</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#firePerimeterExpanding -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#firePerimeterExpanding">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireSpread"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
