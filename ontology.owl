        <rdfs:label>model accuracy score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasArea -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasArea">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SpatialEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Area of the spatial entity in square kilometers.</rdfs:comment>
        <rdfs:label>area</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasAverageTreeHeight -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasAverageTreeHeight">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ConiferousForest"/>
