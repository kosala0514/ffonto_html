    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasPredictiveInterval">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#EnsembleForecast"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#PredictiveInterval"/>
        <rdfs:comment xml:lang="en">Links a forecasted value or simulation model to the specific time horizon (e.g., 24 hours, 7 days) it projects.</rdfs:comment>
        <rdfs:label xml:lang="en">has predictive interval</rdfs:label>
    </owl:ObjectProperty>
    


