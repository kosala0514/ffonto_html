    </owl:Class>
    


    <!-- http://purl.org/ffonto#UrbanGrowth -->


    <owl:Class rdf:about="http://purl.org/ffonto#UrbanGrowth">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#LandCoverChange"/>
        <rdfs:comment>Expansion of urban areas into natural landscapes increasing ignition sources.</rdfs:comment>
        <rdfs:label>Urban Growth</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#UrbanWildlandInterface -->


