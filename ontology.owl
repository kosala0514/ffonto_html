        <rdfs:label>soil moisture percent</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#soilNutrientIndex -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#soilNutrientIndex">
