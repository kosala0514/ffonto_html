    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isDetectedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isDetectedBy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireFront"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ActiveFireDetection"/>
        <rdfs:comment xml:lang="en">Connects a phenomenon, incident, or entity to the sensor, system, or agent that discovers it.</rdfs:comment>
        <rdfs:label xml:lang="en">is detected by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isDetectedByThermalCamera -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isDetectedByThermalCamera">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ActiveFireDetection"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ThermalCamera"/>
