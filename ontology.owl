        <rdfs:comment>A large human settlement.</rdfs:comment>
        <rdfs:label>City</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Civilian -->


    <owl:Class rdf:about="http://purl.org/ffonto#Civilian">
        <rdfs:comment>Non-responder individuals present in the wildfire area.</rdfs:comment>
        <rdfs:label>Civilian</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CleanAirShelter -->


    <owl:Class rdf:about="http://purl.org/ffonto#CleanAirShelter">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EmergencyFacility"/>
        <rdfs:comment>Building providing filtered indoor air during smoke events.</rdfs:comment>
        <rdfs:label>Clean Air Shelter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ClearDropZoneAction -->


    <owl:Class rdf:about="http://purl.org/ffonto#ClearDropZoneAction">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ProtectiveAction"/>
        <rdfs:comment>The operational activity where ground crews evacuate and secure a target area prior to an aerial drop.</rdfs:comment>
        <rdfs:label>Clear Drop Zone Action</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ClearedDropZone -->


    <owl:Class rdf:about="http://purl.org/ffonto#ClearedDropZone">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#DropZone"/>
        <rdfs:comment>A drop zone that has successfully undergone a clearance action and is verified safe for aerial delivery.</rdfs:comment>
        <rdfs:label>Cleared Drop Zone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ClimateAnomaly -->


    <owl:Class rdf:about="http://purl.org/ffonto#ClimateAnomaly">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ClimateEvent"/>
        <rdfs:comment>Deviation of climate variables from long-term averages.</rdfs:comment>
        <rdfs:label>Climate Anomaly</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ClimateChange -->


    <owl:Class rdf:about="http://purl.org/ffonto#ClimateChange">
        <rdfs:comment>Long-term changes in global or regional climate patterns.</rdfs:comment>
        <rdfs:label>Climate change</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ClimateDriver -->


    <owl:Class rdf:about="http://purl.org/ffonto#ClimateDriver">
        <rdfs:comment>Climate-related conditions that influence wildfire probability and behavior.</rdfs:comment>
        <rdfs:label>Climate Driver</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ClimateEvent -->


    <owl:Class rdf:about="http://purl.org/ffonto#ClimateEvent">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#TemporalExtent"/>
        <rdfs:comment xml:lang="en">A specific, significant occurrence of weather or atmospheric conditions, such as a drought, heatwave, or storm.</rdfs:comment>
        <rdfs:label xml:lang="en">climate event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ClimateFeedbackLoop -->


    <owl:Class rdf:about="http://purl.org/ffonto#ClimateFeedbackLoop">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ClimatePattern"/>
        <rdfs:comment xml:lang="en">A process where climate system responses amplify or dampen an initial forcing.</rdfs:comment>
        <rdfs:label>Climate Feedback Loop</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ClimateMitigation -->


    <owl:Class rdf:about="http://purl.org/ffonto#ClimateMitigation">
        <rdfs:comment xml:lang="en">Actions taken to reduce greenhouse gas emissions or limit climate change impacts.</rdfs:comment>
        <rdfs:label>Climate Change Mitigation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ClimatePattern -->


    <owl:Class rdf:about="http://purl.org/ffonto#ClimatePattern">
        <rdfs:comment xml:lang="en">A recurring or sustained meteorological trend within a specific region or on a global scale (e.g., El Niño).</rdfs:comment>
        <rdfs:label xml:lang="en">climate pattern</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ClothingRecommendation -->


    <owl:Class rdf:about="http://purl.org/ffonto#ClothingRecommendation">
        <rdfs:comment>Recommended clothing types for safe evacuation and wildfire exposure.</rdfs:comment>
        <rdfs:label>Clothing Recommendation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CloudCoverQuality -->


    <owl:Class rdf:about="http://purl.org/ffonto#CloudCoverQuality">
        <rdfs:comment>Quality metadata for cloud cover field (presence/absence of quality flag).</rdfs:comment>
        <rdfs:label>Cloud Cover Quality Metadata</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CoarseWoodyDebris -->


    <owl:Class rdf:about="http://purl.org/ffonto#CoarseWoodyDebris">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FuelLoad"/>
        <rdfs:comment>Large downed logs and branches contributing to long-duration burns.</rdfs:comment>
        <rdfs:label>Coarse woody debris</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CombustionProcess -->


    <owl:Class rdf:about="http://purl.org/ffonto#CombustionProcess">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PhysicalProcess"/>
        <rdfs:comment>Chemical process of burning fuel that produces smoke, gases, and heat during wildfires.</rdfs:comment>
        <rdfs:label>Combustion Process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CommandPost -->


    <owl:Class rdf:about="http://purl.org/ffonto#CommandPost">
        <rdfs:comment xml:lang="en">A location from which incident command and coordination are conducted.</rdfs:comment>
        <rdfs:label>Command Post</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Communication -->


    <owl:Class rdf:about="http://purl.org/ffonto#Communication">
        <rdfs:comment>Communication among firefighters such as radio coordination.</rdfs:comment>
        <rdfs:label>Communication Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CommunicationDevice -->


    <owl:Class rdf:about="http://purl.org/ffonto#CommunicationDevice">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <rdfs:comment xml:lang="en">Hardware used to transmit or receive information between responders, UAVs, or command centers.</rdfs:comment>
        <rdfs:label xml:lang="en">communication device</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CommunicationMethod -->


    <owl:Class rdf:about="http://purl.org/ffonto#CommunicationMethod">
        <rdfs:comment>Channels used for operational and public communication.</rdfs:comment>
        <rdfs:label>Communication Method</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CommunicationNetwork -->


    <owl:Class rdf:about="http://purl.org/ffonto#CommunicationNetwork">
        <rdfs:comment xml:lang="en">Systems and infrastructure enabling information exchange among stakeholders and responders.</rdfs:comment>
        <rdfs:label>Communication Network</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CommunicationPlan -->


    <owl:Class rdf:about="http://purl.org/ffonto#CommunicationPlan">
        <rdfs:comment>Who to notify, check-in procedures, and contact numbers during evacuation.</rdfs:comment>
        <rdfs:label>Communication Plan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CommunicationTower -->


    <owl:Class rdf:about="http://purl.org/ffonto#CommunicationTower">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:comment>Cell/communication towers.</rdfs:comment>
        <rdfs:label>Communication Tower</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Community -->


    <owl:Class rdf:about="http://purl.org/ffonto#Community">
        <rdfs:comment>Population centers, towns, or settlements near a fire.</rdfs:comment>
        <rdfs:label>Community</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CommunityPlanning -->


    <owl:Class rdf:about="http://purl.org/ffonto#CommunityPlanning">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#LandManagementPractice"/>
        <rdfs:comment xml:lang="en">Processes by which communities prepare policies and actions to reduce hazard impacts.</rdfs:comment>
        <rdfs:label>Community Planning</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CommunityPreparedness -->


    <owl:Class rdf:about="http://purl.org/ffonto#CommunityPreparedness">
        <rdfs:comment>Plans, programs and actions at community level to prepare for wildfire events.</rdfs:comment>
        <rdfs:label>Community Preparedness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CommunityPreparednessPlan -->


    <owl:Class rdf:about="http://purl.org/ffonto#CommunityPreparednessPlan">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A documented strategy outlining procedures and resources for a community to prepare for and respond to emergencies.</rdfs:comment>
        <rdfs:label xml:lang="en">community preparedness plan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CommunityProgram -->


    <owl:Class rdf:about="http://purl.org/ffonto#CommunityProgram">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#CommunityPreparedness"/>
        <rdfs:comment xml:lang="en">An organized local initiative to support preparedness, mitigation, or response activities.</rdfs:comment>
        <rdfs:label>Community ForestFire Protection Program</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CommunityWorkshop -->


    <owl:Class rdf:about="http://purl.org/ffonto#CommunityWorkshop">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PublicEducationProgram"/>
        <rdfs:comment xml:lang="en">A public meeting or training session aimed at community engagement and education.</rdfs:comment>
        <rdfs:label>Community Workshop</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ComputerVisionTask -->


    <owl:Class rdf:about="http://purl.org/ffonto#ComputerVisionTask">
        <rdfs:comment xml:lang="en">A defined problem in computer vision such as detection, segmentation, or classification.</rdfs:comment>
        <rdfs:label>Computer Vision Task</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ComputingPlatform -->


    <owl:Class rdf:about="http://purl.org/ffonto#ComputingPlatform">
        <rdfs:comment xml:lang="en">A software or cloud platform used to store, process, or analyze observation data.</rdfs:comment>
        <rdfs:label xml:lang="en">Computing Platform</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ConfidenceScore -->


    <owl:Class rdf:about="http://purl.org/ffonto#ConfidenceScore">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PredictionMetric"/>
        <rdfs:comment xml:lang="en">A numeric value representing the estimated reliability of a prediction or measurement.</rdfs:comment>
        <rdfs:label>Confidence Score</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ConiferousForest -->


    <owl:Class rdf:about="http://purl.org/ffonto#ConiferousForest">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ForestEcosystem"/>
        <rdfs:comment>A forest ecosystem dominated by cone-bearing trees such as pines, spruces, and firs.</rdfs:comment>
        <rdfs:label>Coniferous Forest</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ConiferousFunctional -->


    <owl:Class rdf:about="http://purl.org/ffonto#ConiferousFunctional">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#VegetationFunctionalGroup"/>
        <owl:disjointWith rdf:resource="http://purl.org/ffonto#DeciduousFunctional"/>
        <rdfs:comment>Conifer-dominated functional group.</rdfs:comment>
        <rdfs:label>Coniferous functional group</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ConiferousTree -->


    <owl:Class rdf:about="http://purl.org/ffonto#ConiferousTree">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Tree"/>
        <owl:disjointWith rdf:resource="http://purl.org/ffonto#DeciduousTree"/>
        <rdfs:comment>A tree species that produces cones and typically has needle-like leaves, often containing resin that increases flammability.</rdfs:comment>
        <rdfs:label>Coniferous Tree</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Contact -->


    <owl:Class rdf:about="http://purl.org/ffonto#Contact">
        <rdfs:comment>Contact information (web, phone) for incident resources.</rdfs:comment>
        <rdfs:label>Contact</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ContainedFire -->


    <owl:Class rdf:about="http://purl.org/ffonto#ContainedFire">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ContainmentState"/>
        <rdfs:comment xml:lang="en">A fire that has been confined within established control lines or barriers.</rdfs:comment>
        <rdfs:label>Contained Fire</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ContainmentState -->


    <owl:Class rdf:about="http://purl.org/ffonto#ContainmentState">
        <rdfs:comment>Discrete incident status values.</rdfs:comment>
        <rdfs:label>Containment State</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ContinuityStrategy -->


    <owl:Class rdf:about="http://purl.org/ffonto#ContinuityStrategy">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#OperationalStrategy"/>
        <rdfs:comment>Actions businesses take to maintain operations during wildfire disruptions.</rdfs:comment>
        <rdfs:label>Business Continuity Strategy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ControlledBurn -->


    <owl:Class rdf:about="http://purl.org/ffonto#ControlledBurn">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireManagementStrategy"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PreventionMethod"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ffonto#hasManagementPurpose"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ffonto#ManagementPurpose"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ffonto#occursIn"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ffonto#ForestEcosystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A deliberately planned and managed fire used to reduce fuel loads, prevent severe forest fires, and promote forest regeneration.</rdfs:comment>
        <rdfs:label>Controlled Burn</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ControlledFire -->


    <owl:Class rdf:about="http://purl.org/ffonto#ControlledFire">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ContainmentState"/>
        <rdfs:comment xml:lang="en">A deliberately ignited fire conducted under controlled conditions for management objectives.</rdfs:comment>
        <rdfs:label>Controlled Fire</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Country -->


    <owl:Class rdf:about="http://purl.org/ffonto#Country">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SpatialEntity"/>
        <rdfs:comment>A sovereign nation or state.</rdfs:comment>
        <rdfs:label>Country</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CrowdsourcedReport -->


    <owl:Class rdf:about="http://purl.org/ffonto#CrowdsourcedReport">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#CitizenObservation"/>
        <rdfs:comment xml:lang="en">A report or observation submitted by members of the public or volunteers.</rdfs:comment>
        <rdfs:label>Crowdsourced Report</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Culvert -->


    <owl:Class rdf:about="http://purl.org/ffonto#Culvert">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#TransportationInfrastructure"/>
        <rdfs:comment>Culvert inlets/outlets along roadways.</rdfs:comment>
        <rdfs:label>Culvert</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#CyberSecurityPractice -->


    <owl:Class rdf:about="http://purl.org/ffonto#CyberSecurityPractice">
        <rdfs:comment xml:lang="en">A policy, control, or procedure intended to protect information systems from cyber threats.</rdfs:comment>
        <rdfs:label>Cybersecurity Practice</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Damaged -->


    <owl:Class rdf:about="http://purl.org/ffonto#Damaged">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#StructureLossStatus"/>
        <rdfs:comment xml:lang="en">An item or structure that has sustained physical harm or impairment.</rdfs:comment>
        <rdfs:label>Damaged</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DataAnalysisProcess -->


    <owl:Class rdf:about="http://purl.org/ffonto#DataAnalysisProcess">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">The systematic computational or manual review of data to extract insights and inform decision-making.</rdfs:comment>
        <rdfs:label xml:lang="en">data analysis process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DataAssimilation -->


    <owl:Class rdf:about="http://purl.org/ffonto#DataAssimilation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#TimeSeriesAnalysis"/>
        <rdfs:comment>Ingesting observations (hotspots, perimeters, weather) to nudge forecasts.</rdfs:comment>
        <rdfs:label>Data Assimilation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DataAugmentation -->


    <owl:Class rdf:about="http://purl.org/ffonto#DataAugmentation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ModelTrainingTechnique"/>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DataProvider -->


    <owl:Class rdf:about="http://purl.org/ffonto#DataProvider">
        <rdfs:comment>Organizations that provide wildfire, climate, or satellite data.</rdfs:comment>
        <rdfs:label>Data Provider Organization</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DataRepository -->


    <owl:Class rdf:about="http://purl.org/ffonto#DataRepository">
        <rdfs:comment>Platform used to store and distribute Earth observation datasets.</rdfs:comment>
        <rdfs:label>Data Repository</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DataStream -->


    <owl:Class rdf:about="http://purl.org/ffonto#DataStream">
        <rdfs:comment xml:lang="en">A continuous flow of data records generated over time from sensors or systems.</rdfs:comment>
        <rdfs:label>Data Stream</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DatasetVersion -->


    <owl:Class rdf:about="http://purl.org/ffonto#DatasetVersion">
        <rdfs:comment xml:lang="en">A specific, identifiable release of a dataset, often with a version identifier and changelog.</rdfs:comment>
        <rdfs:label>Dataset Version</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DeadBiomass -->


    <owl:Class rdf:about="http://purl.org/ffonto#DeadBiomass">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ForestFireRiskFactor"/>
        <rdfs:comment>Accumulated dead plant material acting as fuel for fire.</rdfs:comment>
        <rdfs:label>Dead biomass</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DeadVegetation -->


    <owl:Class rdf:about="http://purl.org/ffonto#DeadVegetation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#VegetationCondition"/>
        <rdfs:comment>Vegetation that has died due to fire, pests, drought, or disease.</rdfs:comment>
        <rdfs:label>Dead vegetation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DebrisBurning -->


    <owl:Class rdf:about="http://purl.org/ffonto#DebrisBurning">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#HumanIgnition"/>
        <rdfs:comment xml:lang="en">The controlled or uncontrolled burning of vegetative or man-made debris.</rdfs:comment>
        <rdfs:label>Debris / Open Burning</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DebrisFlowHazard -->


    <owl:Class rdf:about="http://purl.org/ffonto#DebrisFlowHazard">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:comment xml:lang="en">The presence of conditions that increase the likelihood of debris flows.</rdfs:comment>
        <rdfs:label>Debris Flow Hazard</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DebrisFlowRisk -->


    <owl:Class rdf:about="http://purl.org/ffonto#DebrisFlowRisk">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PostFireFloodRisk"/>
        <rdfs:comment xml:lang="en">The potential for rapid mass-wasting events composed of water-saturated debris following storms or fires.</rdfs:comment>
        <rdfs:label>Debris Flow Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DeciduousForest -->


    <owl:Class rdf:about="http://purl.org/ffonto#DeciduousForest">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ForestEcosystem"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#VegetationType"/>
        <rdfs:comment>A forest ecosystem dominated by trees that seasonally shed their leaves.</rdfs:comment>
        <rdfs:label>Deciduous Forest</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DeciduousFunctional -->


    <owl:Class rdf:about="http://purl.org/ffonto#DeciduousFunctional">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#VegetationFunctionalGroup"/>
        <rdfs:comment>Deciduous-dominated functional group.</rdfs:comment>
        <rdfs:label>Deciduous functional group</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DeciduousTree -->


    <owl:Class rdf:about="http://purl.org/ffonto#DeciduousTree">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Tree"/>
        <rdfs:comment>A tree species that sheds its leaves seasonally and is generally less flammable than coniferous trees.</rdfs:comment>
        <rdfs:label>Deciduous Tree</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DecisionLog -->


    <owl:Class rdf:about="http://purl.org/ffonto#DecisionLog">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A record documenting decisions, rationale, and relevant facts made during an operation.</rdfs:comment>
        <rdfs:label>Decision Log</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DecisionSupportSystem -->


    <owl:Class rdf:about="http://purl.org/ffonto#DecisionSupportSystem">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#InformationSystem"/>
        <rdfs:comment xml:lang="en">A tool or system providing information and analysis to aid decision-makers.</rdfs:comment>
        <rdfs:label>Decision Support System</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Deer -->


    <owl:Class rdf:about="http://purl.org/ffonto#Deer">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Wildlife"/>
        <rdfs:comment xml:lang="en">A cervid species; wildlife potentially affected by habitat change or fire.</rdfs:comment>
        <rdfs:label>Deer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DefensibleSpace -->


    <owl:Class rdf:about="http://purl.org/ffonto#DefensibleSpace">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PreventionMeasure"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#StructureDefense"/>
        <rdfs:comment>Zone distances are guidance and may be adapted to local regulation; use local building codes and WUI guidance.</rdfs:comment>
        <rdfs:label>Defensible Space</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DefensibleSpaceAction -->


    <owl:Class rdf:about="http://purl.org/ffonto#DefensibleSpaceAction">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ProtectiveAction"/>
        <rdfs:comment>The mitigation activity of removing or thinning vegetation and combustibles around structures to reduce ignition risk from a spreading wildfire.</rdfs:comment>
        <rdfs:label>Defensible Space Action</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DefensibleZone -->


    <owl:Class rdf:about="http://purl.org/ffonto#DefensibleZone">
        <rdfs:comment>A named sub-area within defensible space (e.g., Zone 1, Zone 2, Zone 3).</rdfs:comment>
        <rdfs:label>Defensible Zone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Deforestation -->


    <owl:Class rdf:about="http://purl.org/ffonto#Deforestation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Disturbance"/>
        <rdfs:comment>Large-scale removal of forest cover.</rdfs:comment>
        <rdfs:label>Deforestation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DeforestationFire -->


    <owl:Class rdf:about="http://purl.org/ffonto#DeforestationFire">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#IntentionalFire"/>
        <rdfs:comment>A fire intentionally set to clear forests for agriculture, infrastructure, or development.</rdfs:comment>
        <rdfs:label>Deforestation Fire</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DegradedVegetation -->


    <owl:Class rdf:about="http://purl.org/ffonto#DegradedVegetation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#LandCover"/>
        <rdfs:comment>Land cover where vegetation health or density has declined due to disturbance or environmental stress.</rdfs:comment>
        <rdfs:label>Degraded vegetation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DenseForest -->


    <owl:Class rdf:about="http://purl.org/ffonto#DenseForest">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#LandCover"/>
        <rdfs:comment>Land cover characterized by dense tree canopy and continuous vegetation.</rdfs:comment>
        <rdfs:label>Dense forest</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DeployableShelter -->


    <owl:Class rdf:about="http://purl.org/ffonto#DeployableShelter">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireShelter"/>
        <rdfs:comment xml:lang="en">A portable shelter intended for temporary housing during emergencies.</rdfs:comment>
        <rdfs:label>Deployable Fire Shelter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DetectionMethod -->


    <owl:Class rdf:about="http://purl.org/ffonto#DetectionMethod">
        <rdfs:comment xml:lang="en">A technique or sensor approach used to detect events or features of interest.</rdfs:comment>
        <rdfs:label>ForestFire Detection Method</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DetectionResult -->


    <owl:Class rdf:about="http://purl.org/ffonto#DetectionResult">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ModelOutput"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Result"/>
        <rdfs:comment>Classification or detection outputs (e.g., smoke, fire).</rdfs:comment>
        <rdfs:label>DetectionResult</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DiceCoefficient -->


    <owl:Class rdf:about="http://purl.org/ffonto#DiceCoefficient">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EvaluationMetric"/>
        <rdfs:comment xml:lang="en">A statistic for measuring similarity between two samples, commonly used in segmentation evaluation.</rdfs:comment>
        <rdfs:label>Dice Coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DigitalTwin -->


    <owl:Class rdf:about="http://purl.org/ffonto#DigitalTwin">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SimulationModel"/>
        <rdfs:comment>Dynamic virtual model of wildfire incidents integrating real-time sensor data.</rdfs:comment>
        <rdfs:comment>Live fused model of sensors, weather, fuel and operations for what-if simulation.</rdfs:comment>
        <rdfs:label>Digital Twin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DirectAttack -->


    <owl:Class rdf:about="http://purl.org/ffonto#DirectAttack">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SuppressionMethod"/>
        <rdfs:comment xml:lang="en">A firefighting tactic where suppression efforts are applied directly to the fire&apos;s edge.</rdfs:comment>
        <rdfs:label>Direct Attack</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DiscardedCigarette -->


    <owl:Class rdf:about="http://purl.org/ffonto#DiscardedCigarette">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#HumanIgnition"/>
        <rdfs:comment xml:lang="en">A cigarette that has been discarded; potential ignition source if still burning.</rdfs:comment>
        <rdfs:label>Discarded Cigarette</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Disturbance -->


    <owl:Class rdf:about="http://purl.org/ffonto#Disturbance">
        <rdfs:comment>An event or process that disrupts ecosystem structure or function.</rdfs:comment>
        <rdfs:label>Disturbance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DisturbanceHistory -->


    <owl:Class rdf:about="http://purl.org/ffonto#DisturbanceHistory">
        <rdfs:comment>Records of past disturbances (fires, logging, disease) affecting a spatial unit.</rdfs:comment>
        <rdfs:label>Disturbance history</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Division -->


    <owl:Class rdf:about="http://purl.org/ffonto#Division">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Region"/>
        <rdfs:comment>A major administrative subdivision within a region.</rdfs:comment>
        <rdfs:label>Division</rdfs:label>
        <rdfs:label>Fire Division</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DownedPowerLine -->


    <owl:Class rdf:about="http://purl.org/ffonto#DownedPowerLine">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#HumanIgnition"/>
        <rdfs:comment xml:lang="en">An electrical conductor that has fallen from its support and may present hazard.</rdfs:comment>
        <rdfs:label>Downed Power Line</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DownedPowerLineHazard -->


    <owl:Class rdf:about="http://purl.org/ffonto#DownedPowerLineHazard">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:comment xml:lang="en">A danger posed by electrical conductors that have fallen and may be energized.</rdfs:comment>
        <rdfs:label>Downed Power Line Hazard</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DozerLine -->


    <owl:Class rdf:about="http://purl.org/ffonto#DozerLine">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Fireline"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SuppressionTactic"/>
        <rdfs:comment xml:lang="en">A fire control line constructed by bulldozer to remove fuel and stop spread.</rdfs:comment>
        <rdfs:label>Dozer Line</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DripTorch -->


    <owl:Class rdf:about="http://purl.org/ffonto#DripTorch">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Equipment"/>
        <rdfs:comment xml:lang="en">A handheld device used for controlled ignition of prescribed burns or backburning.</rdfs:comment>
        <rdfs:label>Drip Torch</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DroneMonitoring -->


    <owl:Class rdf:about="http://purl.org/ffonto#DroneMonitoring">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#RemoteSensing"/>
        <rdfs:comment xml:lang="en">Use of unmanned aerial vehicles to observe, survey, or collect data over an area.</rdfs:comment>
        <rdfs:label>Drone Monitoring</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#DropZone -->


    <owl:Class rdf:about="http://purl.org/ffonto#DropZone">
        <rdfs:comment>Designated area for aerial retardant/water drops; clearance &amp; safety required.</rdfs:comment>
        <rdfs:label>Drop Zone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Drought -->


    <owl:Class rdf:about="http://purl.org/ffonto#Drought">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ClimateDriver"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Disturbance"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EnvironmentalFactor"/>
        <rdfs:comment>Extended period of insufficient rainfall causing vegetation stress.</rdfs:comment>
        <rdfs:comment>Extended periods without rainfall increasing vegetation flammability.</rdfs:comment>
        <rdfs:label>Drought</rdfs:label>
        <rdfs:label>Drought Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EDXLMessage -->


    <owl:Class rdf:about="http://purl.org/ffonto#EDXLMessage">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EmergencyAlert"/>
        <rdfs:comment xml:lang="en">An Emergency Data Exchange Language message used for interoperable emergency communications.</rdfs:comment>
        <rdfs:label>Emergency Data Exchange Language Message</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EarthObservationData -->


    <owl:Class rdf:about="http://purl.org/ffonto#EarthObservationData">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">Data collected from remote sensing platforms, such as satellites or UAVs, to monitor environmental conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">earth observation data</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EarthObservationPlatform -->


    <owl:Class rdf:about="http://purl.org/ffonto#EarthObservationPlatform"/>
    


    <!-- http://purl.org/ffonto#Eaves -->


    <owl:Class rdf:about="http://purl.org/ffonto#Eaves">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#BuildingComponent"/>
        <rdfs:comment>The edges of a roof that overhang a building wall and may be exposed to embers or smoke.</rdfs:comment>
        <rdfs:label>Eaves</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EcologicalEffect -->


    <owl:Class rdf:about="http://purl.org/ffonto#EcologicalEffect">
        <rdfs:comment>The physical, chemical, or biological changes in an ecosystem resulting from a fire event.</rdfs:comment>
        <rdfs:label>Ecological Effect</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EcologicalImpact -->


    <owl:Class rdf:about="http://purl.org/ffonto#EcologicalImpact">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EthicalConsideration"/>
        <rdfs:comment>Environmental consequences resulting from fires.</rdfs:comment>
        <rdfs:label>Ecological Impact</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EcologicalStress -->


    <owl:Class rdf:about="http://purl.org/ffonto#EcologicalStress">
        <rdfs:comment>Environmental pressure affecting ecosystem stability.</rdfs:comment>
        <rdfs:label>Ecological stress</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EconomicImpact -->


    <owl:Class rdf:about="http://purl.org/ffonto#EconomicImpact">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EthicalConsideration"/>
        <rdfs:comment xml:lang="en">The financial or economic consequences resulting from an event or action.</rdfs:comment>
        <rdfs:label>Economic Impact</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Ecosystem -->


    <owl:Class rdf:about="http://purl.org/ffonto#Ecosystem">
        <rdfs:comment>A biological community interacting with its physical environment.</rdfs:comment>
        <rdfs:label>Ecosystem</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EcosystemImpact -->


    <owl:Class rdf:about="http://purl.org/ffonto#EcosystemImpact">
        <rdfs:comment>Represents ecological impacts of wildfire including biodiversity changes, habitat loss, and ecosystem disruption.</rdfs:comment>
        <rdfs:label>Ecosystem Impact</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EcosystemService -->


    <owl:Class rdf:about="http://purl.org/ffonto#EcosystemService">
        <rdfs:comment>The benefits provided by ecosystems that support environmental health and human well-being.</rdfs:comment>
        <rdfs:label>Ecosystem Service</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EdgeDevice -->


    <owl:Class rdf:about="http://purl.org/ffonto#EdgeDevice">
        <rdfs:comment xml:lang="en">A computing device located near data sources for local processing and low-latency responses.</rdfs:comment>
        <rdfs:label>Edge Inference Device</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EmberHazard -->


    <owl:Class rdf:about="http://purl.org/ffonto#EmberHazard">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:comment>Flying embers that generate spot fires or ignite structures/vegetation.</rdfs:comment>
        <rdfs:label>Ember / Firebrand Hazard</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EmberTransport -->


    <owl:Class rdf:about="http://purl.org/ffonto#EmberTransport">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireBehavior"/>
        <rdfs:comment>Movement of burning embers carried by wind.</rdfs:comment>
        <rdfs:label>Ember Transport</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EmergencyActivity -->


    <owl:Class rdf:about="http://purl.org/ffonto#EmergencyActivity">
        <rdfs:comment>Activities indicating emergency conditions such as evacuations or escalations.</rdfs:comment>
        <rdfs:label>Emergency Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EmergencyAlert -->


    <owl:Class rdf:about="http://purl.org/ffonto#EmergencyAlert">
        <rdfs:comment xml:lang="en">A message intended to notify the public or specific groups about an immediate hazard.</rdfs:comment>
        <rdfs:label>Emergency Alert</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EmergencyContact -->


    <owl:Class rdf:about="http://purl.org/ffonto#EmergencyContact">
        <rdfs:comment>A contact point such as a hotline or emergency number for wildfire-related assistance.</rdfs:comment>
        <rdfs:label>Emergency Contact</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EmergencyFacility -->


    <owl:Class rdf:about="http://purl.org/ffonto#EmergencyFacility">
        <rdfs:comment xml:lang="en">A physical building or location, such as a shelter or fire station, utilized during an incident response.</rdfs:comment>
        <rdfs:label xml:lang="en">emergency facility</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EmergencyKit -->


    <owl:Class rdf:about="http://purl.org/ffonto#EmergencyKit">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#CommunityPreparedness"/>
        <rdfs:comment xml:lang="en">A collection of essential supplies and tools prepared for use during emergencies.</rdfs:comment>
        <rdfs:label>Emergency Kit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EmergencyOperation -->


    <owl:Class rdf:about="http://purl.org/ffonto#EmergencyOperation">
        <rdfs:comment xml:lang="en">Planned actions and activities performed to respond to and manage an emergency.</rdfs:comment>
        <rdfs:label>Emergency Operation Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EmergencyResponder -->


    <owl:Class rdf:about="http://purl.org/ffonto#EmergencyResponder">
        <rdfs:comment xml:lang="en">A trained person who responds to incidents to provide assistance or protection.</rdfs:comment>
        <rdfs:label>Emergency Responder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EmergencyVehicle -->


    <owl:Class rdf:about="http://purl.org/ffonto#EmergencyVehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Vehicle"/>
        <rdfs:comment>Fire trucks, ambulances, and responder vehicles.</rdfs:comment>
        <rdfs:label>Emergency Vehicle</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EmissionEstimate -->


    <owl:Class rdf:about="http://purl.org/ffonto#EmissionEstimate">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#CarbonEmission"/>
        <rdfs:comment xml:lang="en">An estimate of pollutant or greenhouse gas emissions produced by a source or event.</rdfs:comment>
        <rdfs:label>Emission Estimate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EmissionInventory -->


    <owl:Class rdf:about="http://purl.org/ffonto#EmissionInventory">
        <rdfs:comment xml:lang="en">A compiled estimate of emissions by source, type, and timeframe.</rdfs:comment>
        <rdfs:label>Emission Inventory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Encryption -->


    <owl:Class rdf:about="http://purl.org/ffonto#Encryption">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#CyberSecurityPractice"/>
        <rdfs:comment xml:lang="en">The process of encoding information to prevent unauthorized access.</rdfs:comment>
        <rdfs:label>Encryption</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EnsembleForecast -->


    <owl:Class rdf:about="http://purl.org/ffonto#EnsembleForecast">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireBehaviorModel"/>
        <rdfs:comment xml:lang="en">A forecast produced by combining multiple model runs to represent uncertainty and improve robustness.</rdfs:comment>
        <rdfs:label>Ensemble Forecast</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EntrapmentRisk -->


    <owl:Class rdf:about="http://purl.org/ffonto#EntrapmentRisk">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:comment>Risk a crew or individual may be cut off from escape routes by rapid fire behavior.</rdfs:comment>
        <rdfs:label>Entrapment Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EnvironmentType -->


    <owl:Class rdf:about="http://purl.org/ffonto#EnvironmentType">
        <rdfs:comment>General environmental setting (forested, grassland, agricultural).</rdfs:comment>
        <rdfs:label>Environment Type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EnvironmentalCondition -->


    <owl:Class rdf:about="http://purl.org/ffonto#EnvironmentalCondition">
        <rdfs:comment>A physical environmental factor that influences ecological processes, such as temperature, moisture, or snow cover.</rdfs:comment>
        <rdfs:label>Environmental Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EnvironmentalFactor -->


    <owl:Class rdf:about="http://purl.org/ffonto#EnvironmentalFactor">
        <rdfs:comment>Environmental conditions affecting fire behavior.</rdfs:comment>
        <rdfs:label>Environmental Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EnvironmentalImpact -->


    <owl:Class rdf:about="http://purl.org/ffonto#EnvironmentalImpact">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ForestFireEffect"/>
        <rdfs:comment xml:lang="en">The observable or measurable effect of an event or action on the natural environment, such as vegetation loss or soil degradation.</rdfs:comment>
        <rdfs:label xml:lang="en">environmental impact</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EnvironmentalRisk -->


    <owl:Class rdf:about="http://purl.org/ffonto#EnvironmentalRisk">
        <rdfs:comment>Potential environmental hazards affecting ecosystems.</rdfs:comment>
        <rdfs:label>Environmental risk</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Equipment -->


    <owl:Class rdf:about="http://purl.org/ffonto#Equipment">
        <rdfs:comment>Tools or devices used during firefighting operations.</rdfs:comment>
        <rdfs:label>Equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EquipmentUse -->


    <owl:Class rdf:about="http://purl.org/ffonto#EquipmentUse">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#HumanIgnition"/>
        <rdfs:comment xml:lang="en">The application or operation of equipment for a specific task or response activity.</rdfs:comment>
        <rdfs:label>Equipment / Vehicle Use</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ErosionControl -->


    <owl:Class rdf:about="http://purl.org/ffonto#ErosionControl">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PostFireRehabilitation"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#RegulatingService"/>
        <rdfs:comment>Prevention of soil erosion through vegetation cover.</rdfs:comment>
        <rdfs:label>Erosion Control</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ErosionFeature -->


    <owl:Class rdf:about="http://purl.org/ffonto#ErosionFeature">
        <rdfs:comment>Represents erosion indicators such as rills, exposed soil, and denuded banks.</rdfs:comment>
        <rdfs:label>Erosion Feature</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ErosionRisk -->


    <owl:Class rdf:about="http://purl.org/ffonto#ErosionRisk">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EcologicalImpact"/>
        <rdfs:comment>Likelihood of increased soil erosion after vegetation removal or high-severity fire.</rdfs:comment>
        <rdfs:label>Erosion risk</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EstimationMethod -->


    <owl:Class rdf:about="http://purl.org/ffonto#EstimationMethod">
        <rdfs:comment>A method used to estimate wildfire characteristics such as spread, size, or risk.</rdfs:comment>
        <rdfs:label>Estimation method</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EthicalConsideration -->


    <owl:Class rdf:about="http://purl.org/ffonto#EthicalConsideration">
        <rdfs:comment xml:lang="en">A factor reflecting moral implications or responsibilities associated with an action or system.</rdfs:comment>
        <rdfs:label>Ethical Consideration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EvacuationAction -->


    <owl:Class rdf:about="http://purl.org/ffonto#EvacuationAction">
        <rdfs:comment>Actions and procedures for safe evacuation (routes, kits, sheltering).</rdfs:comment>
        <rdfs:label>Evacuation Action</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EvacuationDrill -->


    <owl:Class rdf:about="http://purl.org/ffonto#EvacuationDrill">
        <rdfs:comment>Organized practice of evacuation procedures.</rdfs:comment>
        <rdfs:label>Evacuation Drill</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EvacuationOperation -->


    <owl:Class rdf:about="http://purl.org/ffonto#EvacuationOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SuppressionOperation"/>
        <rdfs:comment xml:lang="en">An organized activity to move people from danger to safety.</rdfs:comment>
        <rdfs:label>Evacuation Operation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EvacuationOrder -->


    <owl:Class rdf:about="http://purl.org/ffonto#EvacuationOrder">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ProtectiveAction"/>
