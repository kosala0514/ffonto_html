        <rdfs:label xml:lang="en">simulated by activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#simulatesFire -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#simulatesFire">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse property linking a computational or analytical activity to the fire it simulates.</rdfs:comment>
        <rdfs:label xml:lang="en">simulates fire</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#stagedNear -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#stagedNear">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Vehicle"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#CommandPost"/>
