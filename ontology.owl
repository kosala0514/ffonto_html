    <!-- http://purl.org/ffonto#isHazardOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isHazardOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasHazard"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/ffonto#ForestFire"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#Road"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#WildfireScene"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Inverse - Indicates hazards affecting roads or wildfire scenes.</rdfs:comment>
