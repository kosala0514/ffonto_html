        <rdfs:range rdf:resource="http://purl.org/ffonto#WildfireIncident"/>
        <rdfs:comment xml:lang="en">Relates a specific zone, such as a flank or head, or a secondary ignition to the primary wildfire incident.</rdfs:comment>
