        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WeatherObservation"/>
        <rdfs:comment>Link from incident to weather measurements.</rdfs:comment>
        <rdfs:label>has weather observation</rdfs:label>
    </owl:ObjectProperty>
    


