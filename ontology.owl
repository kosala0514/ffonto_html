    <!-- http://purl.org/ffonto#involvesFirefighterOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#involvesFirefighterOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#involvesFirefighter"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Firefighter"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FirefightingOperation"/>
        <rdfs:comment xml:lang="en">Inverse relation linking involvement events back to the firefighters or crews participating.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of involves firefighter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isAccessConstraintOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isAccessConstraintOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasAccessConstraint"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AccessConstraintDetail"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking access constraints back to the assets or routes they limit.</rdfs:comment>
        <rdfs:label>is access constraint of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isAccessRestrictedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isAccessRestrictedBy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#DataRepository"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AccessConstraint"/>
        <rdfs:comment xml:lang="en">Links a geographic area or facility to the policy, hazard, or authority that limits entry.</rdfs:comment>
        <rdfs:label xml:lang="en">is access restricted by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isAerialResourceOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isAerialResourceOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasAerialResource"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AerialResource"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking aerial resource assignments back to the incidents or commands deploying them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of is aerial resource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isAerialVisibilityOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isAerialVisibilityOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasAerialVisibility"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AerialVisibility"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking aerial visibility assessments back to the flight area or observation.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of is aerial visibility</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isAffectedByAnomaly -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isAffectedByAnomaly">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireRegime"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ClimateAnomaly"/>
        <rdfs:comment xml:lang="en">Connects a system, dataset, or operational baseline to an unexpected deviation or irregular event impacting it.</rdfs:comment>
        <rdfs:label xml:lang="en">is affected by anomaly</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isAffectedByEvapotranspiration -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isAffectedByEvapotranspiration">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FuelMoisture"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Evapotranspiration"/>
        <rdfs:comment xml:lang="en">Indicates that fuel moisture, fire behavior, or local climate is influenced by the transfer of water from land and plants to the atmosphere.</rdfs:comment>
        <rdfs:label xml:lang="en">is affected by evapotranspiration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isAirspaceRestrictedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isAirspaceRestrictedBy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Airspace"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#TemporaryFlightRestriction"/>
        <rdfs:comment xml:lang="en">Links a designated flight zone to the authority, incident, or condition enforcing a temporary flight restriction (TFR).</rdfs:comment>
        <rdfs:label xml:lang="en">is airspace restricted by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isAlertStatusOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isAlertStatusOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasAlertStatus"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AlertSystemStatus"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Connects a specific warning level or notification state to the hazard, operational system, or community it applies to.</rdfs:comment>
        <rdfs:label xml:lang="en">is alert status of</rdfs:label>
        <rdfs:label>is alert system status of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isAnalyzedByAudio -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isAnalyzedByAudio">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#TelemetryData"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AudioAnalytics"/>
        <rdfs:comment xml:lang="en">Relates an event, operational environment, or mechanical system to the acoustic processing techniques used to monitor it.</rdfs:comment>
        <rdfs:label xml:lang="en">is analyzed by audio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isAnalyzedTemporally -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isAnalyzedTemporally">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#TelemetryData"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#TimeSeriesAnalysis"/>
        <rdfs:comment xml:lang="en">Indicates that a dataset, event sequence, or phenomenon is examined based on its chronological patterns and time-based progression.</rdfs:comment>
        <rdfs:label xml:lang="en">is analyzed temporally</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isAnnotationOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isAnnotationOf">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Annotation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:comment>inverse of has annotation</rdfs:comment>
        <rdfs:label>is annotation of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isApplicableToScene -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isApplicableToScene">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#HazardousWasteGuideline"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WildfireScene"/>
        <rdfs:comment>Indicates that a hazardous waste guideline must be followed in a specific wildfire scene after the fire.</rdfs:comment>
        <rdfs:label xml:lang="en">is applicable to scene</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isAssessedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isAssessedBy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#BurnSeverityMap"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#BAERAssessment"/>
        <rdfs:comment xml:lang="en">Relates a risk level, operational situation, or geographic area to the analytical process, system, or personnel evaluating it.</rdfs:comment>
        <rdfs:label xml:lang="en">is assessed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isAudioObservationOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isAudioObservationOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasAudioObservation"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AudioObservation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking audio observations back to the events or sources they document.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of is audio observation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isAudioRecordOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isAudioRecordOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasAudioRecord"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AudioRecord"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AudioObservation"/>
        <rdfs:comment>Relates an audio recording back to the observation derived from it.</rdfs:comment>
        <rdfs:label xml:lang="en">is audio record of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isAuditOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isAuditOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasAudit"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AuditRecord"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/ffonto#AudioRecord"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#ImageAsset"/>
                    <rdf:Description rdf:about="http://purl.org/ffonto#VisionModelScores"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Inverse - Links an item to an AuditRecord (checksums, class-map checksum, etc.).</rdfs:comment>
        <rdfs:label>is audit record of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isBriefedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isBriefedBy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WildfireIncident"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#IncidentBriefing"/>
        <rdfs:comment xml:lang="en">Relates an incident, operational period, or responder to the specific role or document providing status updates and situational awareness.</rdfs:comment>
        <rdfs:label xml:lang="en">is briefed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isBriefingAreaOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isBriefingAreaOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasBriefingArea"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#BriefingArea"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WildfireScene"/>
        <rdfs:comment xml:lang="en">Inverse relation linking a briefing area designation to the incident or group it serves.</rdfs:comment>
        <rdfs:label xml:lang="en">is briefing area of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isBurnSeverityOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isBurnSeverityOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasBurnSeverity"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireSeverity"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking a burn severity classification to the affected area or event.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of is burn severity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isCameraObservationOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isCameraObservationOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasCameraObservation"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#CameraObservation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking camera-based observations back to the subject or event observed.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of is camera observation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isCauseOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isCauseOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasCause"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFireCause"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse - Links a wildfire incident to the cause that triggered it.</rdfs:comment>
        <rdfs:label xml:lang="en">is cause of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isClothingOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isClothingOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasClothing"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ClothingRecommendation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EvacuationAction"/>
        <rdfs:comment>Inverse - Links actions or persons to ClothingRecommendation instances.</rdfs:comment>
        <rdfs:label>is clothing of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isCloudCoverProcessedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isCloudCoverProcessedBy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#CloudCoverQuality"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AtmosphericTransportModel"/>
