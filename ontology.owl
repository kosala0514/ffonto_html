        <rdfs:label>staged near</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#stagedNearOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#stagedNearOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#stagedNear"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#CommandPost"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Vehicle"/>
        <rdfs:comment xml:lang="en">Connects a deployed resource, equipment cache, or staging area back to the geographic feature or incident it is positioned for.</rdfs:comment>
        <rdfs:label xml:lang="en">staged near of</rdfs:label>
        <rdfs:label>staged near of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#storesWater -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#storesWater">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WaterTank"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WaterSource"/>
        <rdfs:comment>Indicates that a water tank stores water that can be used as a water source.</rdfs:comment>
        <rdfs:label>stores water</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#storesWaterOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#storesWaterOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#storesWater"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WaterSource"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WaterTank"/>
        <rdfs:comment>Inverse - Indicates that a water tank stores water that can be used as a water source.</rdfs:comment>
        <rdfs:label>stores water of</rdfs:label>
    </owl:ObjectProperty>
    


