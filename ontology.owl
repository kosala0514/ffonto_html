        <rdfs:label>Fire Shelter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireSimulationSoftware -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireSimulationSoftware">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ForestFireTechnology"/>
