    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#supportsBiodiversity -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#supportsBiodiversity">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Biodiversity"/>
        <rdfs:comment>Indicates that an ecosystem or vegetation type supports biodiversity.</rdfs:comment>
        <rdfs:label>supports biodiversity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#supportsBiodiversityOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#supportsBiodiversityOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#supportsBiodiversity"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Biodiversity"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:comment>Inverse - Indicates that an ecosystem or vegetation type supports biodiversity.</rdfs:comment>
        <rdfs:label>supports biodiversity of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#supportsCommunity -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#supportsCommunity">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#hasNeighborSupportPlan"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#NeighborSupportPlan"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EvacuationZone"/>
        <rdfs:comment xml:lang="en">Links a plan, resource, or organization to the civilian population it aids or protects.</rdfs:comment>
        <rdfs:label xml:lang="en">supports community</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#supportsDecision -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#supportsDecision">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isSupportedByDSS"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#DecisionSupportSystem"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#IncidentCommand"/>
        <rdfs:comment xml:lang="en">Links analytical data, a DSS (Decision Support System), or an observation to the operational command choice it informs.</rdfs:comment>
        <rdfs:label xml:lang="en">supports decision</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#supportsEcosystemHealth -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#supportsEcosystemHealth">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WaterBody"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EcosystemService"/>
