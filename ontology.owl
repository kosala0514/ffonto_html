    <!-- http://purl.org/ffonto#suggestsEnvironmentalProcess -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#suggestsEnvironmentalProcess">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
