        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Relates a backburn strategy to the area intentionally burned to remove fuel.</rdfs:comment>
        <rdfs:label>has backburn area</rdfs:label>
