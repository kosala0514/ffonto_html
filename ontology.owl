    </owl:Class>
    


    <!-- http://purl.org/ffonto#UtilityInfrastructure -->


    <owl:Class rdf:about="http://purl.org/ffonto#UtilityInfrastructure">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Infrastructure"/>
