        <rdfs:range rdf:resource="http://purl.org/ffonto#VegetationDistribution"/>
        <rdfs:comment xml:lang="en">Inverse relation linking entities to the soil quality factors that influence them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of influenced by soil quality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#influencedByWaterAvailability -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#influencedByWaterAvailability">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#VegetationDistribution"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WaterAvailability"/>
        <rdfs:comment>Indicates water availability effects on vegetation distribution.</rdfs:comment>
        <rdfs:label>influenced by water availability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#influencedByWaterAvailabilityOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#influencedByWaterAvailabilityOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#influencedByWaterAvailability"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WaterAvailability"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#VegetationDistribution"/>
        <rdfs:comment xml:lang="en">Inverse relation linking conditions to the water availability factors influencing them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of influenced by water availability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#influencedByWeather -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#influencedByWeather">
