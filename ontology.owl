        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Links a risk assessment process, model, or analyst to the specific hazard, operational plan, or geographic area being scrutinized.</rdfs:comment>
