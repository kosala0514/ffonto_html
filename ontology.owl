        <rdfs:comment>Inverse - Links image to caption output (model &amp; caption text).</rdfs:comment>
        <rdfs:label>caption produced of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#carriesSensor -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#carriesSensor">
        <rdfs:comment xml:lang="en">Links a platform, such as a UAV or ground vehicle, to the observational hardware it physically transports.</rdfs:comment>
        <rdfs:label xml:lang="en">carries sensor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#carriesSensorOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#carriesSensorOf">
        <rdfs:comment xml:lang="en">Relates a carrying platform to the specific type, network, or owner of the sensor it is equipped with.</rdfs:comment>
        <rdfs:label xml:lang="en">carries sensor of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#causedByBurnSeverity -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#causedByBurnSeverity">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#PostFireFloodRisk"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#BurnSeverityMap"/>
        <rdfs:comment xml:lang="en">Indicates that a secondary effect, such as soil degradation or debris flow, is a direct result of the intense heat damage from a fire.</rdfs:comment>
        <rdfs:label xml:lang="en">caused by burn severity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#causedByBurnSeverityOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#causedByBurnSeverityOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#causedByBurnSeverity"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#BurnSeverityMap"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#PostFireFloodRisk"/>
        <rdfs:comment xml:lang="en">Connects a secondary environmental consequence (like soil erosion) to the specific intense heat damage of a designated fire.</rdfs:comment>
        <rdfs:label xml:lang="en">caused by burn severity of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#causedByDisturbance -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#causedByDisturbance">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#VegetationCondition"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Disturbance"/>
        <rdfs:comment>Indicates that vegetation degradation or ecological change was caused by a disturbance.</rdfs:comment>
        <rdfs:label>caused by disturbance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#causedByDisturbanceOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#causedByDisturbanceOf">
