        <rdfs:label>Physics Informed ML Model</rdfs:label>
        <rdfs:label>Physics-informed ML</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Pine -->


    <owl:Class rdf:about="http://purl.org/ffonto#Pine">
