        <rdfs:label>Fire Simulation Software</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireSpread -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireSpread">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireBehavior"/>
