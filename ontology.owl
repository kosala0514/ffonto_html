        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Represents the proportion of land covered by tree canopy.</rdfs:comment>
        <rdfs:label>has canopy coverage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasCautionTape -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasCautionTape">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
