        <rdfs:label xml:lang="en">indicates combustion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#indicatesCombustionOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#indicatesCombustionOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#indicatesCombustion"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#CombustionProcess"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#SmokeColor"/>
        <rdfs:comment xml:lang="en">Links a metric, observation, or sensor reading to the specific material or geographic area currently burning.</rdfs:comment>
        <rdfs:label xml:lang="en">indicates combustion of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#indicatesEcologicalStress -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#indicatesEcologicalStress">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#VegetationCondition"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EcologicalStress"/>
