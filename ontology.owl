<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.org/ffonto#"
     xml:base="http://purl.org/ffonto"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:ns1="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:ffonto="http://purl.org/ffonto#"
     xmlns:schema="https://schema.org/">
    <owl:Ontology rdf:about="http://purl.org/ffonto#">
        <owl:versionIRI rdf:resource="http://purl.org/ffonto#V1.2"/>
        <ns:license></ns:license>
        <dc:abstract xml:lang="en">The Forest Fire Ontology (FFONTO) is designed to integrate multi-modal sensor data for early fire detection. It serves as an extensible framework with &apos;ForestFire&apos; as the root class, incorporating concepts for visual detection, audio monitoring, and environmental conditions.</dc:abstract>
        <dc:contributor rdf:nodeID="genid1"/>
        <dc:creator rdf:nodeID="genid2"/>
        <dc:description xml:lang="en">This ontology describes forest fire detection observations including image, audio, and weather data.</dc:description>
        <dc:title xml:lang="en">Forest Fire Ontology (FFONTO)</dc:title>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-01-27</terms:issued>
        <terms:license></terms:license>
        <vann:preferredNamespacePrefix xml:lang="en">ffonto</vann:preferredNamespacePrefix>
        <rdfs:comment xml:lang="en">Ontology for forest fire detection &amp; observation (image, audio, weather). Root class: ForestFire. Designed for extensibility.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://github.com/kosala0514/FFOnto"/>
        <owl:versionInfo>Initial Release 1.0</owl:versionInfo>
        <ns1:status>Active</ns1:status>
        <prov:generatedAtTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-01-27T00:00:00+00:00</prov:generatedAtTime>
        <prov:wasAttributedTo rdf:resource="https://github.com/kosala0514"/>
    </owl:Ontology>
    <rdf:Description rdf:nodeID="genid1">
        <foaf:name xml:lang="en">Prof. Dulani Meedeniya</foaf:name>
        <schema:identifier rdf:resource="https://orcid.org/0000-0002-4520-3819"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid2">
        <foaf:name xml:lang="en">Ms. Charuni Kosala Jayaweera</foaf:name>
        <schema:identifier rdf:resource="https://orcid.org/0009-0003-5790-62840"/>
    </rdf:Description>
    


