        <rdfs:domain rdf:resource="http://purl.org/ffonto#Vehicle"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Firefighter"/>
        <rdfs:comment>Inverse - Indicates that firefighters operate or use a vehicle during firefighting.</rdfs:comment>
        <rdfs:label>uses vehicle of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#usesWaterSource -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#usesWaterSource">
