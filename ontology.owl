        <rdfs:label>gutters packed with debris</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#guttersPackedWithDebris -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#guttersPackedWithDebris">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether gutters contain flammable debris.</rdfs:comment>
        <rdfs:label>gutters packed with debris</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasAccuracy -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasAccuracy">
