    </owl:Class>
    


    <!-- http://purl.org/ffonto#VegetationDistribution -->


    <owl:Class rdf:about="http://purl.org/ffonto#VegetationDistribution">
        <rdfs:comment>The spatial pattern or arrangement of vegetation within a defined area or ecosystem.</rdfs:comment>
        <rdfs:label>Vegetation distribution</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VegetationDryness -->


    <owl:Class rdf:about="http://purl.org/ffonto#VegetationDryness">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ForestFireRiskFactor"/>
        <rdfs:comment xml:lang="en">A measure of moisture deficiency in vegetation that influences flammability.</rdfs:comment>
        <rdfs:label>Vegetation Dryness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VegetationDynamics -->


    <owl:Class rdf:about="http://purl.org/ffonto#VegetationDynamics">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EcologicalEffect"/>
        <rdfs:comment>Changes related to plant life, growth, and community structure.</rdfs:comment>
        <rdfs:label>Vegetation Dynamics</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VegetationFunctionalGroup -->


    <owl:Class rdf:about="http://purl.org/ffonto#VegetationFunctionalGroup">
        <rdfs:comment>Functional grouping such as coniferous, deciduous, shrub, or grass.</rdfs:comment>
        <rdfs:label>Vegetation functional group</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VegetationIndex -->


    <owl:Class rdf:about="http://purl.org/ffonto#VegetationIndex">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ObservableProperty"/>
        <rdfs:comment>Satellite-derived index used to monitor vegetation health and density.</rdfs:comment>
        <rdfs:label>Vegetation Index</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VegetationPatternObservation -->


    <owl:Class rdf:about="http://purl.org/ffonto#VegetationPatternObservation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ImageObservation"/>
        <rdfs:comment>An observation describing spatial patterns of vegetation such as dense clusters, sparse coverage, or uneven distribution detected in an image.</rdfs:comment>
        <rdfs:label>Vegetation Pattern Observation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VegetationRecovery -->


    <owl:Class rdf:about="http://purl.org/ffonto#VegetationRecovery">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EcologicalImpact"/>
        <rdfs:comment>Regrowth of vegetation following fire disturbance.</rdfs:comment>
        <rdfs:label>Vegetation Recovery</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VegetationRegrowth -->


    <owl:Class rdf:about="http://purl.org/ffonto#VegetationRegrowth">
        <rdfs:comment>The regrowth of plant species following wildfire disturbance.</rdfs:comment>
        <rdfs:label>Vegetation Regrowth</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VegetationStress -->


    <owl:Class rdf:about="http://purl.org/ffonto#VegetationStress">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EcologicalStress"/>
        <rdfs:comment>Stress affecting plant growth or health.</rdfs:comment>
        <rdfs:label>Vegetation stress</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VegetationType -->


    <owl:Class rdf:about="http://purl.org/ffonto#VegetationType">
        <rdfs:comment>Type of vegetation burning in the wildfire.</rdfs:comment>
        <rdfs:label>Vegetation Type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Vehicle -->


    <owl:Class rdf:about="http://purl.org/ffonto#Vehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:comment>Ground vehicles used in wildfire operations.</rdfs:comment>
        <rdfs:label>Vehicle</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VehicleAccess -->


    <owl:Class rdf:about="http://purl.org/ffonto#VehicleAccess">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AccessConstraintDetail"/>
        <rdfs:comment xml:lang="en">The ability for vehicles to reach or traverse a location or route.</rdfs:comment>
        <rdfs:label>Vehicle Access</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VehicleDamage -->


    <owl:Class rdf:about="http://purl.org/ffonto#VehicleDamage">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ForestFireEffect"/>
        <rdfs:comment>Damage to vehicles caused by wildfire heat or smoke.</rdfs:comment>
        <rdfs:label>Vehicle Damage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VehiclePreparation -->


    <owl:Class rdf:about="http://purl.org/ffonto#VehiclePreparation">
        <rdfs:comment>Preparations to make vehicles ready for evacuation (fuel, parking orientation, kit stored).</rdfs:comment>
        <rdfs:label>Vehicle Preparation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VehicleSafety -->


    <owl:Class rdf:about="http://purl.org/ffonto#VehicleSafety">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ForestFirePrevention"/>
        <rdfs:comment xml:lang="en">Design features and practices that reduce risk to vehicle occupants and responders.</rdfs:comment>
        <rdfs:label>Vehicle Fire Safety</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VehicleSpark -->


    <owl:Class rdf:about="http://purl.org/ffonto#VehicleSpark">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#HumanCause"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#HumanIgnition"/>
        <rdfs:comment>Sparks from exhaust, dragging chains, or catalytic converters igniting roadside fuels.</rdfs:comment>
        <rdfs:label>Vehicle Spark</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Village -->


    <owl:Class rdf:about="http://purl.org/ffonto#Village">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SpatialEntity"/>
        <rdfs:comment>A small rural settlement.</rdfs:comment>
        <rdfs:label>Village</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VisibilityCategory -->


    <owl:Class rdf:about="http://purl.org/ffonto#VisibilityCategory">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AirQualityIndex"/>
        <rdfs:comment>Low, Medium, High scene visibility due to smoke.</rdfs:comment>
        <rdfs:label>Visibility Category (enum)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VisibilityCondition -->


    <owl:Class rdf:about="http://purl.org/ffonto#VisibilityCondition">
        <rdfs:comment>Visibility measures for aerial and ground ops.</rdfs:comment>
        <rdfs:label>Visibility Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VisibilityRange -->


    <owl:Class rdf:about="http://purl.org/ffonto#VisibilityRange">
        <rdfs:comment>Distance-based visibility indicator used to estimate air quality.</rdfs:comment>
        <rdfs:label>Visibility Range</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VisibilityReduction -->


    <owl:Class rdf:about="http://purl.org/ffonto#VisibilityReduction">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AirPollutantProperty"/>
        <rdfs:comment>Decreased atmospheric visibility caused by smoke particles.</rdfs:comment>
        <rdfs:label>Visibility Reduction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VisionModelScores -->


    <owl:Class rdf:about="http://purl.org/ffonto#VisionModelScores">
        <rdfs:comment>Scores produced by a vision classifier/model (fire/smoke/no-fire etc.) and the producing model name/version.</rdfs:comment>
        <rdfs:label>Vision Model Scores</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VolcanicActivity -->


    <owl:Class rdf:about="http://purl.org/ffonto#VolcanicActivity">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#NaturalCause"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#NaturalIgnition"/>
        <rdfs:comment xml:lang="en">Geologic processes and events associated with volcanic unrest or eruptions.</rdfs:comment>
        <rdfs:label>Volcanic Eruption</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VulnerabilityAssessment -->


    <owl:Class rdf:about="http://purl.org/ffonto#VulnerabilityAssessment">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireRiskAssessment"/>
        <rdfs:comment xml:lang="en">An evaluation of susceptibilities to harm from hazards or threats.</rdfs:comment>
        <rdfs:label>Vulnerability Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#VulnerablePopulation -->


    <owl:Class rdf:about="http://purl.org/ffonto#VulnerablePopulation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PopulationGroup"/>
        <rdfs:comment xml:lang="en">Groups of people who may require special assistance or are at increased risk during emergencies.</rdfs:comment>
        <rdfs:label>Vulnerable Population</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WUICommunity -->


    <owl:Class rdf:about="http://purl.org/ffonto#WUICommunity">
        <rdfs:comment xml:lang="en">A community located in the Wildland–Urban Interface (area where wildland and human development meet).</rdfs:comment>
        <rdfs:label>WUI Community</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WaterAvailability -->


    <owl:Class rdf:about="http://purl.org/ffonto#WaterAvailability">
        <rdfs:comment>Hydrological conditions (moisture, groundwater) affecting vegetation and fire risk.</rdfs:comment>
        <rdfs:label>Water availability</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WaterBody -->


    <owl:Class rdf:about="http://purl.org/ffonto#WaterBody">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#LandscapeFeature"/>
        <rdfs:comment>A natural accumulation of water such as lakes or rivers.</rdfs:comment>
        <rdfs:label>Water Body</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WaterChannel -->


    <owl:Class rdf:about="http://purl.org/ffonto#WaterChannel">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#WaterBody"/>
        <rdfs:comment>A narrow water passage connecting bodies of water.</rdfs:comment>
        <rdfs:label>Water Channel</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WaterHose -->


    <owl:Class rdf:about="http://purl.org/ffonto#WaterHose">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FirefightingResource"/>
        <rdfs:comment>Equipment used to deliver water to wet down structures or suppress wildfire flames.</rdfs:comment>
        <rdfs:label>Water Hose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WaterProtection -->


    <owl:Class rdf:about="http://purl.org/ffonto#WaterProtection">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#RegulatingService"/>
        <rdfs:comment>The regulation of water flow and filtration of pollutants.</rdfs:comment>
        <rdfs:label>Water Protection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WaterSafetyAdvisory -->


    <owl:Class rdf:about="http://purl.org/ffonto#WaterSafetyAdvisory">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#RecoveryGuideline"/>
        <rdfs:comment>Advisories regarding drinking water safety after wildfire events.</rdfs:comment>
        <rdfs:label>Water Safety Advisory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WaterSource -->


    <owl:Class rdf:about="http://purl.org/ffonto#WaterSource">
        <rdfs:comment>A natural or artificial water source used for firefighting.</rdfs:comment>
        <rdfs:label>Water Source</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WaterSupply -->


    <owl:Class rdf:about="http://purl.org/ffonto#WaterSupply">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:comment>Local water infrastructure used for community and firefighting needs.</rdfs:comment>
        <rdfs:label>Water Supply System</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WaterTank -->


    <owl:Class rdf:about="http://purl.org/ffonto#WaterTank">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:comment>A storage container or reservoir used to store water for firefighting, domestic supply, or emergency use.</rdfs:comment>
        <rdfs:label>Water Tank</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WaterTender -->


    <owl:Class rdf:about="http://purl.org/ffonto#WaterTender">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Vehicle"/>
        <rdfs:comment xml:lang="en">A vehicle designed to transport and supply water for firefighting operations.</rdfs:comment>
        <rdfs:label>Water Tender</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Watershed -->


    <owl:Class rdf:about="http://purl.org/ffonto#Watershed">
        <rdfs:comment>A land area where precipitation collects and drains into a common outlet such as a river, lake, or ocean.</rdfs:comment>
        <rdfs:label>Watershed</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WatershedManagement -->


    <owl:Class rdf:about="http://purl.org/ffonto#WatershedManagement">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#LandManagementPractice"/>
        <rdfs:comment xml:lang="en">Planning and practices to manage water resources and land use in a watershed.</rdfs:comment>
        <rdfs:label>Watershed Management</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WeatherCondition -->


    <owl:Class rdf:about="http://purl.org/ffonto#WeatherCondition">
        <rdfs:comment xml:lang="en">Current atmospheric state including variables such as temperature, wind, and precipitation.</rdfs:comment>
        <rdfs:label>Weather Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WeatherFactor -->


    <owl:Class rdf:about="http://purl.org/ffonto#WeatherFactor"/>
    


    <!-- http://purl.org/ffonto#WeatherObservation -->


    <owl:Class rdf:about="http://purl.org/ffonto#WeatherObservation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:comment>Meteorological measurements at the incident site.</rdfs:comment>
        <rdfs:label>Weather Observation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WellWater -->


    <owl:Class rdf:about="http://purl.org/ffonto#WellWater">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#WaterSource"/>
        <rdfs:comment>Groundwater extracted from a well used for drinking or household use.</rdfs:comment>
        <rdfs:label>Well Water</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WetLine -->


    <owl:Class rdf:about="http://purl.org/ffonto#WetLine">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Fireline"/>
        <rdfs:comment xml:lang="en">A line of water applied to vegetation or ground to act as a temporary firebreak.</rdfs:comment>
        <rdfs:label>Wet Line</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Wetland -->


    <owl:Class rdf:about="http://purl.org/ffonto#Wetland">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:comment>An ecosystem where land is saturated with water.</rdfs:comment>
        <rdfs:label>Wetland</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WildfireDamage -->


    <owl:Class rdf:about="http://purl.org/ffonto#WildfireDamage">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Disturbance"/>
        <rdfs:comment>Vegetation damage caused by wildfire events.</rdfs:comment>
        <rdfs:label>Wildfire damage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WildfireIncident -->


    <owl:Class rdf:about="http://purl.org/ffonto#WildfireIncident">
        <rdfs:comment xml:lang="en">An uncontrolled fire occurring in nature that requires an emergency response.</rdfs:comment>
        <rdfs:label xml:lang="en">wildfire incident</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WildfireScene -->


    <owl:Class rdf:about="http://purl.org/ffonto#WildfireScene">
        <rdfs:comment>The environmental context where a wildfire event occurs and observations are made.</rdfs:comment>
        <rdfs:label>Wildfire Scene</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WildfireSmoke -->


    <owl:Class rdf:about="http://purl.org/ffonto#WildfireSmoke">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Smoke"/>
        <rdfs:comment>Smoke generated by wildfire combustion.</rdfs:comment>
        <rdfs:label>Wildfire Smoke</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WildfireStatistic -->


    <owl:Class rdf:about="http://purl.org/ffonto#WildfireStatistic">
        <rdfs:comment xml:lang="en">A quantitative data point or aggregated metric regarding a wildfire, such as acres burned or containment percentage.</rdfs:comment>
        <rdfs:comment>Base class for all wildfire data points.</rdfs:comment>
        <rdfs:label xml:lang="en">Wildfire Statistic</rdfs:label>
        <rdfs:label xml:lang="en">wildfire statistic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WildlandUrbanInterface -->


    <owl:Class rdf:about="http://purl.org/ffonto#WildlandUrbanInterface">
        <rdfs:comment>Areas where human development intermingles with wildland fuels.</rdfs:comment>
        <rdfs:label>Wildland-Urban Interface (WUI)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Wildlife -->


    <owl:Class rdf:about="http://purl.org/ffonto#Wildlife">
        <rdfs:comment>Wild animals affected by fire and smoke.</rdfs:comment>
        <rdfs:label>Wildlife</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WildlifeImpact -->


    <owl:Class rdf:about="http://purl.org/ffonto#WildlifeImpact">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EnvironmentalImpact"/>
        <rdfs:comment>Effects of fires/smoke on fauna (respiratory, cardiac, developmental, mortality).</rdfs:comment>
        <rdfs:label>Wildlife Impact</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Wind -->


    <owl:Class rdf:about="http://purl.org/ffonto#Wind">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EnvironmentalFactor"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ForestFireRiskFactor"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#WeatherFactor"/>
        <rdfs:comment>Air movement that influences fire spread and ember transport.</rdfs:comment>
        <rdfs:label>Wind</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#WindEvent -->


    <owl:Class rdf:about="http://purl.org/ffonto#WindEvent">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ClimateDriver"/>
        <rdfs:comment>Periods of elevated winds that promote fire spread and ember transport.</rdfs:comment>
        <rdfs:label>High Wind Event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Window -->


    <owl:Class rdf:about="http://purl.org/ffonto#Window">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#BuildingComponent"/>
        <rdfs:comment>Glass openings in a building or vehicle.</rdfs:comment>
        <rdfs:label>Window</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ZeroTrustArchitecture -->


    <owl:Class rdf:about="http://purl.org/ffonto#ZeroTrustArchitecture">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#CyberSecurityPractice"/>
        <rdfs:comment xml:lang="en">A security model that assumes no implicit trust and enforces continuous verification.</rdfs:comment>
        <rdfs:label>Zero Trust Architecture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Zone1 -->


    <owl:Class rdf:about="http://purl.org/ffonto#Zone1">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#DefensibleZone"/>
        <rdfs:comment>Closest zone to the structure; typically 0-5 feet (or meters) - remove all flammable materials.</rdfs:comment>
        <rdfs:label>Zone 1 (Home Zone)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Zone2 -->


    <owl:Class rdf:about="http://purl.org/ffonto#Zone2">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#DefensibleZone"/>
        <rdfs:comment>Intermediate area for fuel reduction and spacing (e.g., 5-30 feet).</rdfs:comment>
        <rdfs:label>Zone 2 (Intermediate Zone)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Zone3 -->


    <owl:Class rdf:about="http://purl.org/ffonto#Zone3">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#DefensibleZone"/>
        <rdfs:comment>Outer zone used for thinning, ladder-fuel removal (e.g., 30-100 feet).</rdfs:comment>
        <rdfs:label>Zone 3 (Extended Zone)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#SpatialObject -->


    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#SpatialObject">
        <rdfs:comment xml:lang="en">An entity that has a spatial representation or location in geographic space.</rdfs:comment>
        <rdfs:label xml:lang="en">Spatial object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2002/07/owl#WildfireScene -->


    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#WildfireScene"/>
    


    <!-- http://www.w3.org/ns/prov#Activity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity">
        <rdfs:comment xml:lang="en">Something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities.</rdfs:comment>
        <rdfs:label xml:lang="en">activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Entity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity">
        <rdfs:comment xml:lang="en">A physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imagined.</rdfs:comment>
        <rdfs:label xml:lang="en">entity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Organization -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Organization"/>
    


    <!-- http://www.w3.org/ns/sosa/Platform -->


    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Platform">
        <rdfs:comment xml:lang="en">An entity that hosts other entities, particularly Sensors, Actuators, Samplers, and other Platforms.</rdfs:comment>
        <rdfs:label xml:lang="en">platform</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/sosa/Sensor -->


    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Sensor">
        <rdfs:comment xml:lang="en">A device, agent, or software component that observes or measures environmental or physical properties.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensor</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/ffonto#AICC -->


