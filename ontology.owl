        <rdfs:label>has required item</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasResourcePlacement -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasResourcePlacement">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ResourcePlacement"/>
        <rdfs:comment xml:lang="en">Describes the assigned location or staging of resources for operational use.</rdfs:comment>
        <rdfs:label>has resource placement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasRestorationStrategy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasRestorationStrategy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WildfireScene"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#RestorationStrategy"/>
        <rdfs:comment>Links wildfire scenes to recommended restoration strategies.</rdfs:comment>
        <rdfs:label>has restoration strategy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasResult -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasResult">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Result"/>
        <rdfs:comment xml:lang="en">Links a process, computation, or physical event to its direct outcome, measurement, or consequential state.</rdfs:comment>
        <rdfs:label xml:lang="en">has result</rdfs:label>
        <rdfs:label>has result</rdfs:label>
    </owl:ObjectProperty>
    


