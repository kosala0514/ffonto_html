    <!-- http://purl.org/ffonto#visibleAircraftOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#visibleAircraftOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#visibleAircraft"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Aircraft"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#CameraObservation"/>
        <rdfs:comment>Inverse - Aircraft visible in camera frames.</rdfs:comment>
        <rdfs:label>visible aircraft of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#wearsPPE -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#wearsPPE">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Firefighter"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#PPE"/>
        <rdfs:comment>Links firefighters to protective equipment they wear.</rdfs:comment>
        <rdfs:label>wears protective equipment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#wearsPPEOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#wearsPPEOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#wearsPPE"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#PPE"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Firefighter"/>
        <rdfs:comment xml:lang="en">Inverse relation linking PPE usage observations back to the personnel or roles wearing them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of wears ppe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#weatherInfluencesFireBehaviorModel -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#weatherInfluencesFireBehaviorModel">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isFireBehaviorModelInfluencedByWeather"/>
