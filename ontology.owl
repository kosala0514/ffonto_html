        <rdfs:label xml:lang="en">health affected by PM2.5</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#heavyEquipmentInUse -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#heavyEquipmentInUse">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#HeavyEquipment"/>
        <rdfs:comment xml:lang="en">Indicates that heavy machinery (e.g., dozers, graders) is being employed on-site.</rdfs:comment>
        <rdfs:label>heavy equipment in use</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#heavyEquipmentInUseOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#heavyEquipmentInUseOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#heavyEquipmentInUse"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#HeavyEquipment"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Connects bulldozers, graders, or other large machinery back to the suppression operation or construction task utilizing them.</rdfs:comment>
        <rdfs:label xml:lang="en">heavy equipment in use of</rdfs:label>
        <rdfs:label>heavy equipment in use of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hostsSensor -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hostsSensor">
        <rdfs:comment xml:lang="en">Relates a physical platform, such as a weather station, tower, or UAV, to the sensory hardware installed upon it.</rdfs:comment>
        <rdfs:label xml:lang="en">hosts sensor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#impactAffectsWildlife -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#impactAffectsWildlife">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isWildlifeAffectedByImpact"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WildlifeImpact"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Wildlife"/>
        <rdfs:comment xml:lang="en">Indicates that a particular environmental or physical impact has direct consequences for local animal populations or habitats.</rdfs:comment>
        <rdfs:label xml:lang="en">impact affects wildlife</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#impactsEcosystem -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#impactsEcosystem">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ClimateChange"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:comment>Indicates that an environmental factor affects an ecosystem.</rdfs:comment>
        <rdfs:label>impacts ecosystem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#impactsEcosystemOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#impactsEcosystemOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#impactsEcosystem"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ClimateChange"/>
        <rdfs:comment xml:lang="en">Inverse relation linking ecosystem impacts back to the actions or disturbances that produce them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of impacts ecosystem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#impactsTransportation -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#impactsTransportation">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#TransportationRoute"/>
        <rdfs:comment xml:lang="en">Indicates that an event or condition affects transport systems and mobility.</rdfs:comment>
        <rdfs:label>impacts transportation routes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#impactsTransportationOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#impactsTransportationOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#impactsTransportation"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#TransportationRoute"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Links a hazard, visibility reduction, or physical barrier back to the specific road network, railway, or logistical route it impedes.</rdfs:comment>
        <rdfs:label xml:lang="en">impacts transportation of</rdfs:label>
        <rdfs:label>impacts transportation routes of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#impairsVisibility -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#impairsVisibility">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Hazard"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#impairsVisibilityOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#impairsVisibilityOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#impairsVisibility"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:comment>Inverse - Whether the hazard reduces visibility (true/false).</rdfs:comment>
        <rdfs:label>impairs visibility of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#implementsPSPS -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#implementsPSPS">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#PSPS"/>
        <rdfs:comment xml:lang="en">Indicates execution of Public Safety Power Shutoff procedures to reduce fire ignition risk.</rdfs:comment>
        <rdfs:label>implements PSPS</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#implementsPSPSOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#implementsPSPSOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#implementsPSPS"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#PSPS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Connects an executed Public Safety Power Shutoff (PSPS) event back to the utility policy or hazard mitigation plan that required it.</rdfs:comment>
        <rdfs:label xml:lang="en">implements PSPS of</rdfs:label>
        <rdfs:label>implements PSPS of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#implementsRollback -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#implementsRollback">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isRollbackImplementedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#MLOpsPipeline"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#RollbackStrategy"/>
        <rdfs:comment xml:lang="en">Connects an MLOps Pipeline to its corresponding data or model rollback strategy.</rdfs:comment>
        <rdfs:label xml:lang="en">implements rollback</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#impliesHighSeverity -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#impliesHighSeverity">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireSeverity"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.org/ffonto#hasFuelLoad"/>
            <rdf:Description rdf:about="http://purl.org/ffonto#hasIgnitionSource"/>
        </owl:propertyChainAxiom>
        <rdfs:comment>Indicates that fuel load combined with ignition source conditions suggests high fire severity.</rdfs:comment>
        <rdfs:label>implies high severity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#impliesHighSeverityOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#impliesHighSeverityOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#impliesHighSeverity"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireSeverity"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation indicating that certain conditions imply high severity for a specific event or location.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of implies high severity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#improvesAirQuality -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#improvesAirQuality">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#usesAirCleaner"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AirCleaner"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#IndoorAirQualityStrategy"/>
        <rdfs:comment xml:lang="en">Connects an action, mitigation strategy, or device to its positive effect on atmospheric conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">improves air quality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#improvesIndoorAir -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#improvesIndoorAir">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isUsedInStrategy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#IndoorAirQualityStrategy"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AirCleaner"/>
        <rdfs:comment xml:lang="en">Indicates that a mitigation strategy or filtration device specifically targets and enhances the air quality inside a structure.</rdfs:comment>
        <rdfs:label xml:lang="en">improves indoor air</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#improvesSafety -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#improvesSafety">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FirefighterHealthSafety"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ProtectiveEquipment"/>
        <rdfs:comment xml:lang="en">Indicates that an action or measure enhances safety or reduces risk.</rdfs:comment>
        <rdfs:label>improves safety using equipment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#improvesSafetyOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#improvesSafetyOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#improvesSafety"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ProtectiveEquipment"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FirefighterHealthSafety"/>
        <rdfs:comment xml:lang="en">Inverse relation linking safety improvements back to the measures or programs implementing them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of improves safety</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#includesCommandRole -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#includesCommandRole">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#assignedToSection"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#IncidentCommandSection"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#IncidentCommandRole"/>
        <rdfs:comment xml:lang="en">Relates an Incident Command Section to the specific personnel roles assigned within it.</rdfs:comment>
        <rdfs:label xml:lang="en">includes command role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#includesPetPlan -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#includesPetPlan">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#EvacuationPreparation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#PetPreparation"/>
        <rdfs:comment>Links a household plan to PetPreparation activities.</rdfs:comment>
        <rdfs:label>includes pet plan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#includesPetPlanOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#includesPetPlanOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#includesPetPlan"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#PetPreparation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EvacuationPreparation"/>
        <rdfs:comment xml:lang="en">Inverse relation linking a pet plan to the household, facility, or entity that includes it.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of includes pet plan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#incorporatesSidingData -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#incorporatesSidingData">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isSidingDataIncorporatedIn"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SimulationModel"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ExteriorSiding"/>
        <rdfs:comment xml:lang="en">Links a simulation model to the exterior siding data it incorporates.</rdfs:comment>
        <rdfs:label xml:lang="en">incorporates siding data</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#increasesEnvironmentalRisk -->


