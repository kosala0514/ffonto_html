    </owl:Class>
    


    <!-- http://purl.org/ffonto#ExteriorSiding -->


    <owl:Class rdf:about="http://purl.org/ffonto#ExteriorSiding">
        <rdfs:comment>Represents the exterior covering or material attached to the outside walls of buildings.</rdfs:comment>
        <rdfs:label>Exterior Siding</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ExtremeWeather -->


    <owl:Class rdf:about="http://purl.org/ffonto#ExtremeWeather">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EnvironmentalRisk"/>
        <rdfs:comment>Severe weather events affecting ecosystems.</rdfs:comment>
        <rdfs:label>Extreme weather</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#F1Score -->


    <owl:Class rdf:about="http://purl.org/ffonto#F1Score">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EvaluationMetric"/>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FaceBlurring -->


    <owl:Class rdf:about="http://purl.org/ffonto#FaceBlurring">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PrivacyProtection"/>
        <rdfs:comment xml:lang="en">A privacy technique that obscures facial features in imagery to protect individual identity.</rdfs:comment>
        <rdfs:label>Face Blurring</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FallingTreeHazard -->


    <owl:Class rdf:about="http://purl.org/ffonto#FallingTreeHazard">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:comment>Risk of trees or branches falling due to wildfire damage or strong winds.</rdfs:comment>
        <rdfs:label>Falling Tree Hazard</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FarmEquipment -->


    <owl:Class rdf:about="http://purl.org/ffonto#FarmEquipment">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Equipment"/>
        <rdfs:comment>Agricultural machines such as tractors or ATVs.</rdfs:comment>
        <rdfs:label>Farm Equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Farmland -->


    <owl:Class rdf:about="http://purl.org/ffonto#Farmland">
        <rdfs:comment>Agricultural land at risk from fire and embers.</rdfs:comment>
        <rdfs:label>Farmland</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Fence -->


    <owl:Class rdf:about="http://purl.org/ffonto#Fence">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:comment>Fences or barriers present at the scene.</rdfs:comment>
        <rdfs:label>Fence</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FinanceAdministrationSection -->


    <owl:Class rdf:about="http://purl.org/ffonto#FinanceAdministrationSection">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#IncidentCommandSection"/>
        <rdfs:comment xml:lang="en">The organizational unit handling fiscal, procurement, and administrative tasks during an incident.</rdfs:comment>
        <rdfs:label>Finance and Administration Section</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FineFuel -->


    <owl:Class rdf:about="http://purl.org/ffonto#FineFuel"/>
    


    <!-- http://purl.org/ffonto#FireAlertSystem -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireAlertSystem">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#DecisionSupportSystem"/>
        <rdfs:comment>Systems that notify users about active fires or fire danger conditions.</rdfs:comment>
        <rdfs:label>Fire Alert System</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireBehavior -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireBehavior">
        <rdfs:comment>Characteristics describing how a fire behaves and spreads.</rdfs:comment>
        <rdfs:label>Fire Behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireBehaviorMetric -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireBehaviorMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ObservableProperty"/>
        <rdfs:comment xml:lang="en">A quantitative measure used to describe how a fire burns, such as rate of spread, flame length, or intensity.</rdfs:comment>
        <rdfs:label xml:lang="en">fire behavior metric</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireBehaviorModel -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireBehaviorModel">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SimulationModel"/>
        <rdfs:comment xml:lang="en">A model that simulates the spread, intensity, and effects of fire under various conditions.</rdfs:comment>
        <rdfs:label>Fire Behavior Model</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireCluster -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireCluster">
        <rdfs:comment>A distinct group or cluster of flames detected in the scene.</rdfs:comment>
        <rdfs:label>Fire Cluster</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireContainmentFactor -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireContainmentFactor">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireSpreadCondition"/>
        <rdfs:comment>A natural or artificial factor that limits or prevents the spread of fire.</rdfs:comment>
        <rdfs:label>Fire Containment Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireCountStatistic -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireCountStatistic">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#WildfireStatistic"/>
        <rdfs:label xml:lang="en">Fire Count</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireDangerAssessment -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireDangerAssessment">
        <rdfs:comment>Assessment of wildfire danger based on FWI system values.</rdfs:comment>
        <rdfs:label>Fire Danger Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireDrivenEcologicalChange -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireDrivenEcologicalChange">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/ffonto#EcologicalEffect"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/ffonto#isEcologicalEffectOf"/>
                        <owl:someValuesFrom rdf:resource="http://purl.org/ffonto#ForestFire"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Any ecological effect that is logically linked to a forest fire event.</rdfs:comment>
        <rdfs:label>Fire Driven Ecological Change</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireDriver -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireDriver">
        <rdfs:comment>Underlying cause or purpose of a fire event.</rdfs:comment>
        <rdfs:label>Fire Driver</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireElement -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireElement">
        <rdfs:comment>An essential component required for fire ignition and combustion.</rdfs:comment>
        <rdfs:label>Fire Element</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireEngine -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireEngine">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FirefightingResource"/>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireFlank -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireFlank">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireFront"/>
        <rdfs:comment>Side of the fire perimeter (left or right).</rdfs:comment>
        <rdfs:label>Fire Flank</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireFront -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireFront">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment>Leading edge of the wildfire.</rdfs:comment>
        <rdfs:label>Fire Front</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireGeneratedWeather -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireGeneratedWeather">
        <rdfs:comment>Pyro-weather phenomena created by intense fires.</rdfs:comment>
        <rdfs:label>Fire Generated Weather</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireHose -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireHose">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Equipment"/>
        <rdfs:comment>A flexible hose used to deliver water to extinguish fire.</rdfs:comment>
        <rdfs:label>Fire Hose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireImpact -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireImpact">
        <rdfs:comment>Immediate environmental effects caused by a fire event, such as vegetation loss or carbon release.</rdfs:comment>
        <rdfs:label>Fire Impact</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireInducedWind -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireInducedWind">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireGeneratedWeather"/>
        <rdfs:comment>Locally generated winds from convection columns.</rdfs:comment>
        <rdfs:label>Fire Induced Wind</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireIntensity -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireIntensity">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireBehavior"/>
        <rdfs:comment>The energy output of a fire.</rdfs:comment>
        <rdfs:label>Fire Intensity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireLine -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireLine">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment>Constructed control line to stop fire spread.</rdfs:comment>
        <rdfs:label>Fire Line</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireManagementStrategy -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireManagementStrategy">
        <rdfs:comment>Methods used to control or mitigate wildfire spread.</rdfs:comment>
        <rdfs:label>Fire Management Strategy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FirePerimeter -->


    <owl:Class rdf:about="http://purl.org/ffonto#FirePerimeter">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
