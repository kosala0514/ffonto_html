    <!-- http://purl.org/ffonto#FireSeverity -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireSeverity">
        <rdfs:comment>Categorical or continuous measure of ecological severity / intensity of a burn.</rdfs:comment>
        <rdfs:label>Fire severity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireSeverityReduction -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireSeverityReduction">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#RegulatingService"/>
