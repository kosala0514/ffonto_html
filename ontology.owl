        <rdfs:label>Evacuation Plan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#EvacuationPreparation -->


    <owl:Class rdf:about="http://purl.org/ffonto#EvacuationPreparation">
