        <rdfs:label>Firefighter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FirefighterHealthSafety -->


    <owl:Class rdf:about="http://purl.org/ffonto#FirefighterHealthSafety">
        <rdfs:comment xml:lang="en">Policies and practices aimed at protecting the health and wellbeing of firefighting personnel.</rdfs:comment>
        <rdfs:label>Firefighter Health and Safety</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FirefighterSafety -->


    <owl:Class rdf:about="http://purl.org/ffonto#FirefighterSafety">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EthicalConsideration"/>
        <rdfs:comment xml:lang="en">Measures and practices to reduce risk and injury for firefighters.</rdfs:comment>
        <rdfs:label>Firefighter Safety Ethics</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FirefightingOperation -->


    <owl:Class rdf:about="http://purl.org/ffonto#FirefightingOperation">
        <rdfs:comment>An operational activity conducted to control or suppress wildfire.</rdfs:comment>
        <rdfs:label>Firefighting Operation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FirefightingResource -->


    <owl:Class rdf:about="http://purl.org/ffonto#FirefightingResource">
        <rdfs:comment>Personnel, equipment, or vehicles used to combat wildfires.</rdfs:comment>
        <rdfs:label>Firefighting Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Fireline -->


    <owl:Class rdf:about="http://purl.org/ffonto#Fireline">
        <rdfs:comment xml:lang="en">A cleared or treated strip of land intended to stop fire spread.</rdfs:comment>
        <rdfs:label>Fireline</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FirelineAccess -->


    <owl:Class rdf:about="http://purl.org/ffonto#FirelineAccess">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AccessConstraintDetail"/>
        <rdfs:comment>Ability to establish and access a fireline for suppression crews.</rdfs:comment>
        <rdfs:label>Fireline Access</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Fireworks -->


    <owl:Class rdf:about="http://purl.org/ffonto#Fireworks">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#HumanIgnition"/>
        <rdfs:comment xml:lang="en">Pyrotechnic devices intended for celebration that may present fire hazards if misused.</rdfs:comment>
        <rdfs:label>Fireworks</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FiveGNetwork -->


    <owl:Class rdf:about="http://purl.org/ffonto#FiveGNetwork">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#CommunicationNetwork"/>
        <rdfs:comment xml:lang="en">A cellular network architecture that provides high bandwidth and low latency connectivity.</rdfs:comment>
        <rdfs:label>5G Network</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FlameDetection -->


    <owl:Class rdf:about="http://purl.org/ffonto#FlameDetection">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ComputerVisionTask"/>
        <rdfs:comment xml:lang="en">Technologies or methods used to detect the presence of flames in imagery or sensors.</rdfs:comment>
        <rdfs:label>Flame Detection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FlameHeight -->


    <owl:Class rdf:about="http://purl.org/ffonto#FlameHeight">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireBehavior"/>
        <rdfs:comment>The vertical height of flames during a fire.</rdfs:comment>
        <rdfs:label>Flame Height</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FlameLength -->


    <owl:Class rdf:about="http://purl.org/ffonto#FlameLength">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireBehaviorMetric"/>
        <rdfs:comment xml:lang="en">The vertical distance from base to tip of visible flame, used as a fire behavior metric.</rdfs:comment>
        <rdfs:label>Flame Length</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FlamingPhase -->


    <owl:Class rdf:about="http://purl.org/ffonto#FlamingPhase">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#CombustionProcess"/>
        <rdfs:comment>High-temperature combustion phase with visible flames and rapid fuel consumption.</rdfs:comment>
        <rdfs:label>Flaming Phase</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FlightPath -->


    <owl:Class rdf:about="http://purl.org/ffonto#FlightPath">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment xml:lang="en">A planned or recorded trajectory that an aircraft follows between waypoints.</rdfs:comment>
        <rdfs:label>Aircraft Flight Path</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FocalLoss -->


    <owl:Class rdf:about="http://purl.org/ffonto#FocalLoss">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ModelTrainingTechnique"/>
        <rdfs:comment xml:lang="en">A loss function used to address class imbalance by down-weighting easy examples.</rdfs:comment>
        <rdfs:label>Focal Loss</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FoodSafetyProcedure -->


    <owl:Class rdf:about="http://purl.org/ffonto#FoodSafetyProcedure">
        <rdfs:comment>Food safety measures recommended after power outages.</rdfs:comment>
        <rdfs:label>Food Safety Procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Forest -->


    <owl:Class rdf:about="http://purl.org/ffonto#Forest">
        <rdfs:comment xml:lang="en">A large area dominated by trees and natural vegetation.</rdfs:comment>
        <rdfs:label xml:lang="en">Forest</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ForestDisturbance -->


    <owl:Class rdf:about="http://purl.org/ffonto#ForestDisturbance">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EnvironmentalFactor"/>
        <rdfs:comment>Events that alter forest ecosystems such as pests, disease, or drought.</rdfs:comment>
        <rdfs:label>Forest Disturbance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ForestEcosystem -->


    <owl:Class rdf:about="http://purl.org/ffonto#ForestEcosystem">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:comment>An ecosystem dominated by trees and woody vegetation.</rdfs:comment>
        <rdfs:label>Forest Ecosystem</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ForestFire -->


    <owl:Class rdf:about="http://purl.org/ffonto#ForestFire">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ffonto#hasBurnSeverity"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ffonto#FireSeverity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ffonto#hasIgnitionSource"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ffonto#IgnitionSource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ffonto#occursIn"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/ffonto#ForestEcosystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An uncontrolled fire occurring in natural vegetation.</rdfs:comment>
        <rdfs:label>Forest Fire</rdfs:label>
        <skos:altLabel>Wildfire</skos:altLabel>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ForestFireCause -->


    <owl:Class rdf:about="http://purl.org/ffonto#ForestFireCause">
        <rdfs:comment>Natural or human activities responsible for wildfire ignition.</rdfs:comment>
        <rdfs:label>ForestFire Cause</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ForestFireEffect -->


    <owl:Class rdf:about="http://purl.org/ffonto#ForestFireEffect">
        <rdfs:comment xml:lang="en">Represents the ecological, environmental, or economic consequence resulting from a wildfire, such as soil erosion or habitat loss.</rdfs:comment>
        <rdfs:label xml:lang="en">Forest Fire Effect</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ForestFirePredictionModel -->


    <owl:Class rdf:about="http://purl.org/ffonto#ForestFirePredictionModel">
        <rdfs:comment>Computational models used to forecast wildfire ignition, spread, and impact.</rdfs:comment>
        <rdfs:label>ForestFire Prediction Model</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ForestFirePrevention -->


    <owl:Class rdf:about="http://purl.org/ffonto#ForestFirePrevention">
        <rdfs:comment>Practices aimed at preventing wildfire ignition.</rdfs:comment>
        <rdfs:label>ForestFire Prevention</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ForestFireRisk -->


    <owl:Class rdf:about="http://purl.org/ffonto#ForestFireRisk">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#RiskAssessment"/>
        <rdfs:comment xml:lang="en">The likelihood or probability that a wildfire may start and spread in a forested area based on environmental, climatic, and human factors.</rdfs:comment>
        <rdfs:label xml:lang="en">Forest fire risk</rdfs:label>
        <skos:altLabel xml:lang="en">Wildfire risk</skos:altLabel>
        <skos:definition xml:lang="en">A risk assessment concept representing the potential for wildfire ignition and propagation in forest ecosystems.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ForestFireRiskFactor -->


    <owl:Class rdf:about="http://purl.org/ffonto#ForestFireRiskFactor">
        <rdfs:comment>Environmental or anthropogenic variables influencing wildfire probability.</rdfs:comment>
        <rdfs:label>ForestFire Risk Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ForestFireTechnology -->


    <owl:Class rdf:about="http://purl.org/ffonto#ForestFireTechnology">
        <rdfs:comment xml:lang="en">Technologies designed to detect, model, mitigate, or respond to forest fires.</rdfs:comment>
        <rdfs:label>ForestFire Technology</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ForestManagement -->


    <owl:Class rdf:about="http://purl.org/ffonto#ForestManagement">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#LandManagementPractice"/>
        <rdfs:comment xml:lang="en">Practices aimed at sustaining forest health, productivity, and ecological values.</rdfs:comment>
        <rdfs:label>Forest Management</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ForestRegeneration -->


    <owl:Class rdf:about="http://purl.org/ffonto#ForestRegeneration">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#VegetationDynamics"/>
        <rdfs:comment>The natural recovery and regrowth of vegetation following a disturbance.</rdfs:comment>
        <rdfs:label>Forest Regeneration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ForestRestoration -->


    <owl:Class rdf:about="http://purl.org/ffonto#ForestRestoration">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ClimateMitigation"/>
        <rdfs:comment xml:lang="en">Actions intended to return forest ecosystems to a desired ecological state.</rdfs:comment>
        <rdfs:label>Forest Restoration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ForestStructure -->


    <owl:Class rdf:about="http://purl.org/ffonto#ForestStructure">
        <rdfs:comment>Structural characteristics of a forest ecosystem.</rdfs:comment>
        <rdfs:label>Forest structure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ForestTerrain -->


    <owl:Class rdf:about="http://purl.org/ffonto#ForestTerrain">
        <rdfs:comment>Physical terrain conditions such as slopes and hills influencing fire behavior.</rdfs:comment>
        <rdfs:label>Forest Terrain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Fuel -->


    <owl:Class rdf:about="http://purl.org/ffonto#Fuel">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireElement"/>
        <rdfs:comment>Combustible material consumed during a wildfire.</rdfs:comment>
        <rdfs:comment>Combustible materials such as dry grass, leaf litter, and logs that contribute to fire spread.</rdfs:comment>
        <rdfs:label>Fuel</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FuelAccumulation -->


    <owl:Class rdf:about="http://purl.org/ffonto#FuelAccumulation">
        <rdfs:comment>Excess live or dead vegetation due to fire suppression or forest change.</rdfs:comment>
        <rdfs:label>Fuel Accumulation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FuelCharacteristic -->


    <owl:Class rdf:about="http://purl.org/ffonto#FuelCharacteristic">
        <rdfs:comment>Properties affecting how fuels burn.</rdfs:comment>
        <rdfs:label>Fuel Characteristic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FuelCondition -->


    <owl:Class rdf:about="http://purl.org/ffonto#FuelCondition">
        <rdfs:comment>Live/dead fuel moisture conditions, curing status, height/continuity of grasses, canopy base height and crown potential.</rdfs:comment>
        <rdfs:label>Fuel Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FuelLoad -->


    <owl:Class rdf:about="http://purl.org/ffonto#FuelLoad">
        <rdfs:comment>Amount and type of combustible organic material present in a spatial unit.</rdfs:comment>
        <rdfs:label>Fuel load</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FuelLoadReduction -->


    <owl:Class rdf:about="http://purl.org/ffonto#FuelLoadReduction">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EcosystemService"/>
        <rdfs:comment>The reduction of accumulated combustible vegetation materials that could contribute to the intensity of forest fires.</rdfs:comment>
        <rdfs:label>Fuel Load Reduction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FuelMoisture -->


    <owl:Class rdf:about="http://purl.org/ffonto#FuelMoisture">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FuelCharacteristic"/>
        <rdfs:comment xml:lang="en">The moisture content of combustible vegetation or fuels, usually expressed as a percentage.</rdfs:comment>
        <rdfs:label>Fuel Moisture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FuelMoistureCondition -->


    <owl:Class rdf:about="http://purl.org/ffonto#FuelMoistureCondition">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireSpreadCondition"/>
        <rdfs:comment>A condition describing the moisture content of vegetation or fuel material that influences fire ignition and spread.</rdfs:comment>
        <rdfs:label>Fuel Moisture Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FuelReduction -->


    <owl:Class rdf:about="http://purl.org/ffonto#FuelReduction">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ClimateMitigation"/>
        <rdfs:comment xml:lang="en">Actions taken to decrease available combustible material to lower fire risk.</rdfs:comment>
        <rdfs:label>Fuel Reduction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FuelTreatment -->


    <owl:Class rdf:about="http://purl.org/ffonto#FuelTreatment">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PreventionMeasure"/>
        <rdfs:comment xml:lang="en">Management actions (e.g., thinning, grazing, prescribed fire) to alter fuel characteristics.</rdfs:comment>
        <rdfs:label>Fuel Treatment (thinning, mastication)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FuelType -->


    <owl:Class rdf:about="http://purl.org/ffonto#FuelType">
        <rdfs:comment>Combustible vegetation material that contributes to fire spread.</rdfs:comment>
        <rdfs:label>Fuel Type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#GISApplication -->


    <owl:Class rdf:about="http://purl.org/ffonto#GISApplication">
        <rdfs:comment>Use of geographic information systems in wildfire management.</rdfs:comment>
        <rdfs:label>GIS Application</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#GOES -->


    <owl:Class rdf:about="http://purl.org/ffonto#GOES">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#RemoteSensor"/>
        <rdfs:comment xml:lang="en">Geostationary Operational Environmental Satellite; a family of weather-monitoring satellites.</rdfs:comment>
        <rdfs:label>GOES (geostationary thermal/IR)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Garage -->


    <owl:Class rdf:about="http://purl.org/ffonto#Garage">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Building"/>
        <rdfs:comment>Represents a garage building used to store vehicles.</rdfs:comment>
        <rdfs:label>Garage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Gate -->


    <owl:Class rdf:about="http://purl.org/ffonto#Gate">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:comment>Gates attached to fences or driveways.</rdfs:comment>
        <rdfs:label>Gate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#GatedWye -->


    <owl:Class rdf:about="http://purl.org/ffonto#GatedWye">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Equipment"/>
        <rdfs:comment xml:lang="en">A three-way valve fitting used in fire hydrant or water distribution systems to control flow.</rdfs:comment>
        <rdfs:label>Gated Wye Valve</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#GeneratorSafety -->


    <owl:Class rdf:about="http://purl.org/ffonto#GeneratorSafety">
        <rdfs:comment>Rules and guidance for safe generator use to avoid carbon monoxide and electrical hazards.</rdfs:comment>
        <rdfs:label>Generator Safety</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#GeoJSON -->


    <owl:Class rdf:about="http://purl.org/ffonto#GeoJSON">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#GeospatialDataFormat"/>
        <rdfs:comment xml:lang="en">A JSON-based format for encoding geographic data structures such as points and polygons.</rdfs:comment>
        <rdfs:label>GeoJSON</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#GeoTIFF -->


    <owl:Class rdf:about="http://purl.org/ffonto#GeoTIFF">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#GeospatialDataFormat"/>
        <rdfs:comment xml:lang="en">A georeferenced TIFF image format commonly used for storing raster geographic data.</rdfs:comment>
        <rdfs:label>GeoTIFF</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#GeospatialDataFormat -->


    <owl:Class rdf:about="http://purl.org/ffonto#GeospatialDataFormat">
        <rdfs:comment xml:lang="en">A file format or specification for storing and exchanging geographic data.</rdfs:comment>
        <rdfs:label>Geospatial Data Format</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#GraphNeuralNetwork -->


    <owl:Class rdf:about="http://purl.org/ffonto#GraphNeuralNetwork">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#MachineLearningModel"/>
        <rdfs:comment>ML architecture capable of modeling connectivity relationships such as fuel networks or road evacuation routes.</rdfs:comment>
        <rdfs:label>Graph Neural Network</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Grass -->


    <owl:Class rdf:about="http://purl.org/ffonto#Grass">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Vegetation"/>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Grassland -->


    <owl:Class rdf:about="http://purl.org/ffonto#Grassland">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Ecosystem"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#TerrainFeature"/>
        <rdfs:comment>An ecosystem dominated primarily by grasses and herbaceous plants.</rdfs:comment>
        <rdfs:label>Grassland</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#GrazingManagement -->


    <owl:Class rdf:about="http://purl.org/ffonto#GrazingManagement">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#LandManagementPractice"/>
        <rdfs:comment xml:lang="en">Practices that manage livestock grazing to influence fuel loads and ecosystem health.</rdfs:comment>
        <rdfs:label>Grazing Management</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#GridLocation -->


    <owl:Class rdf:about="http://purl.org/ffonto#GridLocation">
        <rdfs:comment>Spatial grid reference for the monitored site.</rdfs:comment>
        <rdfs:label>Grid Location</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#GroundCrew -->


    <owl:Class rdf:about="http://purl.org/ffonto#GroundCrew">
        <rdfs:comment>Firefighters operating on the ground.</rdfs:comment>
        <rdfs:label>Ground Fire Crew</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#GroundResource -->


    <owl:Class rdf:about="http://purl.org/ffonto#GroundResource">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SuppressionResource"/>
        <rdfs:comment>Ground-based suppression equipment such as fire engines.</rdfs:comment>
        <rdfs:label>Ground Firefighting Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#GroundVisibility -->


    <owl:Class rdf:about="http://purl.org/ffonto#GroundVisibility">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#VisibilityCondition"/>
        <rdfs:comment>Visibility condition relevant to ground crews and roads.</rdfs:comment>
        <rdfs:label>Ground Visibility</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Groundwater -->


    <owl:Class rdf:about="http://purl.org/ffonto#Groundwater">
        <rdfs:comment>Water stored underground in soil or rock formations.</rdfs:comment>
        <rdfs:label>Groundwater</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Guardrail -->


    <owl:Class rdf:about="http://purl.org/ffonto#Guardrail">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#TransportationInfrastructure"/>
        <rdfs:comment>Roadside guardrails.</rdfs:comment>
        <rdfs:label>Guardrail</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Gutter -->


    <owl:Class rdf:about="http://purl.org/ffonto#Gutter">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#BuildingComponent"/>
        <rdfs:comment>A drainage component attached to the roof edge that can collect leaves and debris, increasing fire risk.</rdfs:comment>
        <rdfs:label>Gutter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Habitat -->


    <owl:Class rdf:about="http://purl.org/ffonto#Habitat">
        <rdfs:comment>The natural environment where species live and obtain resources.</rdfs:comment>
        <rdfs:label>Habitat</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HabitatChange -->


    <owl:Class rdf:about="http://purl.org/ffonto#HabitatChange">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EcologicalEffect"/>
        <rdfs:comment>Alteration in wildlife habitats due to environmental disturbances or ecological succession.</rdfs:comment>
        <rdfs:comment>Alterations in the living environment for wildlife, including habitat creation or destruction.</rdfs:comment>
        <rdfs:label>Habitat Change</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HabitatFragmentation -->


    <owl:Class rdf:about="http://purl.org/ffonto#HabitatFragmentation">
        <rdfs:comment>Division of ecosystems into smaller isolated patches.</rdfs:comment>
        <rdfs:label>Habitat fragmentation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HabitatLoss -->


    <owl:Class rdf:about="http://purl.org/ffonto#HabitatLoss">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EcologicalImpact"/>
        <rdfs:comment>Destruction or reduction of habitats due to fire.</rdfs:comment>
        <rdfs:label>Habitat Loss</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HabitatProvision -->


    <owl:Class rdf:about="http://purl.org/ffonto#HabitatProvision">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EcosystemService"/>
        <rdfs:comment>Provision of living space for organisms.</rdfs:comment>
        <rdfs:label>Habitat Provision</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HabitatType -->


    <owl:Class rdf:about="http://purl.org/ffonto#HabitatType">
        <rdfs:comment>Wildlife habitat categories (mature canopy, shrubland, grassland) relevant to biodiversity.</rdfs:comment>
        <rdfs:label>Habitat type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HandTool -->


    <owl:Class rdf:about="http://purl.org/ffonto#HandTool">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Tool"/>
        <rdfs:comment xml:lang="en">A manually operated tool used for tasks such as cutting, digging, or clearing.</rdfs:comment>
        <rdfs:label>Hand Tool</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Handline -->


    <owl:Class rdf:about="http://purl.org/ffonto#Handline">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Fireline"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SuppressionTactic"/>
        <rdfs:comment xml:lang="en">A control line built by hand crews using hand tools to stop or contain fire.</rdfs:comment>
        <rdfs:label>Handline</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HardyVegetation -->


    <owl:Class rdf:about="http://purl.org/ffonto#HardyVegetation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Vegetation"/>
        <rdfs:comment>Vegetation adapted to survive harsh environmental conditions such as poor soil or low nutrients.</rdfs:comment>
        <rdfs:label>Hardy vegetation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Hazard -->


    <owl:Class rdf:about="http://purl.org/ffonto#Hazard">
        <rdfs:comment>A dangerous condition present during wildfire operations.</rdfs:comment>
        <rdfs:label>Hazard</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HazardMapping -->


    <owl:Class rdf:about="http://purl.org/ffonto#HazardMapping">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireRiskAssessment"/>
        <rdfs:comment xml:lang="en">The process of creating maps that identify and characterize hazards in an area.</rdfs:comment>
        <rdfs:label>Hazard Mapping</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HazardousMaterial -->


    <owl:Class rdf:about="http://purl.org/ffonto#HazardousMaterial">
        <rdfs:comment>Dangerous household or industrial substances that require special handling after wildfire.</rdfs:comment>
        <rdfs:label>Hazardous Material</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HazardousWasteGuideline -->


    <owl:Class rdf:about="http://purl.org/ffonto#HazardousWasteGuideline">
        <rdfs:comment>Guidelines or instructions for safely handling and disposing of hazardous waste after a wildfire.</rdfs:comment>
        <rdfs:label>Hazardous Waste Guideline</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HealthAdvice -->


    <owl:Class rdf:about="http://purl.org/ffonto#HealthAdvice">
        <rdfs:comment>Guidance provided to the public for wildfire smoke protection.</rdfs:comment>
        <rdfs:label>Health Advice</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HealthEffect -->


    <owl:Class rdf:about="http://purl.org/ffonto#HealthEffect">
        <rdfs:comment>Human health impacts caused by smoke or toxic pollutants.</rdfs:comment>
        <rdfs:label>Health Effect</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HealthGuideline -->


    <owl:Class rdf:about="http://purl.org/ffonto#HealthGuideline">
        <rdfs:comment>Public health recommendations designed to reduce health impacts from wildfire smoke exposure.</rdfs:comment>
        <rdfs:label>Health Guideline</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HealthImpact -->


    <owl:Class rdf:about="http://purl.org/ffonto#HealthImpact">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ForestFireEffect"/>
        <rdfs:comment xml:lang="en">The effect of an event or environmental condition (e.g., smoke inhalation) on human or animal health.</rdfs:comment>
        <rdfs:label xml:lang="en">health impact</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HealthRisk -->


    <owl:Class rdf:about="http://purl.org/ffonto#HealthRisk">
        <rdfs:comment>Health risk caused by wildfire smoke exposure.</rdfs:comment>
        <rdfs:label>Health Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HealthSymptom -->


    <owl:Class rdf:about="http://purl.org/ffonto#HealthSymptom">
        <rdfs:comment>Physical symptom caused by wildfire smoke exposure.</rdfs:comment>
        <rdfs:label>Health Symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HealthyVegetation -->


    <owl:Class rdf:about="http://purl.org/ffonto#HealthyVegetation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#VegetationCondition"/>
        <rdfs:comment>Vegetation with strong growth and normal canopy coverage.</rdfs:comment>
        <rdfs:label>Healthy vegetation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Heat -->


    <owl:Class rdf:about="http://purl.org/ffonto#Heat">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireElement"/>
        <rdfs:comment>Ignition energy source that starts combustion.</rdfs:comment>
        <rdfs:label>Heat</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HeatStressHazard -->


    <owl:Class rdf:about="http://purl.org/ffonto#HeatStressHazard">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:comment xml:lang="en">Conditions that increase risk of heat-related illness or performance degradation.</rdfs:comment>
        <rdfs:label>Heat Stress Hazard</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HeatStressRisk -->


    <owl:Class rdf:about="http://purl.org/ffonto#HeatStressRisk">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#HealthRisk"/>
        <rdfs:comment xml:lang="en">The likelihood that individuals will experience heat-related health effects under given conditions.</rdfs:comment>
        <rdfs:label>Heat Stress Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HeatWave -->


    <owl:Class rdf:about="http://purl.org/ffonto#HeatWave">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ClimateDriver"/>
        <rdfs:comment xml:lang="en">A prolonged period of excessively hot weather relative to the normal climate for the area.</rdfs:comment>
        <rdfs:label>Heat Wave / Temperature Anomaly</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HeavyEquipment -->


    <owl:Class rdf:about="http://purl.org/ffonto#HeavyEquipment">
        <rdfs:comment>Large machines such as bulldozers or excavators.</rdfs:comment>
        <rdfs:label>Heavy Equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HeavyFuel -->


    <owl:Class rdf:about="http://purl.org/ffonto#HeavyFuel"/>
    


    <!-- http://purl.org/ffonto#Helicopter -->


    <owl:Class rdf:about="http://purl.org/ffonto#Helicopter">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Aircraft"/>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Helispot -->


    <owl:Class rdf:about="http://purl.org/ffonto#Helispot">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment xml:lang="en">A prepared area where helicopters can land and take off safely during operations.</rdfs:comment>
        <rdfs:label>Helispot</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HighBurnSeverity -->


    <owl:Class rdf:about="http://purl.org/ffonto#HighBurnSeverity">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireSeverity"/>
        <rdfs:comment>High severity class; could be constrained by burnSeverityIndex thresholds in rules.</rdfs:comment>
        <rdfs:label>High burn severity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HighFireRisk -->


    <owl:Class rdf:about="http://purl.org/ffonto#HighFireRisk">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireSusceptibility"/>
        <rdfs:comment>Indicates high vulnerability to wildfire ignition and spread.</rdfs:comment>
        <rdfs:label>High fire risk</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HighFlammability -->


    <owl:Class rdf:about="http://purl.org/ffonto#HighFlammability">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PlantFlammabilityTrait"/>
        <rdfs:comment>A trait describing vegetation that ignites easily and burns intensely.</rdfs:comment>
        <rdfs:label>High Flammability</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Hillside -->


    <owl:Class rdf:about="http://purl.org/ffonto#Hillside">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#TerrainFeature"/>
        <rdfs:comment xml:lang="en">A sloping terrain area that can affect wildfire spread direction and intensity.</rdfs:comment>
        <rdfs:label xml:lang="en">Hillside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HomeHardening -->


    <owl:Class rdf:about="http://purl.org/ffonto#HomeHardening">
        <rdfs:comment xml:lang="en">Structural and behavioral modifications to a building that reduce wildfire vulnerability.</rdfs:comment>
        <rdfs:label>Home Hardening</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HomeInsurance -->


    <owl:Class rdf:about="http://purl.org/ffonto#HomeInsurance">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#InsurancePolicy"/>
        <rdfs:comment>An insurance policy designed to cover damages to a privately owned home and its contents.</rdfs:comment>
        <rdfs:label>Home Insurance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HomeProtectionMeasure -->


    <owl:Class rdf:about="http://purl.org/ffonto#HomeProtectionMeasure">
        <rdfs:comment>Measures to reduce the chance of home ignition from embers, heat, and flame.</rdfs:comment>
        <rdfs:label>Home Protection Measure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HoseLine -->


    <owl:Class rdf:about="http://purl.org/ffonto#HoseLine">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Equipment"/>
        <rdfs:comment xml:lang="en">A length of fire hose deployed to deliver water or foam to a fire.</rdfs:comment>
        <rdfs:label>Fire Hose Line</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HotspotLocalization -->


    <owl:Class rdf:about="http://purl.org/ffonto#HotspotLocalization">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ComputerVisionTask"/>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#House -->


    <owl:Class rdf:about="http://purl.org/ffonto#House">
        <rdfs:comment>Residential structure potentially threatened by wildfire.</rdfs:comment>
        <rdfs:label>House</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HumanActivity -->


    <owl:Class rdf:about="http://purl.org/ffonto#HumanActivity">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ForestFireRiskFactor"/>
        <rdfs:comment xml:lang="en">Actions or behaviors by people that may influence or indicate conditions in an area.</rdfs:comment>
        <rdfs:label>Human Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HumanCause -->


    <owl:Class rdf:about="http://purl.org/ffonto#HumanCause">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ForestFireCause"/>
        <rdfs:comment xml:lang="en">An event or condition initiated by human activity that may lead to incidents.</rdfs:comment>
        <rdfs:label>Human-caused ForestFire</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HumanEstimation -->


    <owl:Class rdf:about="http://purl.org/ffonto#HumanEstimation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EstimationMethod"/>
        <rdfs:comment>A wildfire estimation produced by human experts such as firefighters or analysts.</rdfs:comment>
        <rdfs:label>Human estimation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HumanHealth -->


    <owl:Class rdf:about="http://purl.org/ffonto#HumanHealth">
        <rdfs:comment>Represents the respiratory or overall health condition of humans affected by environmental factors like air pollution.</rdfs:comment>
        <rdfs:label>Human Health</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#HumanIgnition -->


    <owl:Class rdf:about="http://purl.org/ffonto#HumanIgnition">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#IgnitionCause"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#IgnitionSource"/>
        <rdfs:comment>Ignitions resulting from human activity or infrastructure failure.</rdfs:comment>
        <rdfs:label>Human Ignition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Hydrant -->


    <owl:Class rdf:about="http://purl.org/ffonto#Hydrant">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#UtilityInfrastructure"/>
        <rdfs:comment>Fire hydrants.</rdfs:comment>
        <rdfs:label>Hydrant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Hyperspectral -->


    <owl:Class rdf:about="http://purl.org/ffonto#Hyperspectral">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#RemoteSensor"/>
        <rdfs:comment xml:lang="en">Imaging that captures data across many narrow spectral bands for detailed material analysis.</rdfs:comment>
        <rdfs:label>Hyperspectral Sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ICSFunction -->


    <owl:Class rdf:about="http://purl.org/ffonto#ICSFunction">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#IncidentCommandSystem"/>
        <rdfs:comment>Command, Operations, Planning, Logistics, Finance/Admin.</rdfs:comment>
        <rdfs:label>ICS Functional Area</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#IgnitionCause -->


    <owl:Class rdf:about="http://purl.org/ffonto#IgnitionCause">
        <rdfs:comment>Factor or event that initiates combustion.</rdfs:comment>
        <rdfs:label>Ignition Cause</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#IgnitionSource -->


    <owl:Class rdf:about="http://purl.org/ffonto#IgnitionSource">
        <rdfs:comment>Cause or source of ignition for a fire event.</rdfs:comment>
        <rdfs:label>Ignition source</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ImageAsset -->


    <owl:Class rdf:about="http://purl.org/ffonto#ImageAsset">
        <rdfs:comment>Represents an image file and its metadata (resolution, checksum, georef, path, license, etc.).</rdfs:comment>
        <rdfs:label>Image Asset</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ImageContribution -->


    <owl:Class rdf:about="http://purl.org/ffonto#ImageContribution">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#CrowdsourcedReport"/>
        <rdfs:comment xml:lang="en">An image or photograph provided by a person or organization for analysis or documentation.</rdfs:comment>
        <rdfs:label>Image Contribution</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ImageObservation -->


    <owl:Class rdf:about="http://purl.org/ffonto#ImageObservation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:comment>Observation derived from imagery analysis with provenance and confidence metadata.</rdfs:comment>
        <rdfs:label>Image observation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ImageQualityMetadata -->


    <owl:Class rdf:about="http://purl.org/ffonto#ImageQualityMetadata">
        <rdfs:comment>Quality-related metadata such as blur, cloud_cover quality flags, georeference presence and sensor pose.</rdfs:comment>
        <rdfs:label>Image Quality Metadata</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ImmediateEvacuationAction -->


    <owl:Class rdf:about="http://purl.org/ffonto#ImmediateEvacuationAction">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EvacuationAction"/>
        <rdfs:comment>Actions to do when authorities advise or order evacuation.</rdfs:comment>
        <rdfs:label>Immediate Evacuation Action</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ImpactHazard -->


    <owl:Class rdf:about="http://purl.org/ffonto#ImpactHazard">
        <rdfs:comment>Hazard from direct impact of drops (force, debris) or contamination.</rdfs:comment>
        <rdfs:label>Impact Hazard</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ImportantDocument -->


    <owl:Class rdf:about="http://purl.org/ffonto#ImportantDocument">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PreparednessItem"/>
        <rdfs:comment>Key legal and personal documents (IDs, insurance, wills) to safeguard and take during evacuation.</rdfs:comment>
        <rdfs:label>Important Document</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#IncidentBriefing -->


    <owl:Class rdf:about="http://purl.org/ffonto#IncidentBriefing">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SituationReport"/>
        <rdfs:comment xml:lang="en">A short, focused presentation of current situation, objectives, and safety information for personnel.</rdfs:comment>
        <rdfs:label>Incident Briefing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#IncidentCommand -->


    <owl:Class rdf:about="http://purl.org/ffonto#IncidentCommand">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EmergencyResponder"/>
        <rdfs:comment xml:lang="en">The authority and structure responsible for overall incident management and decision-making.</rdfs:comment>
        <rdfs:label>Incident Command</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#IncidentCommandPost -->


    <owl:Class rdf:about="http://purl.org/ffonto#IncidentCommandPost">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:comment>The central command location for managing wildfire response.</rdfs:comment>
        <rdfs:label>Incident Command Post</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#IncidentCommandRole -->


    <owl:Class rdf:about="http://purl.org/ffonto#IncidentCommandRole">
        <rdfs:comment xml:lang="en">A designated function or position within the Incident Command System (ICS) managing the emergency response.</rdfs:comment>
        <rdfs:label xml:lang="en">incident command role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#IncidentCommandSection -->


    <owl:Class rdf:about="http://purl.org/ffonto#IncidentCommandSection">
        <rdfs:comment xml:lang="en">A primary organizational division within the Incident Command System, such as Operations, Planning, or Logistics.</rdfs:comment>
        <rdfs:label xml:lang="en">incident command section</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#IncidentCommandSystem -->


    <owl:Class rdf:about="http://purl.org/ffonto#IncidentCommandSystem">
        <rdfs:comment>ICS roles should be established in advance; see national incident management guidance for details.</rdfs:comment>
        <rdfs:label>Incident Command System (ICS)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#IncidentCommander -->


    <owl:Class rdf:about="http://purl.org/ffonto#IncidentCommander">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#IncidentCommandSystem"/>
        <rdfs:comment xml:lang="en">The person with overall responsibility for managing an incident and its response.</rdfs:comment>
        <rdfs:label>Incident Commander</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#IncidentReport -->


    <owl:Class rdf:about="http://purl.org/ffonto#IncidentReport">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A formal document or record detailing the occurrence, response, and conditions of a specific emergency event.</rdfs:comment>
        <rdfs:label xml:lang="en">incident report</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#IncompleteCombustion -->


    <owl:Class rdf:about="http://purl.org/ffonto#IncompleteCombustion">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#CombustionProcess"/>
        <rdfs:comment>Combustion that occurs with insufficient oxygen, producing carbon monoxide and other pollutants.</rdfs:comment>
        <rdfs:label>Incomplete Combustion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#IndirectAttack -->


    <owl:Class rdf:about="http://purl.org/ffonto#IndirectAttack">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SuppressionMethod"/>
        <rdfs:comment xml:lang="en">A firefighting tactic where control lines are established at a distance and fires are allowed to burn to them.</rdfs:comment>
        <rdfs:label>Indirect Attack</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#IndoorAirQualityStrategy -->


    <owl:Class rdf:about="http://purl.org/ffonto#IndoorAirQualityStrategy">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AirQualityMitigationStrategy"/>
        <rdfs:comment>Methods to improve indoor air quality during smoke events.</rdfs:comment>
        <rdfs:label>Indoor Air Quality Strategy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#InformationResource -->


    <owl:Class rdf:about="http://purl.org/ffonto#InformationResource">
        <rdfs:comment>Online resources providing wildfire safety and health information.</rdfs:comment>
        <rdfs:label>Information Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#InformationSystem -->


    <owl:Class rdf:about="http://purl.org/ffonto#InformationSystem">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A structured set of software, hardware, and networks used to collect, process, manage, and distribute data.</rdfs:comment>
        <rdfs:label xml:lang="en">information system</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Infrastructure -->


    <owl:Class rdf:about="http://purl.org/ffonto#Infrastructure">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SceneElement"/>
        <rdfs:comment>Human-built structures within natural landscapes.</rdfs:comment>
        <rdfs:comment>Temporary or permanent structures used during wildfire response.</rdfs:comment>
        <rdfs:label>Infrastructure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#InfrastructureRisk -->


    <owl:Class rdf:about="http://purl.org/ffonto#InfrastructureRisk">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:comment>Risks posed to roads, settlements, water supply systems, or utilities.</rdfs:comment>
        <rdfs:label>Infrastructure Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#InsectInfestation -->


    <owl:Class rdf:about="http://purl.org/ffonto#InsectInfestation">
