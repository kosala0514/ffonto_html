        <rdfs:label>Perimeter Snapshot</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Person -->


    <owl:Class rdf:about="http://purl.org/ffonto#Person"/>
    


    <!-- http://purl.org/ffonto#PestInfestation -->


