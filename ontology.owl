        <rdfs:range rdf:resource="http://purl.org/ffonto#SoilQuality"/>
        <rdfs:comment>Indicates soil quality factors influencing vegetation distribution.</rdfs:comment>
        <rdfs:label>influenced by soil quality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#influencedBySoilQualityOf -->


