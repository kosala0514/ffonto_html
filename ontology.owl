        <rdfs:label>indicates ecological stress</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#indicatesEcologicalStressOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#indicatesEcologicalStressOf">
