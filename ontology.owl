        <rdfs:domain rdf:resource="http://purl.org/ffonto#EnvironmentalCondition"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Links a specific weather state, fuel moisture level, or atmospheric metric back to the geographic region or incident it describes.</rdfs:comment>
        <rdfs:label xml:lang="en">is environmental condition of</rdfs:label>
        <rdfs:label>is environmental condition of</rdfs:label>
    </owl:ObjectProperty>
    


