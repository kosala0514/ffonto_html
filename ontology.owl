        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFireTechnology"/>
        <rdfs:comment xml:lang="en">Denotes that technology or technical systems are utilized within an activity.</rdfs:comment>
        <rdfs:label>uses technology</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#usesTechnologyOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#usesTechnologyOf">
