        <rdfs:range rdf:resource="http://purl.org/ffonto#FireRiskAssessment"/>
        <rdfs:comment xml:lang="en">Links an entity to an assessment that evaluates potential risks and vulnerabilities.</rdfs:comment>
        <rdfs:label>has risk assessment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasRiskLevel -->


