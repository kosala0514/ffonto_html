        <rdfs:domain rdf:resource="http://purl.org/ffonto#Groundwater"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WaterAvailability"/>
        <rdfs:comment xml:lang="en">Inverse relation linking an entity to the groundwater influences that affect it.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of influenced by groundwater</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#influencedBySoilQuality -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#influencedBySoilQuality">
