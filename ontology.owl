    </owl:Class>
    


    <!-- http://purl.org/ffonto#PlanningSection -->


    <owl:Class rdf:about="http://purl.org/ffonto#PlanningSection">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#IncidentCommandSection"/>
