        <rdfs:label>Plant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#PlantFlammabilityTrait -->


    <owl:Class rdf:about="http://purl.org/ffonto#PlantFlammabilityTrait">
