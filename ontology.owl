        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ParticulateMatter"/>
        <rdfs:comment xml:lang="en">Fine particulate matter with diameter ≤2.5 micrometers, associated with health impacts.</rdfs:comment>
        <rdfs:comment>Fine particulate matter with a diameter of 2.5 micrometers or less.</rdfs:comment>
        <rdfs:label>PM2.5 Particulate Matter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#PerimeterSnapshot -->


    <owl:Class rdf:about="http://purl.org/ffonto#PerimeterSnapshot">
