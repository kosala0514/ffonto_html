        <rdfs:label>protects structure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#threatenedByHazard -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#threatenedByHazard">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Responder"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:comment>Indicates responders or civilians are threatened by operational hazards.</rdfs:comment>
        <rdfs:label>threatened by hazard</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#threatenedByHazardOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#threatenedByHazardOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#threatenedByHazard"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Responder"/>
