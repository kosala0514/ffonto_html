        <rdfs:label>inhibits species group</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#inhibitsSpeciesOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#inhibitsSpeciesOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#inhibitsSpecies"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#VegetationFunctionalGroup"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#EcologicalEffect"/>
