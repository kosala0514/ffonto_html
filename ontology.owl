        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFireTechnology"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Relates a specific technological system or device back to the operational process or organization utilizing it.</rdfs:comment>
        <rdfs:label xml:lang="en">uses technology of</rdfs:label>
        <rdfs:label>uses technology of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#usesVehicle -->


