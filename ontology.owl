        <rdfs:range rdf:resource="http://purl.org/ffonto#FireBehaviorModel"/>
        <rdfs:comment xml:lang="en">Relates meteorological conditions to the computational model predicting fire spread and dynamics.</rdfs:comment>
        <rdfs:label xml:lang="en">weather influences fire behavior model</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#workingNear -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#workingNear">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Responder"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#StructureFire"/>
        <rdfs:comment>Indicates a responder group is operating near (or adjacent to) a structure.</rdfs:comment>
        <rdfs:label>working near</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#workingNearOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#workingNearOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#workingNear"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#StructureFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Responder"/>
        <rdfs:comment xml:lang="en">Inverse relation indicating personnel or equipment working near a referenced location or hazard.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of working near</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isHostedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isHostedBy">
        <rdfs:comment xml:lang="en">Relation between a Sensor, Actuator, Sampler, or Platform, and the Platform that it is mounted on or hosted by.</rdfs:comment>
        <rdfs:label xml:lang="en">is hosted by</rdfs:label>
    </owl:ObjectProperty>
    


