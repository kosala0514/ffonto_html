        <rdfs:label xml:lang="en">inverse of is fire driver</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isFireEventOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isFireEventOf">
