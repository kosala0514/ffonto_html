    <!-- http://purl.org/ffonto#PrescribedBurn -->


    <owl:Class rdf:about="http://purl.org/ffonto#PrescribedBurn">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PreventionMeasure"/>
