    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#simulatedByActivity -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#simulatedByActivity">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#simulatesFire"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Activity"/>
