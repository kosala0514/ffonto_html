        <rdfs:domain rdf:resource="http://purl.org/ffonto#HealthEffect"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AirToxic"/>
        <rdfs:comment xml:lang="en">Inverse relation linking health effects back to exposures or events that caused them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of causes health effect</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#causesHealthRisk -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#causesHealthRisk">
