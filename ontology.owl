        <rdfs:label>Trend (enum)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Tundra -->


    <owl:Class rdf:about="http://purl.org/ffonto#Tundra">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Ecosystem"/>
