        <rdfs:label>air quality descriptor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#airTemperature -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#airTemperature">
