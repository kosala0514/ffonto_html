        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Represents the radiative power of a fire event, indicating its intensity.</rdfs:comment>
        <rdfs:label>fire radiative power</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#fireReachedWaterEdge -->


