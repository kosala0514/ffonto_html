        <rdfs:label>soil nutrient index</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#soilNutrientLevel -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#soilNutrientLevel">
