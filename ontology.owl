        <rdfs:label>fire confidence level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#fireHydrantVisible -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#fireHydrantVisible">
