        <rdfs:domain rdf:resource="http://purl.org/ffonto#TemporaryFlightRestriction"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Airspace"/>
        <rdfs:comment xml:lang="en">Indicates that a policy, hazard condition, or command decision limits flight operations within a specific zone.</rdfs:comment>
        <rdfs:label xml:lang="en">restricts airspace</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#resultsInDropZone -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#resultsInDropZone">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ClearDropZoneAction"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ClearedDropZone"/>
