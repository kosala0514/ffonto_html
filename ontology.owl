        <rdfs:label>Fire Type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireWeatherIndex -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireWeatherIndex">
        <rdfs:comment>Index combining temperature, humidity, wind and precipitation to quantify fire risk.</rdfs:comment>
        <rdfs:label>Fire Weather Index (FWI)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireWeatherRecord -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireWeatherRecord">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#WeatherObservation"/>
