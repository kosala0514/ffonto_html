    <!-- http://purl.org/ffonto#mayCauseIgnitionOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#mayCauseIgnitionOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#mayCauseIgnition"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#IgnitionSource"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#PowerInfrastructureFailure"/>
        <rdfs:comment xml:lang="en">Indicates the potential for a heat source, event, or material to start a fire in a specific target or environment.</rdfs:comment>
        <rdfs:label xml:lang="en">may cause ignition of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#mayIgnite -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#mayIgnite">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FarmEquipment"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#IgnitionSource"/>
        <rdfs:comment xml:lang="en">Indicates the potential for a specific material, fuel load, or area to catch fire under the current environmental conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">may ignite</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#mayIgniteOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#mayIgniteOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#mayIgnite"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#IgnitionSource"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FarmEquipment"/>
        <rdfs:comment xml:lang="en">Indicates the potential relationship between a heat source (like an ember) and the specific combustible target material it could set on fire.</rdfs:comment>
        <rdfs:label xml:lang="en">may ignite of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#measuredFrom -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#measuredFrom">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireRadiativePower"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#SatelliteData"/>
        <rdfs:comment xml:lang="en">Connects an observation, metric, or distance to the physical location or temporal baseline serving as its starting point.</rdfs:comment>
        <rdfs:label xml:lang="en">measured from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#measuredOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#measuredOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#measuredFrom"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SatelliteData"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireRadiativePower"/>
        <rdfs:comment xml:lang="en">Relates a recorded value, statistic, or qualitative observation back to the specific entity, area, or phenomenon that was analyzed.</rdfs:comment>
        <rdfs:label xml:lang="en">measured of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#measuresPollution -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#measuresPollution">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isMeasuredByAQI"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AirQualityIndex"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ParticulateMatterPM25"/>
        <rdfs:comment xml:lang="en">Indicates that a device, system, or observation process quantifies the concentration of contaminants or particulates in the environment.</rdfs:comment>
        <rdfs:label xml:lang="en">measures pollution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#mediaKeptAtDistance -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#mediaKeptAtDistance">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#mediaKeptAtDistanceOf"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Responder"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#MediaGroup"/>
        <rdfs:comment>Indicates media/observers are held at a safe distance by responders.</rdfs:comment>
        <rdfs:label>media kept at distance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#mediaKeptAtDistanceOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#mediaKeptAtDistanceOf">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#MediaGroup"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Responder"/>
        <rdfs:comment>Inverse - Indicates media/observers are held at a safe distance by responders.</rdfs:comment>
        <rdfs:label>media kept at distance of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#meteorologicalVariableAffectsRateOfSpread -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#meteorologicalVariableAffectsRateOfSpread">
        <rdfs:comment xml:lang="en">Links weather-related data, such as wind velocity or relative humidity, to its direct impact on how rapidly a fire perimeter expands.</rdfs:comment>
        <rdfs:label xml:lang="en">meteorological variable affects rate of spread</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#mitigatedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#mitigatedBy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ProtectiveAction"/>
        <rdfs:comment xml:lang="en">Associates hazards or risks with measures that reduce their likelihood or impact.</rdfs:comment>
        <rdfs:label>mitigated by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#mitigatedOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#mitigatedOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#mitigatedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ProtectiveAction"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Hazard"/>
        <rdfs:comment xml:lang="en">Inverse relation linking mitigated risks or impacts back to the mitigation measures applied.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of mitigated by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#mitigatesAirPollution -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#mitigatesAirPollution">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isMitigatedByStrategy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AirQualityMitigationStrategy"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AirPollutionMetric"/>
        <rdfs:comment xml:lang="en">Relates an air quality mitigation strategy to the specific air pollution metric it addresses.</rdfs:comment>
        <rdfs:label xml:lang="en">mitigates air pollution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#mitigatesRisk -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#mitigatesRisk">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireRiskAssessment"/>
        <rdfs:comment>Indicates that an action or policy mitigates wildfire risk.</rdfs:comment>
        <rdfs:label>mitigates risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#mitigatesRiskOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#mitigatesRiskOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#mitigatesRisk"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireRiskAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Inverse relation linking mitigation measures to the risks they reduce for specific targets.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of mitigates risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#modelOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#modelOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#usedModel"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#MLModel"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#VisionModelScores"/>
        <rdfs:comment>inverse of use model</rdfs:comment>
        <rdfs:label>model of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#modeledBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#modeledBy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireProbabilityModel"/>
        <rdfs:comment>Link from incident/image to a probability model producing fire probability.</rdfs:comment>
        <rdfs:label>modeled by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#modeledOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#modeledOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#modeledBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireProbabilityModel"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment>Inverse - Link from incident/image to a probability model producing fire probability.</rdfs:comment>
        <rdfs:label>modeled of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#modifiesSoilCondition -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#modifiesSoilCondition">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#SoilCondition"/>
        <rdfs:comment>Indicates that a wildfire alters the condition of soil, such as reducing infiltration or increasing hydrophobicity.</rdfs:comment>
        <rdfs:label>modifies soil condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#modifiesSoilConditionOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#modifiesSoilConditionOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#modifiesSoilCondition"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SoilCondition"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking soil modification actions back to the locations or projects they affect.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of modifies soil condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#monitoredBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#monitoredBy">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#RemoteSensing"/>
        <rdfs:comment xml:lang="en">Links a wildfire incident or environment to the monitoring system observing it.</rdfs:comment>
        <rdfs:label xml:lang="en">monitored by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#monitoredOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#monitoredOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#monitoredBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#RemoteSensing"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking monitoring records back to the objects or sites monitored.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of monitored by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#monitoredUsing -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#monitoredUsing">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#RemoteSensingSensor"/>
        <rdfs:comment>Links wildfire monitoring to remote sensing systems.</rdfs:comment>
        <rdfs:label>monitored using</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#monitoredUsingInverse -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#monitoredUsingInverse">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#monitoredUsing"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#RemoteSensingSensor"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking monitoring methods back to the systems or sites they monitor.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of monitored using</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#monitorsAirspace -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#monitorsAirspace">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AirspaceConflictDetection"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Airspace"/>
        <rdfs:comment xml:lang="en">Links a system, sensor, or operational agent to the act of observing a designated aerial volume for traffic or hazards.</rdfs:comment>
        <rdfs:label xml:lang="en">monitors airspace</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#monitorsAirspaceOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#monitorsAirspaceOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#monitorsAirspace"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Airspace"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#AirspaceConflictDetection"/>
        <rdfs:comment xml:lang="en">Indicates that a system or entity is observing the aerial zone above a specific location or incident.</rdfs:comment>
        <rdfs:label xml:lang="en">monitors airspace of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#monitorsInfrastructure -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#monitorsInfrastructure">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:comment xml:lang="en">The activity of observing and assessing the condition of critical infrastructure.</rdfs:comment>
        <rdfs:label>monitors infrastructure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#monitorsInfrastructureOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#monitorsInfrastructureOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#monitorsInfrastructure"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Infrastructure"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:comment xml:lang="en">Inverse relation linking infrastructure monitoring activities back to the organizations or systems responsible.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of monitors infrastructure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#monitorsModel -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#monitorsModel">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isModelMonitoredBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ModelMonitoring"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireBehaviorModel"/>
        <rdfs:comment xml:lang="en">Connects a governance framework, overarching system, or human operator to the AI or simulation model being overseen.</rdfs:comment>
        <rdfs:label xml:lang="en">monitors model</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#monitorsSystem -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#monitorsSystem">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isSystemMonitoredBy"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#CanaryDeployment"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#DecisionSupportSystem"/>
        <rdfs:comment xml:lang="en">Links an oversight framework, human agent, or diagnostic software to the specific operational or IT system it observes.</rdfs:comment>
        <rdfs:label xml:lang="en">monitors system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#mustFollowGuideline -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#mustFollowGuideline">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isApplicableToScene"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WildfireScene"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#HazardousWasteGuideline"/>
        <rdfs:comment>Inverse - Links a wildfire scene to the hazardous waste guidelines that apply to it post-fire.</rdfs:comment>
        <rdfs:label xml:lang="en">must follow guideline</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#observedAtLocation -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#observedAtLocation">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Location"/>
        <rdfs:comment>Location or feature where an observation was recorded (e.g., NE flank ridgeline).</rdfs:comment>
        <rdfs:label>observed at location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#observedAtLocationOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#observedAtLocationOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#observedAtLocation"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Location"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:comment xml:lang="en">Inverse relation linking observations back to the locations where they were recorded.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of observed at location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#observedAtScene -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#observedAtScene">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WildfireScene"/>
        <rdfs:label xml:lang="en">observed at scene</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#observedInImage -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#observedInImage">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ImageObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#WildfireScene"/>
        <rdfs:comment>Relates an observation to the environmental image in which it was detected.</rdfs:comment>
        <rdfs:label>observed in image</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#observedInImageOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#observedInImageOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#observedInImage"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#WildfireScene"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ImageObservation"/>
        <rdfs:comment xml:lang="en">Inverse relation linking observations to the images in which they were detected.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of observed in image</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#observedProperty -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#observedProperty">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Result"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ObservableProperty"/>
        <rdfs:comment>The property that was observed or estimated.</rdfs:comment>
        <rdfs:label>observed property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#observedPropertyOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#observedPropertyOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#observedProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ObservableProperty"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Result"/>
        <rdfs:comment>Inverse of observed property.</rdfs:comment>
        <rdfs:label>observed property of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#observesProperty -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#observesProperty">
        <rdfs:comment xml:lang="en">Links a sensor, platform, or observation act to the specific physical or chemical characteristic it measures.</rdfs:comment>
        <rdfs:label xml:lang="en">observes property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#occurs -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#occurs">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#occursIn"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WildfireScene"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment>Inverse - Specifies the forest ecosystem where a fire event takes place.</rdfs:comment>
        <rdfs:label>occurs</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#occursAtLocation -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#occursAtLocation">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#locationOfEvent"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment xml:lang="en">Relates an incident, observation, or action to the specific geospatial coordinates or boundary area where it takes place.</rdfs:comment>
        <rdfs:label xml:lang="en">occurs at location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#occursDuring -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#occursDuring">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isOperationalPeriodOf"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WildfireIncident"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#OperationalPeriod"/>
        <rdfs:comment xml:lang="en">A temporal relationship linking an event or action to the timeframe or larger incident in which it happens.</rdfs:comment>
        <rdfs:label xml:lang="en">occurs during</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#occursForPurpose -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#occursForPurpose">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#IntentionalFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#LandClearing"/>
        <rdfs:comment>Indicates the purpose for which an intentional fire is set.</rdfs:comment>
        <rdfs:label>occurs for purpose</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#occursForPurposeOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#occursForPurposeOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#occursForPurpose"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#LandClearing"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#IntentionalFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking activities to the purposes for which they occur.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of occurs for purpose</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#occursIn -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#occursIn">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WildfireScene"/>
        <rdfs:comment>Specifies the forest ecosystem where a fire event takes place.</rdfs:comment>
        <rdfs:label>occurs in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#occursInAirspace -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#occursInAirspace">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FlightPath"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Airspace"/>
        <rdfs:comment xml:lang="en">Indicates that an aerial operation, flight path, or meteorological event takes place within a designated volumetric flight zone.</rdfs:comment>
        <rdfs:label xml:lang="en">occurs in airspace</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#occursInArea -->


