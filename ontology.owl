        <rdfs:label xml:lang="en">inverse of tool in use</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#tracksAircraft -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#tracksAircraft">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isTrackedBy"/>
