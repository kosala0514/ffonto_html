        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking fuel condition assessments to the locations or fuelbeds they describe.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of is fuel condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#isFuelLoadIOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#isFuelLoadIOf">
