        <rdfs:label xml:lang="en">inverse of uses suppression method</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#usesTechnology -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#usesTechnology">
