        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>air temperature</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#aircraftStabilityAffected -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#aircraftStabilityAffected">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AerialVehicle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether strong fire convection affects aircraft stability.</rdfs:comment>
        <rdfs:label>aircraft stability affected by updrafts</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#airtankerVisible -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#airtankerVisible">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AircraftAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Observation that an airtanker aircraft is present in the area of operations.</rdfs:comment>
        <rdfs:label>airtanker (fixed-wing) visible</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#alertFieldsComplete -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#alertFieldsComplete">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates that required alert metadata fields have been populated.</rdfs:comment>
        <rdfs:label>all alerting fields present</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#alertReady -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#alertReady">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AlertSystemStatus"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates if all required fields are present for automated alerts.</rdfs:comment>
        <rdfs:label>alert ready</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#alternateRouteVisible -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#alternateRouteVisible">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Road"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Observation that an alternate travel route is present and discernible.</rdfs:comment>
        <rdfs:label>alternate route visible</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#animalsBeingLoaded -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#animalsBeingLoaded">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Observation that animals are being placed into transport for evacuation.</rdfs:comment>
        <rdfs:label>animals being loaded for evacuation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#animalsPennedInThreatenedArea -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#animalsPennedInThreatenedArea">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
