        <rdfs:range rdf:resource="http://purl.org/ffonto#EnvironmentalRisk"/>
        <rdfs:comment>Indicates factors that increase environmental hazards.</rdfs:comment>
        <rdfs:label>increases environmental risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#increasesEnvironmentalRiskOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#increasesEnvironmentalRiskOf">
