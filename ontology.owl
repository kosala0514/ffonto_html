        <rdfs:label>combustible siding present</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasConfidence -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasConfidence">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Associates an entity with a confidence metric expressing certainty.</rdfs:comment>
        <rdfs:label>confidence value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasCountry -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasCountry">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SpatialExtent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Links a geographic location, incident, or administrative entity to its sovereign national boundary.</rdfs:comment>
        <rdfs:label xml:lang="en">has country</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#hasCracklingSound -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#hasCracklingSound">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AudioObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
