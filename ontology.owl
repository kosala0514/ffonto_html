        <rdfs:label>causes ecological impact</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#causesEcologicalImpactOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#causesEcologicalImpactOf">
