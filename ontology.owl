        <rdfs:label xml:lang="en">has logistics support</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasManagementPurpose -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasManagementPurpose">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ManagementAction"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ManagementPurpose"/>
        <rdfs:comment>The stated objective of a management action (e.g., fuel reduction).</rdfs:comment>
        <rdfs:label>has management purpose</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasMediaAsset -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasMediaAsset">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#MediaAsset"/>
        <rdfs:comment>Connects incident to the captured media file.</rdfs:comment>
        <rdfs:label>has media asset</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasModel -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasModel">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ProvenanceRecord"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#MLModel"/>
        <rdfs:comment xml:lang="en">Relates a predictive system, research project, or hardware device to the specific computational framework or conceptual model it relies upon.</rdfs:comment>
        <rdfs:label xml:lang="en">has model</rdfs:label>
        <rdfs:label>has model</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasModelProvenance -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasModelProvenance">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isModelProvenanceOf"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ModelOutput"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ModelProvenance"/>
        <rdfs:comment xml:lang="en">Connects a predictive model or AI output to the documentation detailing its training data, versioning, and lineage.</rdfs:comment>
        <rdfs:label xml:lang="en">has model provenance</rdfs:label>
        <rdfs:label>has model provenance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasMonitoringObservation -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasMonitoringObservation">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SpatialUnit"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:comment>Links a spatial unit to remote-sensing or image-derived observations.</rdfs:comment>
        <rdfs:label>has monitoring observation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasNeighborSupportPlan -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasNeighborSupportPlan">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#EvacuationZone"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#NeighborSupportPlan"/>
        <rdfs:comment xml:lang="en">Links a community or jurisdiction to a mutual aid agreement or strategy for assisting adjacent areas.</rdfs:comment>
        <rdfs:label xml:lang="en">has neighbor support plan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasObservation -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasObservation">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#isObservationOf"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:comment xml:lang="en">Associates an entity with a recorded observation or measurement.</rdfs:comment>
        <rdfs:label xml:lang="en">has observation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasOperation -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasOperation">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FirefightingOperation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#WildfireScene"/>
        <rdfs:comment>Indicates that an operation occurs in a wildfire scene.</rdfs:comment>
        <rdfs:label>has operation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasPerimeterSnapshot -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasPerimeterSnapshot">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#PerimeterSnapshot"/>
        <rdfs:comment>Links an incident to the latest perimeter snapshot used to compute area.</rdfs:comment>
        <rdfs:label>has perimeter snapshot</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasPlantComponent -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasPlantComponent">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Vegetation"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Plant"/>
        <rdfs:comment>Relates a vegetation unit or plant community to the plant species or plant types that constitute its biological components.</rdfs:comment>
        <rdfs:label>has plant component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#hasPredictionUncertainty -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#hasPredictionUncertainty">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#FireBehaviorModel"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#PredictionUncertainty"/>
