    </owl:Class>
    


    <!-- http://purl.org/ffonto#FirePresenceObservation -->


    <owl:Class rdf:about="http://purl.org/ffonto#FirePresenceObservation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ImageObservation"/>
        <rdfs:comment>An observation indicating visible flames, burn marks, or other indicators suggesting that a fire event is occurring.</rdfs:comment>
        <rdfs:label>Fire Presence Observation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireProbabilityModel -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireProbabilityModel">
        <rdfs:comment>Model output describing fire probability for an image/frame.</rdfs:comment>
        <rdfs:label>Fire Probability Model</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireRadiativePower -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireRadiativePower">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireBehavior"/>
        <rdfs:comment xml:lang="en">A measurement of fire energy release rate estimated from thermal remote sensing data.</rdfs:comment>
        <rdfs:label>Fire Radiative Power</rdfs:label>
        <rdfs:label>Fire Radiative Power (FRP)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireRegime -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireRegime">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ClimatePattern"/>
