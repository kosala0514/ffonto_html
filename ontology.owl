        <rdfs:label>Nutrient Cycling</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#NutrientPoorSoil -->


    <owl:Class rdf:about="http://purl.org/ffonto#NutrientPoorSoil">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SoilQuality"/>
        <rdfs:comment>Soil with low nutrient availability limiting vegetation growth.</rdfs:comment>
        <rdfs:label>Nutrient poor soil</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ObservableProperty -->


    <owl:Class rdf:about="http://purl.org/ffonto#ObservableProperty">
        <rdfs:comment>Observable Property.</rdfs:comment>
        <rdfs:label>ObservableProperty</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Observation -->


    <owl:Class rdf:about="http://purl.org/ffonto#Observation">
        <rdfs:comment>An observation or record about conditions at a wildfire scene.</rdfs:comment>
        <rdfs:label>Observation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ObservationSystem -->


    <owl:Class rdf:about="http://purl.org/ffonto#ObservationSystem">
        <rdfs:comment>The system, sensor, or platform generating the data.</rdfs:comment>
        <rdfs:label>Observation System</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#OperationalPeriod -->


    <owl:Class rdf:about="http://purl.org/ffonto#OperationalPeriod">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#TemporalExtent"/>
        <rdfs:comment xml:lang="en">A defined time interval for which incident operations are planned or reported.</rdfs:comment>
        <rdfs:label>Operational Period</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#OperationalStrategy -->


    <owl:Class rdf:about="http://purl.org/ffonto#OperationalStrategy">
        <rdfs:comment xml:lang="en">A high-level plan of action designed to achieve specific goals during an incident response.</rdfs:comment>
        <rdfs:label xml:lang="en">operational strategy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#OperationsSection -->


    <owl:Class rdf:about="http://purl.org/ffonto#OperationsSection">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#IncidentCommandSection"/>
        <rdfs:comment xml:lang="en">The organizational unit responsible for tactical operations during an incident.</rdfs:comment>
        <rdfs:label>Operations Section</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#OpticalScattering -->


    <owl:Class rdf:about="http://purl.org/ffonto#OpticalScattering">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AirPollutantProperty"/>
