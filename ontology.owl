        <rdfs:label xml:lang="en">collects satellite data</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#combinesForecastModels -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#combinesForecastModels">
