        <rdfs:range rdf:resource="http://purl.org/ffonto#Firefighter"/>
        <rdfs:comment xml:lang="en">Inverse relation linking training-through relationships back to the methods or data used.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of trained through</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#trainedWith -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#trainedWith">
