        <rdfs:domain rdf:resource="http://purl.org/ffonto#HealthRisk"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking health risk records back to the exposures or events causing them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of causes health risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#causesImpact -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#causesImpact">
