        <rdfs:label>Fire Triangle</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#FireTruck -->


    <owl:Class rdf:about="http://purl.org/ffonto#FireTruck">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#EmergencyVehicle"/>
