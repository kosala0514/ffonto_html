        <rdfs:label xml:lang="en">utilizes device</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#validatesData -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#validatesData">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#QualityControlProcess"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#SatelliteData"/>
        <rdfs:comment xml:lang="en">Indicates that a process, algorithm, or authority checks and confirms the accuracy or integrity of a specific dataset.</rdfs:comment>
        <rdfs:label xml:lang="en">validates data</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#validatesDataOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#validatesDataOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#validatesData"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SatelliteData"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#QualityControlProcess"/>
        <rdfs:comment xml:lang="en">Links a verification process, algorithm, or authority to the information source or dataset being checked for accuracy.</rdfs:comment>
        <rdfs:label xml:lang="en">validates data of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#vehiclePartOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#vehiclePartOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#partOfVehicle"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Vehicle"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#Window"/>
        <rdfs:comment>Inverse - Indicates that a window is part of a vehicle.</rdfs:comment>
        <rdfs:label>vehicle part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#verifiesReport -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#verifiesReport">
