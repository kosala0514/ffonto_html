        <rdfs:label xml:lang="en">classifies visibility</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#climateDriverInfluencesFireWeatherIndex -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#climateDriverInfluencesFireWeatherIndex">
