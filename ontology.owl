        <rdfs:label xml:lang="en">tracks aircraft</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#trainedThrough -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#trainedThrough">
