        <rdfs:domain rdf:resource="http://purl.org/ffonto#EcologicalStress"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#VegetationCondition"/>
        <rdfs:comment xml:lang="en">Inverse relation linking indicators of ecological stress back to the areas or populations affected.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of indicates ecological stress</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#indicatesMoistureCondition -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#indicatesMoistureCondition">
