        <rdfs:label>causes animal smoke exposure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#causesAnimalSmokeExposureOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#causesAnimalSmokeExposureOf">
        <owl:inverseOf rdf:resource="http://purl.org/ffonto#causesAnimalSmokeExposure"/>
        <rdfs:domain rdf:resource="http://purl.org/ffonto#AnimalSmokeExposure"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:comment xml:lang="en">Inverse relation linking animal smoke exposure records back to the events causing the exposure.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of causes animal smoke exposure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#causesCardiacIssue -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#causesCardiacIssue">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ParticulateMatterPM25"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#CardiacIssue"/>
