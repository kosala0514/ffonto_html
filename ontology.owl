        <rdfs:domain rdf:resource="http://purl.org/ffonto#WaterSource"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FirefightingOperation"/>
        <rdfs:comment xml:lang="en">Inverse relation linking water source usage back to the operations or facilities that used them.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of uses water source</rdfs:label>
    </owl:ObjectProperty>
    


