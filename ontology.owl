    <!-- http://purl.org/ffonto#whiteGrayAshVisible -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#whiteGrayAshVisible">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#SoilCondition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates presence of white or gray ash suggesting complete combustion.</rdfs:comment>
        <rdfs:label>white or gray ash visible</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#wildlifeAfterFireGuidance -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#wildlifeAfterFireGuidance">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#PublicSafetyGuidance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Recommendations for protecting and managing wildlife in post-fire environments.</rdfs:comment>
        <rdfs:label>guidance about wildlife encounters after a fire</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#windConsistentWithSmoke -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#windConsistentWithSmoke">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ModalityConsistency"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates that observed wind direction and speed align with smoke movement.</rdfs:comment>
        <rdfs:label>wind consistent with smoke movement</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#windDirection -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#windDirection">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WeatherObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The compass direction from which wind is blowing at a location.</rdfs:comment>
        <rdfs:label>wind direction</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#windEffectOnAerial -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#windEffectOnAerial">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WeatherObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Assessment whether wind reduces aerial drop effectiveness.</rdfs:comment>
        <rdfs:label>wind effect on aerial drops (yes/no/qualifier)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#windGust -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#windGust">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#MeteorologicalObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Peak gust speed in km/h.</rdfs:comment>
        <rdfs:label>wind gust (km/h)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#windSpeed -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#windSpeed">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#MeteorologicalObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Sustained wind speed in km/h.</rdfs:comment>
        <rdfs:label>wind speed (km/h)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#windStrong -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#windStrong">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#WeatherObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>High-level assessment whether wind is considered strong.</rdfs:comment>
        <rdfs:label>is wind strong</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#windowsBroken -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#windowsBroken">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Window"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether windows were broken due to heat or impact.</rdfs:comment>
        <rdfs:label>windows broken</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#windowsExposedToSmoke -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#windowsExposedToSmoke">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether windows are exposed to smoke or embers during wildfire.</rdfs:comment>
        <rdfs:label>windows exposed to smoke or embers</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#windowsOrEavesExposedToSmoke -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#windowsOrEavesExposedToSmoke">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether windows or eaves are exposed to flames or heavy smoke.</rdfs:comment>
        <rdfs:label>windows or eaves exposed to smoke</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#zshotModel -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#zshotModel">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ProvenanceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Relates an analytical process or system to the specific zero-shot learning AI model utilized for classification or prediction.</rdfs:comment>
        <rdfs:label xml:lang="en">zero-shot model</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/ffonto#ADSB -->


    <owl:Class rdf:about="http://purl.org/ffonto#ADSB">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AircraftTracking"/>
        <rdfs:comment xml:lang="en">Automatic Dependent Surveillance–Broadcast; an aircraft surveillance technology broadcasting position information.</rdfs:comment>
        <rdfs:label>Automatic Dependent Surveillance Broadcast (ADS-B)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AIModelGovernance -->


    <owl:Class rdf:about="http://purl.org/ffonto#AIModelGovernance">
        <rdfs:comment xml:lang="en">The policies, procedures, and ethical guidelines governing the deployment and use of artificial intelligence models within the system.</rdfs:comment>
        <rdfs:label xml:lang="en">AI model governance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AccessConstraint -->


    <owl:Class rdf:about="http://purl.org/ffonto#AccessConstraint">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PrivacyProtection"/>
        <rdfs:comment>Limited roads, steep slopes, blocked evacuation routes, equipment access issues.</rdfs:comment>
        <rdfs:label>Access Constraint</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AccessConstraintDetail -->


    <owl:Class rdf:about="http://purl.org/ffonto#AccessConstraintDetail">
        <rdfs:comment>Specific access limitations (road blockage, steep grade, narrow road).</rdfs:comment>
        <rdfs:label>Access Constraint Detail</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AccessControl -->


    <owl:Class rdf:about="http://purl.org/ffonto#AccessControl">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PrivacyProtection"/>
        <rdfs:comment xml:lang="en">Mechanisms that restrict or permit entry to locations or data based on rules.</rdfs:comment>
        <rdfs:label>Access Control</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AccidentalIgnition -->


    <owl:Class rdf:about="http://purl.org/ffonto#AccidentalIgnition">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#IgnitionSource"/>
        <owl:disjointWith rdf:resource="http://purl.org/ffonto#NaturalIgnition"/>
        <owl:disjointWith rdf:resource="http://purl.org/ffonto#PlannedIgnition"/>
        <rdfs:comment>Human-caused accidental ignition.</rdfs:comment>
        <rdfs:label>Accidental ignition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AcresBurnedStatistic -->


    <owl:Class rdf:about="http://purl.org/ffonto#AcresBurnedStatistic">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#WildfireStatistic"/>
        <rdfs:label xml:lang="en">Acres Burned</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ActiveFire -->


    <owl:Class rdf:about="http://purl.org/ffonto#ActiveFire">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ContainmentState"/>
        <rdfs:comment xml:lang="en">An area where combustion is currently occurring and producing flames, heat, or smoke.</rdfs:comment>
        <rdfs:label>Active Fire</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ActiveFireDetection -->


    <owl:Class rdf:about="http://purl.org/ffonto#ActiveFireDetection">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Observation"/>
        <rdfs:comment>Satellite detection of actively burning fires using thermal sensors.</rdfs:comment>
        <rdfs:label>Active Fire Detection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#ActiveLearning -->


    <owl:Class rdf:about="http://purl.org/ffonto#ActiveLearning">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ModelTrainingTechnique"/>
        <rdfs:comment xml:lang="en">A machine learning approach where the algorithm selects data points to be labeled to improve learning efficiency.</rdfs:comment>
        <rdfs:label>Active Learning</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AerialDropOperation -->


    <owl:Class rdf:about="http://purl.org/ffonto#AerialDropOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SuppressionOperation"/>
        <rdfs:comment xml:lang="en">A mission to release water, retardant, or supplies from aircraft to a target area.</rdfs:comment>
        <rdfs:label>Aerial Drop Operation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AerialDropPlanning -->


    <owl:Class rdf:about="http://purl.org/ffonto#AerialDropPlanning">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SuppressionTactic"/>
        <rdfs:comment xml:lang="en">The logistical planning process for aircraft drops including safety, target selection, and quantities.</rdfs:comment>
        <rdfs:label>Aerial Drop Planning</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AerialPatrol -->


    <owl:Class rdf:about="http://purl.org/ffonto#AerialPatrol">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#DetectionMethod"/>
        <rdfs:comment xml:lang="en">Aerial surveillance flight conducted to detect hazards, fires, or other incidents.</rdfs:comment>
        <rdfs:label>Aerial Patrol Detection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AerialResource -->


    <owl:Class rdf:about="http://purl.org/ffonto#AerialResource">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SuppressionResource"/>
        <rdfs:comment>Aircraft used for water or retardant drops.</rdfs:comment>
        <rdfs:label>Aerial Firefighting Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AerialVehicle -->


    <owl:Class rdf:about="http://purl.org/ffonto#AerialVehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Vehicle"/>
        <rdfs:comment>Aircraft used for aerial firefighting such as helicopters.</rdfs:comment>
        <rdfs:label>Aerial Firefighting Vehicle</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AerialVisibility -->


    <owl:Class rdf:about="http://purl.org/ffonto#AerialVisibility">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#VisibilityCondition"/>
        <rdfs:comment>Visibility condition relevant to aerial resources.</rdfs:comment>
        <rdfs:label>Aerial Visibility</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AgriculturalBuilding -->


    <owl:Class rdf:about="http://purl.org/ffonto#AgriculturalBuilding">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Building"/>
        <rdfs:comment xml:lang="en">A structure used for farming activities, storage, or livestock housing.</rdfs:comment>
        <rdfs:label>Agricultural Building</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AgriculturalBurn -->


    <owl:Class rdf:about="http://purl.org/ffonto#AgriculturalBurn">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#IntentionalFire"/>
        <rdfs:comment>A controlled fire used in agricultural practices such as clearing crop residues.</rdfs:comment>
        <rdfs:label>Agricultural Burn</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AgriculturalExpansion -->


    <owl:Class rdf:about="http://purl.org/ffonto#AgriculturalExpansion">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#LandCoverChange"/>
        <rdfs:comment>Conversion of natural landscapes into farmland.</rdfs:comment>
        <rdfs:label>Agricultural Expansion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AgriculturalLand -->


    <owl:Class rdf:about="http://purl.org/ffonto#AgriculturalLand">
        <rdfs:comment>Farms, crop fields, or managed grasslands impacted by wildfire.</rdfs:comment>
        <rdfs:label>Agricultural Land</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AgriculturalProduce -->


    <owl:Class rdf:about="http://purl.org/ffonto#AgriculturalProduce">
        <rdfs:comment>Food crops grown at home or on farms that may be affected by wildfire ash.</rdfs:comment>
        <rdfs:label>Agricultural Produce</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirAttackSupervisor -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirAttackSupervisor">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#IncidentCommandRole"/>
        <rdfs:comment xml:lang="en">An individual responsible for coordinating aerial firefighting resources and tactics.</rdfs:comment>
        <rdfs:label>Air Attack Supervisor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirCleaner -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirCleaner">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AirQualityMitigationDevice"/>
        <rdfs:comment>Device used to filter indoor air.</rdfs:comment>
        <rdfs:label>Air Cleaner</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirConditioner -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirConditioner">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AirCleaner"/>
        <rdfs:comment>Cooling system used indoors that may filter air.</rdfs:comment>
        <rdfs:label>Air Conditioner</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirPollutantProperty -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirPollutantProperty">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AirQualityIndex"/>
        <rdfs:comment>Physical or chemical characteristics of airborne pollutants.</rdfs:comment>
        <rdfs:label>Air Pollutant Property</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirPollution -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirPollution">
        <rdfs:comment>Airborne emissions resulting from fire (smoke, particulates).</rdfs:comment>
        <rdfs:label>Air pollution</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirPollutionMetric -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirPollutionMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ObservableProperty"/>
        <rdfs:comment xml:lang="en">A quantifiable measure used to assess the concentration of pollutants in the air.</rdfs:comment>
        <rdfs:label xml:lang="en">air pollution metric</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirQualityImpact -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirQualityImpact">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#PhysicalImpact"/>
        <rdfs:comment>Changes in atmospheric composition due to smoke and particulate matter.</rdfs:comment>
        <rdfs:label>Air Quality Impact</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirQualityIndex -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirQualityIndex">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AirPollutionMetric"/>
        <rdfs:comment xml:lang="en">A numeric scale indicating the quality of air and potential health impacts.</rdfs:comment>
        <rdfs:label>Air Quality Index</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirQualityMitigationDevice -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirQualityMitigationDevice">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <rdfs:comment xml:lang="en">A physical apparatus designed to monitor, filter, or improve air quality conditions during or after a fire.</rdfs:comment>
        <rdfs:label xml:lang="en">air quality mitigation device</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirQualityMitigationStrategy -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirQualityMitigationStrategy">
        <rdfs:comment xml:lang="en">A procedural or policy-based approach to reducing the harmful effects of air pollution on a population.</rdfs:comment>
        <rdfs:label xml:lang="en">air quality mitigation strategy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirQualityRisk -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirQualityRisk">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#HealthRisk"/>
        <rdfs:comment xml:lang="en">The risk to health or environment due to degraded air quality conditions.</rdfs:comment>
        <rdfs:label>Air Quality Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirSupport -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirSupport">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SuppressionMethod"/>
        <rdfs:comment xml:lang="en">Aerial resources assigned to assist ground operations, such as water drops or reconnaissance.</rdfs:comment>
        <rdfs:label>Air Support Suppression</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirTanker -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirTanker">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#Aircraft"/>
        <rdfs:comment>Aircraft used to drop fire retardant.</rdfs:comment>
        <rdfs:label>Air Tanker</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirTankerDrop -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirTankerDrop">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#SuppressionTactic"/>
        <rdfs:comment xml:lang="en">An aerial operation where an aircraft releases fire retardant or water over a target area.</rdfs:comment>
        <rdfs:label>Air Tanker Drop</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirToxic -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirToxic">
        <rdfs:comment>Hazardous air pollutants generated during wildfire combustion.</rdfs:comment>
        <rdfs:label>Air Toxic Pollutant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Aircraft -->


    <owl:Class rdf:about="http://purl.org/ffonto#Aircraft">
        <rdfs:comment>Aircraft used in wildfire suppression.</rdfs:comment>
        <rdfs:label>Aircraft</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AircraftAction -->


    <owl:Class rdf:about="http://purl.org/ffonto#AircraftAction">
        <rdfs:comment>Helicopter/aerial tanker activities (drops, bucket use, dip sites).</rdfs:comment>
        <rdfs:label>Aircraft Action</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AircraftSensor -->


    <owl:Class rdf:about="http://purl.org/ffonto#AircraftSensor">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#RemoteSensing"/>
        <rdfs:comment xml:lang="en">A sensor mounted on an aircraft used to collect airborne observations or imagery.</rdfs:comment>
        <rdfs:label>Aircraft Infrared Sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AircraftTracking -->


    <owl:Class rdf:about="http://purl.org/ffonto#AircraftTracking">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AirspaceManagement"/>
        <rdfs:comment xml:lang="en">Monitoring and recording the position and movement of aircraft.</rdfs:comment>
        <rdfs:label>Aircraft Tracking</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Airspace -->


    <owl:Class rdf:about="http://purl.org/ffonto#Airspace">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment xml:lang="en">A defined volume of airspace where specific rules and procedures apply.</rdfs:comment>
        <rdfs:label>Airspace</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirspaceConflictDetection -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirspaceConflictDetection">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#AirspaceManagement"/>
        <rdfs:comment xml:lang="en">The process of identifying potential conflicts between aircraft or airspace users.</rdfs:comment>
        <rdfs:label>Airspace Conflict Detection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AirspaceManagement -->


    <owl:Class rdf:about="http://purl.org/ffonto#AirspaceManagement">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#OperationalStrategy"/>
        <rdfs:comment xml:lang="en">Procedures and controls for safe and efficient use of airspace during operations.</rdfs:comment>
        <rdfs:label>Airspace Management</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AlertSystemStatus -->


    <owl:Class rdf:about="http://purl.org/ffonto#AlertSystemStatus">
        <rdfs:comment>Represents completeness of required fields for automated alert generation.</rdfs:comment>
        <rdfs:label>Alert System Status</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Animal -->


    <owl:Class rdf:about="http://purl.org/ffonto#Animal"/>
    


    <!-- http://purl.org/ffonto#AnimalSmokeExposure -->


    <owl:Class rdf:about="http://purl.org/ffonto#AnimalSmokeExposure">
        <rdfs:comment>Risk of smoke inhalation or displacement for animals.</rdfs:comment>
        <rdfs:label>Animal Smoke Exposure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Annotation -->


    <owl:Class rdf:about="http://purl.org/ffonto#Annotation">
        <rdfs:comment>Additional information derived from data, not a direct physical observation.</rdfs:comment>
        <rdfs:label>Annotation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#AnthropogenicFactor -->


    <owl:Class rdf:about="http://purl.org/ffonto#AnthropogenicFactor">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#ClimatePattern"/>
        <rdfs:comment>Human activities that influence wildfire risk and environmental conditions.</rdfs:comment>
        <rdfs:label>Anthropogenic Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#Arson -->


    <owl:Class rdf:about="http://purl.org/ffonto#Arson">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#HumanIgnition"/>
        <rdfs:comment xml:lang="en">The deliberate ignition of fires with malicious or unlawful intent.</rdfs:comment>
        <rdfs:label>Arson</rdfs:label>
