        <owl:disjointWith rdf:resource="http://purl.org/ffonto#PlannedIgnition"/>
        <rdfs:comment>Natural causes of ignition such as lightning.</rdfs:comment>
        <rdfs:label>Natural ignition</rdfs:label>
    </owl:Class>
    


