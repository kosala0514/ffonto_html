        <rdfs:label>animals penned in threatened area</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#animalsVisible -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#animalsVisible">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#ForestFire"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates that animals are observable in imagery or reports.</rdfs:comment>
        <rdfs:label>pets or livestock visible</rdfs:label>
    </owl:DatatypeProperty>
    


