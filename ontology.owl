        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates smoldering patches are visible without open flames.</rdfs:comment>
        <rdfs:label>smoldering present</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#snagsCount -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#snagsCount">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Snag"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Approximate number of snags visible (integer).</rdfs:comment>
        <rdfs:label>snags count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#snagsPresent -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#snagsPresent">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Snag"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether dead standing trees (snags) are common in the frame.</rdfs:comment>
        <rdfs:label>snags present</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#snagsVisible -->


    <owl:DatatypeProperty rdf:about="http://purl.org/ffonto#snagsVisible">
        <rdfs:domain rdf:resource="http://purl.org/ffonto#Vegetation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether many dead standing trees (snags) are visible.</rdfs:comment>
        <rdfs:label>snags visible</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ffonto#snowDepth -->


