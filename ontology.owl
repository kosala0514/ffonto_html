    </owl:Class>
    


    <!-- http://purl.org/ffonto#SuppressionOperation -->


    <owl:Class rdf:about="http://purl.org/ffonto#SuppressionOperation">
        <rdfs:comment>An organized operation (ground, aerial, mop-up) to control a fire.</rdfs:comment>
        <rdfs:label>Suppression Operation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SuppressionResource -->


    <owl:Class rdf:about="http://purl.org/ffonto#SuppressionResource">
        <rdfs:comment>Equipment or personnel used to control or extinguish wildfires.</rdfs:comment>
        <rdfs:label>Suppression Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ffonto#SuppressionTactic -->


    <owl:Class rdf:about="http://purl.org/ffonto#SuppressionTactic">
        <rdfs:subClassOf rdf:resource="http://purl.org/ffonto#FireManagementStrategy"/>
        <rdfs:comment xml:lang="en">A specific technique applied to control or extinguish a fire.</rdfs:comment>
