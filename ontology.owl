        <rdfs:domain rdf:resource="http://purl.org/ffonto#EcologicalImpact"/>
        <rdfs:range rdf:resource="http://purl.org/ffonto#FireBehavior"/>
        <rdfs:comment xml:lang="en">Inverse relation linking ecological impacts back to the causing events or processes.</rdfs:comment>
        <rdfs:label xml:lang="en">inverse of causes ecological impact</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ffonto#causesEffect -->


    <owl:ObjectProperty rdf:about="http://purl.org/ffonto#causesEffect">
